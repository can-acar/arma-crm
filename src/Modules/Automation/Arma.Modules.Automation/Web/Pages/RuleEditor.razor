@page "/automation/new"
@page "/automation/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AutomationPermissions.Read)]
@inject AutomationService Automation
@inject IUserDirectory Users
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Yeni kural" : name) · Arma CRM</PageTitle>

<div class="flex max-w-4xl flex-col gap-6">
    <div>
        <a class="text-muted-foreground text-sm hover:underline" href="automation">Otomasyon</a>
        <h1 class="text-2xl font-semibold tracking-tight">@(Id is null ? "Yeni kural" : name)</h1>
    </div>

    <FormAlert Error="@error" />
    @if (message is not null)
    {
        <p class="text-sm text-green-700 dark:text-green-400" role="status">@message</p>
    }

    <form class="flex flex-col gap-6" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <fieldset disabled="@(!CanManage)" class="flex flex-col gap-6">
            <Card>
                <CardContent Class="grid gap-4">
                    <div class="grid gap-2">
                        <Label for="rule-name">Kural adı</Label>
                        <Input id="rule-name" @bind-Value="name" maxlength="150" placeholder="Örnek: Bağışçıya teşekkür araması" />
                    </div>
                    <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="active" /> Kural açık</label>
                </CardContent>
            </Card>

            <Card>
                <CardHeader><CardTitle>Ne zaman?</CardTitle></CardHeader>
                <CardContent Class="grid gap-4">
                    <NativeSelect id="rule-trigger" @bind-Value="trigger" aria-label="Tetikleyici">
                        <option value="@TriggerKind.TimelineEvent">Bir modülde olay olunca (bağış, üyelik, etkinlik, satış, form)</option>
                        <option value="@TriggerKind.SegmentEntered">Kişi kayıtlı bir aramaya girince</option>
                    </NativeSelect>
                    @if (trigger == nameof(TriggerKind.TimelineEvent))
                    {
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="grid gap-2">
                                <Label for="rule-source">Modül</Label>
                                <NativeSelect id="rule-source" @bind-Value="source">
                                    <option value="">Seçin</option>
                                    @foreach (var item in Rule.Sources)
                                    {
                                        <option value="@item">@AutomationLabels.Source(item)</option>
                                    }
                                </NativeSelect>
                            </div>
                            <div class="grid gap-2">
                                <Label for="rule-subject">Kayıt konusu şunu içeriyorsa (isteğe bağlı)</Label>
                                <Input id="rule-subject" @bind-Value="subjectContains" maxlength="200" />
                                <p class="text-muted-foreground text-xs">@AutomationLabels.SubjectHint(source)</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="grid gap-2">
                            <Label for="rule-segment">Kayıtlı arama</Label>
                            <NativeSelect id="rule-segment" @bind-Value="segmentId">
                                <option value="">Seçin</option>
                                @foreach (var item in segments)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </NativeSelect>
                            <p class="text-muted-foreground text-xs">
                                Aramalar Kişiler &gt; Gelişmiş arama ekranında kaydedilir. Kural 15 dakikada bir denetlenir ve aramaya yeni giren kişilere uygulanır.
                            </p>
                        </div>
                        <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="includeExisting" /> Kural açıldığında aramaya zaten uyan kişilere de uygula</label>
                    }
                </CardContent>
            </Card>

            <Card>
                <CardHeader><CardTitle>Ne yapılsın?</CardTitle></CardHeader>
                <CardContent Class="flex flex-col gap-4">
                    @for (var i = 0; i < actions.Count; i++)
                    {
                        var index = i;
                        var action = actions[i];
                        <div class="grid gap-3 rounded-md border p-3" data-action>
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-sm font-medium">@(index + 1). @AutomationLabels.Action(action.Kind)</span>
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="() => actions.RemoveAt(index)">Kaldır</Button>
                            </div>
                            @switch (action.Kind)
                            {
                                case ActionKind.AddTag:
                                    <Input @bind-Value="action.TagName" placeholder="Etiket adı (yoksa oluşturulur)" aria-label="Etiket" maxlength="60" />
                                    break;
                                case ActionKind.AddToGroup:
                                    <NativeSelect @bind-Value="action.GroupId" aria-label="Grup">
                                        <option value="">Grup seçin</option>
                                        @foreach (var group in groups)
                                        {
                                            <option value="@group.Id">@group.Name</option>
                                        }
                                    </NativeSelect>
                                    break;
                                case ActionKind.CreateTask:
                                    <Input @bind-Value="action.Subject" placeholder="Görev konusu, örnek: Teşekkür için ara" aria-label="Görev konusu" maxlength="200" />
                                    <div class="grid gap-3 sm:grid-cols-2">
                                        <NativeSelect @bind-Value="action.Assignee" aria-label="Sorumlu">
                                            <option value="">Atanmamış</option>
                                            @foreach (var user in users)
                                            {
                                                <option value="@user.Id">@user.FullName</option>
                                            }
                                        </NativeSelect>
                                        <div class="flex items-center gap-2 text-sm">
                                            <Input @bind-Value="action.DueDays" inputmode="numeric" aria-label="Süre (gün)" Class="w-20" /> gün içinde
                                        </div>
                                    </div>
                                    <Textarea @bind-Value="action.Body" rows="2" placeholder="Açıklama (isteğe bağlı)" aria-label="Görev açıklaması" />
                                    break;
                                case ActionKind.SendEmail:
                                    <Input @bind-Value="action.Subject" placeholder="Konu" aria-label="E-posta konusu" maxlength="200" />
                                    <Textarea @bind-Value="action.Body" rows="5" placeholder="Merhaba {{ad}}, ..." aria-label="E-posta metni" />
                                    <p class="text-muted-foreground text-xs">
                                        Kullanılabilen alanlar: {{ad}}, {{soyad}}, {{adsoyad}}, {{eposta}}. Bu e-posta bilgilendirme amaçlı gider (teşekkür, hoş geldin, hatırlatma)
                                        ve ileti izni aranmaz. Kampanya ve tanıtım içeriği için izinleri denetleyen Toplu ileti ekranını kullanın.
                                    </p>
                                    break;
                            }
                        </div>
                    }
                    <div class="flex flex-wrap gap-2">
                        @foreach (var kind in Enum.GetValues<ActionKind>())
                        {
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => actions.Add(new ActionDraft { Kind = kind })">+ @AutomationLabels.Action(kind)</Button>
                        }
                    </div>
                </CardContent>
            </Card>
        </fieldset>

        @if (CanManage)
        {
            <div class="flex flex-wrap justify-between gap-2">
                <div class="flex gap-2">
                    @if (Id is not null)
                    {
                        <Button Variant="ButtonVariant.Destructive" OnClick="DeleteAsync">Sil</Button>
                        @if (savedTrigger == TriggerKind.SegmentEntered && savedActive)
                        {
                            <Button Variant="ButtonVariant.Outline" OnClick="RunNowAsync">Şimdi denetle</Button>
                        }
                    }
                </div>
                <Button Type="submit" Disabled="saving">Kaydet</Button>
            </div>
        }
    </form>

    @if (Id is not null)
    {
        <Card>
            <CardHeader>
                <CardTitle>Son çalışmalar</CardTitle>
                <CardDescription>Kuralın uygulandığı son 100 kişi.</CardDescription>
            </CardHeader>
            <CardContent>
                @if (runs.Count == 0)
                {
                    <p class="text-muted-foreground text-sm">Kural henüz kimseye uygulanmadı.</p>
                }
                else
                {
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Kişi</TableHead>
                                <TableHead>Tarih</TableHead>
                                <TableHead>Sonuç</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var run in runs)
                            {
                                <TableRow>
                                    <TableCell><a class="hover:underline" href="contacts/@run.ContactId">@run.ContactName</a></TableCell>
                                    <TableCell>@run.RanAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</TableCell>
                                    <TableCell>@AutomationLabels.Status(run.Status)</TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            </CardContent>
        </Card>
    }
</div>

@code {
    private readonly List<ActionDraft> actions = [];
    private IReadOnlyList<SegmentInfo> segments = [];
    private IReadOnlyList<AudienceList> groups = [];
    private IReadOnlyList<UserSummary> users = [];
    private IReadOnlyList<RunView> runs = [];
    private string? name, trigger = nameof(TriggerKind.TimelineEvent), source, subjectContains, segmentId, error, message;
    private bool active = true, includeExisting, saving, savedActive;
    private TriggerKind? savedTrigger;

    [Parameter] public Guid? Id { get; set; }

    private bool CanManage => CurrentUser.HasPermission(AutomationPermissions.Manage);

    protected override async Task OnParametersSetAsync()
    {
        segments = await Automation.SegmentsAsync();
        groups = await Automation.GroupsAsync();
        users = await Users.ActiveUsersAsync();
        actions.Clear();
        if (Id is { } id)
        {
            var rule = await Automation.GetAsync(id);
            if (rule is null)
            {
                Navigation.NavigateTo("automation");
                return;
            }

            (name, active, trigger, source, subjectContains, segmentId, includeExisting) =
                (rule.Name, rule.IsActive, rule.Trigger.ToString(), rule.SourceModule, rule.SubjectContains, rule.SegmentId?.ToString(), rule.IncludeExisting);
            (savedTrigger, savedActive) = (rule.Trigger, rule.IsActive);
            actions.AddRange(rule.Actions.Select(ActionDraft.From));
            runs = await Automation.RunsAsync(id);
        }
    }

    private async Task SaveAsync()
    {
        message = null;
        var inputs = new List<RuleAction>();
        foreach (var action in actions)
        {
            if (action.ToAction() is not { } input)
            {
                error = "Görev süresini gün sayısı olarak girin.";
                return;
            }

            inputs.Add(input);
        }

        saving = true;
        var result = await Automation.SaveAsync(Id, new RuleInput(
            name ?? "", active, Enum.Parse<TriggerKind>(trigger!), Guid.TryParse(segmentId, out var s) ? s : null,
            string.IsNullOrEmpty(source) ? null : source, subjectContains, includeExisting, inputs));
        saving = false;
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        error = null;
        if (Id is null)
        {
            Navigation.NavigateTo($"automation/{result.Value}");
            return;
        }

        message = "Kaydedildi.";
        await OnParametersSetAsync();
    }

    private async Task RunNowAsync()
    {
        var result = await Automation.RunSegmentAsync(Id!.Value);
        error = result.IsSuccess ? null : result.Error!.Message;
        message = result.IsSuccess ? $"{result.Value} kişiye uygulandı." : null;
        runs = await Automation.RunsAsync(Id!.Value);
    }

    private async Task DeleteAsync()
    {
        var result = await Automation.DeleteAsync(Id!.Value);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("automation");
        }
        else
        {
            error = result.Error!.Message;
        }
    }

    private sealed class ActionDraft
    {
        public ActionKind Kind { get; init; }

        public string? TagName { get; set; }

        public string? GroupId { get; set; }

        public string? Subject { get; set; }

        public string? Body { get; set; }

        public string? DueDays { get; set; } = "0";

        public string? Assignee { get; set; }

        public static ActionDraft From(RuleAction action) => new()
        {
            Kind = action.Kind,
            TagName = action.TagName,
            GroupId = action.GroupId?.ToString(),
            Subject = action.Subject,
            Body = action.Body,
            DueDays = (action.DueDays ?? 0).ToString(),
            Assignee = action.AssigneeUserId?.ToString(),
        };

        public RuleAction? ToAction() => int.TryParse(string.IsNullOrWhiteSpace(DueDays) ? "0" : DueDays, out var days)
            ? new RuleAction(Kind, TagName, Guid.TryParse(GroupId, out var g) ? g : null, Subject, Body, days, Guid.TryParse(Assignee, out var u) ? u : null)
            : null;
    }
}
