@inject GrantService Grants
@inject IContactDirectory Directory
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@* Kişi kartındaki "Hibeler" sekmesi: kişinin ya da kurumun hibe veren olduğu başvurular. *@
<Card>
    <CardHeader>
        <CardTitle>Hibeler</CardTitle>
        <CardDescription>Bu kişi veya kuruma yapılan hibe başvuruları.</CardDescription>
        @if (canWrite)
        {
            <CardAction><Button Size="ButtonSize.Sm" OnClick="() => editorOpen = true">Hibe başvurusu ekle</Button></CardAction>
        }
    </CardHeader>
    <CardContent>
        @if (items.Count == 0)
        {
            <p class="text-muted-foreground text-sm">Hibe başvurusu yok.</p>
        }
        else
        {
            <GrantTable Items="items" ShowFunder="false" />
        }
    </CardContent>
</Card>

<GrantDialog @bind-Open="editorOpen" Funder="contact" OnSaved="Opened" />

@code {
    private IReadOnlyList<GrantListItem> items = [];
    private ContactSummary? contact;
    private bool canWrite, editorOpen;

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        canWrite = CurrentUser.HasPermission(GrantsPermissions.Write);
        contact = await Directory.FindAsync(ContactId);
        items = await Grants.ListAsync(new GrantFilter(FunderId: ContactId));
    }

    private void Opened(Guid id) => Navigation.NavigateTo($"grants/{id}");
}
