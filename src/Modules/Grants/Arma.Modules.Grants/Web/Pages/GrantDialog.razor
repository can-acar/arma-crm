@inject GrantService Grants

@* Hibe ekleme ve düzenleme penceresi. *@
<Dialog Open="Open" OpenChanged="OpenChanged" Class="sm:max-w-2xl">
    <DialogHeader>
        <DialogTitle>@(Editing is null ? "Hibe başvurusu ekle" : "Hibeyi düzenle")</DialogTitle>
    </DialogHeader>

    <FormAlert Error="@error" />

    <form id="grant-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="grid gap-2">
            <Label>Hibe veren</Label>
            <ContactPicker @bind-Selected="funder" Placeholder="Vakıf, ajans veya kurum ara" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid gap-2">
                <Label for="grant-title">Proje / başvuru adı</Label>
                <Input id="grant-title" @bind-Value="title" maxlength="200" placeholder="Örnek: Kırsalda okuma atölyeleri" />
            </div>
            <div class="grid gap-2">
                <Label for="grant-program">Program / çağrı</Label>
                <Input id="grant-program" @bind-Value="program" maxlength="200" placeholder="İsteğe bağlı" />
            </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="grid gap-2 sm:col-span-2">
                <Label for="grant-requested">Talep edilen tutar</Label>
                <Input id="grant-requested" inputmode="decimal" @bind-Value="requested" placeholder="250.000,00" />
            </div>
            <div class="grid gap-2">
                <Label for="grant-currency">Para birimi</Label>
                <NativeSelect id="grant-currency" @bind-Value="currency">
                    @foreach (var currencyCode in GrantLabels.Currencies)
                    {
                        <option value="@currencyCode">@currencyCode</option>
                    }
                </NativeSelect>
            </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="grid gap-2">
                <Label for="grant-deadline">Başvuru son günü</Label>
                <input id="grant-deadline" type="date" class="@Styles.Input" @bind="deadline" />
            </div>
            <div class="grid gap-2">
                <Label for="grant-start">Proje başlangıcı</Label>
                <input id="grant-start" type="date" class="@Styles.Input" @bind="startOn" />
            </div>
            <div class="grid gap-2">
                <Label for="grant-end">Proje bitişi</Label>
                <input id="grant-end" type="date" class="@Styles.Input" @bind="endOn" />
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="grant-owner">Sorumlu</Label>
            <NativeSelect id="grant-owner" @bind-Value="owner">
                <option value="">Atanmadı</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.FullName</option>
                }
            </NativeSelect>
        </div>
        <div class="grid gap-2">
            <Label for="grant-description">Açıklama</Label>
            <Textarea id="grant-description" @bind-Value="description" rows="3" maxlength="4000" />
        </div>
    </form>

    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="CloseAsync">Vazgeç</Button>
        <Button Type="submit" form="grant-form" Disabled="saving">Kaydet</Button>
    </DialogFooter>
</Dialog>

@code {
    private static readonly System.Globalization.CultureInfo Turkish = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    private ContactSummary? funder;
    private string? title, program, requested, owner, description, error;
    private string currency = "TRY";
    private DateOnly? deadline, startOn, endOn;
    private IReadOnlyList<UserSummary> users = [];
    private bool saving, wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public GrantDetail? Editing { get; set; }

    /// <summary>Yeni kayıtta önceden seçili hibe veren.</summary>
    [Parameter] public ContactSummary? Funder { get; set; }

    [Parameter] public EventCallback<Guid> OnSaved { get; set; }

    [Inject] private IContactDirectory Directory { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen)
        {
            users = await Grants.AssignableUsersAsync();
            error = null;
            if (Editing is { Summary: var g } detail)
            {
                funder = await Directory.FindAsync(g.FunderId);
                (title, program, currency, requested) = (g.Title, g.Program, g.Currency, g.Requested.ToString("N2", Turkish));
                (deadline, startOn, endOn, owner, description) = (g.Deadline, g.StartOn, g.EndOn, g.OwnerId?.ToString(), detail.Description);
            }
            else
            {
                funder = Funder;
                title = program = requested = description = null;
                currency = "TRY";
                deadline = startOn = endOn = null;
                owner = users.FirstOrDefault(u => u.Id.ToString() == CurrentUser.Id)?.Id.ToString();
            }
        }

        wasOpen = Open;
    }

    [Inject] private ICurrentUser CurrentUser { get; set; } = default!;

    private async Task SaveAsync()
    {
        if (funder is null)
        {
            error = "Hibe vereni seçin.";
            return;
        }

        var amount = 0m;
        if (!string.IsNullOrWhiteSpace(requested) && !decimal.TryParse(requested, System.Globalization.NumberStyles.Number, Turkish, out amount))
        {
            error = "Tutarı 250.000,00 biçiminde girin.";
            return;
        }

        saving = true;
        try
        {
            var request = new SaveGrantRequest(funder.Id, title ?? "", program, currency, amount, deadline, startOn, endOn,
                Guid.TryParse(owner, out var ownerId) ? ownerId : null, description);
            var result = Editing is null ? await Grants.CreateAsync(request) : await Grants.UpdateAsync(Editing.Summary.Id, request);
            if (!result.IsSuccess)
            {
                error = result.Error!.Message;
                return;
            }

            await CloseAsync();
            await OnSaved.InvokeAsync(result.Value);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CloseAsync()
    {
        Open = wasOpen = false;
        await OpenChanged.InvokeAsync(false);
    }
}
