@inject SalesService Sales
@inject QuoteService Quotes
@inject ICurrentUser CurrentUser

@* Kişi kartındaki "Satış" sekmesi. *@
<div class="flex flex-col gap-6">
    <Card>
        <CardHeader>
            <CardTitle>Fırsatlar</CardTitle>
            @if (CurrentUser.HasPermission(SalesPermissions.Write))
            {
                <CardAction><Button Size="ButtonSize.Sm" OnClick="() => createOpen = true">Fırsat ekle</Button></CardAction>
            }
        </CardHeader>
        <CardContent>
            @if (opportunities.Count == 0)
            {
                <p class="text-muted-foreground text-sm">Fırsat yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Başlık</TableHead>
                            <TableHead>Aşama</TableHead>
                            <TableHead Class="text-right">Tutar</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var item in opportunities)
                        {
                            <TableRow>
                                <TableCell><a class="font-medium hover:underline" href="sales/@item.Id">@item.Title</a></TableCell>
                                <TableCell>@item.StageName</TableCell>
                                <TableCell Class="text-right tabular-nums">@SalesLabels.Money(item.Amount)</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card>
        <CardHeader>
            <CardTitle>Teklifler</CardTitle>
            @if (CurrentUser.HasPermission(SalesPermissions.Write))
            {
                <CardAction><Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Href="@($"sales/quotes/new?contact={ContactId}")">Teklif hazırla</Button></CardAction>
            }
        </CardHeader>
        <CardContent>
            @if (quotes.Count == 0)
            {
                <p class="text-muted-foreground text-sm">Teklif yok.</p>
            }
            else
            {
                <QuoteTable Items="quotes" ShowContact="false" />
            }
        </CardContent>
    </Card>
</div>

<OpportunityDialog @bind-Open="createOpen" ContactId="ContactId" Pipeline="pipeline" OnSaved="_ => LoadAsync()" />

@code {
    private IReadOnlyList<OpportunityView> opportunities = [];
    private IReadOnlyList<QuoteView> quotes = [];
    private PipelineView? pipeline;
    private bool createOpen;

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var pipelines = await Sales.PipelinesAsync();
        pipeline = pipelines.FirstOrDefault(p => p.IsDefault) ?? pipelines.FirstOrDefault();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        opportunities = await Sales.ForContactAsync(ContactId);
        quotes = await Quotes.ListAsync(contactId: ContactId);
    }
}
