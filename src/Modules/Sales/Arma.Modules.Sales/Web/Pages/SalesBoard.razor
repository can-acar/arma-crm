@page "/sales"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SalesPermissions.Read)]
@inject SalesService Sales
@inject IUserDirectory Users
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Satış hattı · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Satış hattı</h1>
            @if (board is not null)
            {
                <p class="text-muted-foreground text-sm">Açık: @SalesLabels.Money(board.OpenTotal) · Olasılıkla ağırlıklı: @SalesLabels.Money(board.WeightedTotal)</p>
            }
        </div>
        @if (CanWrite)
        {
            <Button OnClick="() => createOpen = true">Fırsat ekle</Button>
        }
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
        @if (pipelines.Count > 1)
        {
            <NativeSelect Value="@pipelineId" ValueChanged="v => FilterAsync(() => pipelineId = v)" aria-label="Satış hattı">
                @foreach (var item in pipelines)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </NativeSelect>
        }
        <NativeSelect Value="@ownerId" ValueChanged="v => FilterAsync(() => ownerId = v)" aria-label="Sorumlu">
            <option value="">Tüm sorumlular</option>
            @foreach (var user in users)
            {
                <option value="@user.Id">@user.FullName</option>
            }
        </NativeSelect>
        <Input Value="@search" ValueChanged="v => FilterAsync(() => search = v)" placeholder="Başlık veya müşteri ara" aria-label="Ara" />
    </div>

    <FormAlert Error="@error" />

    @if (board is null)
    {
        <Skeleton Class="h-64" />
    }
    else
    {
        <div class="flex gap-4 overflow-x-auto pb-4" data-board>
            @foreach (var column in board.Columns)
            {
                <section class="bg-muted/50 flex w-72 shrink-0 flex-col gap-2 rounded-lg p-2 @(dropTarget == column.Stage.Id ? "ring-primary ring-2" : "")"
                         data-stage="@column.Stage.Name"
                         @ondragover:preventDefault @ondragenter="() => dropTarget = column.Stage.Id"
                         @ondrop="() => DropAsync(column.Stage, null)">
                    <header class="flex items-baseline justify-between px-1">
                        <h2 class="text-sm font-semibold">@column.Stage.Name</h2>
                        <span class="text-muted-foreground text-xs tabular-nums">@column.Items.Count · @SalesLabels.Money(column.Total)</span>
                    </header>
                    @foreach (var item in column.Items)
                    {
                        <article class="bg-background cursor-grab rounded-md border p-3 text-sm shadow-xs" draggable="@(CanWrite ? "true" : "false")"
                                 data-opportunity="@item.Title"
                                 @ondragstart="() => dragged = item" @ondragend="() => dropTarget = null"
                                 @ondrop="() => DropAsync(column.Stage, item.Id)" @ondrop:stopPropagation>
                            <a class="font-medium hover:underline" href="sales/@item.Id">@item.Title</a>
                            <p class="text-muted-foreground">@item.ContactName</p>
                            <div class="mt-2 flex items-center justify-between text-xs">
                                <span class="tabular-nums">@SalesLabels.Money(item.Amount)</span>
                                @if (item.ExpectedCloseOn is { } close)
                                {
                                    <span class="@(item.Overdue(Sales.Today) ? "text-destructive font-medium" : "text-muted-foreground")">@SalesLabels.Date(close)</span>
                                }
                            </div>
                            @if (item.OwnerName is not null)
                            {
                                <p class="text-muted-foreground mt-1 text-xs">@item.OwnerName</p>
                            }
                        </article>
                    }
                </section>
            }
        </div>
        <p class="text-muted-foreground text-xs">Kartları sürükleyerek aşamalar arasında taşıyabilirsiniz. Kapanmış fırsatlar 30 gün sonra panodan kalkar.</p>
    }
</div>

<OpportunityDialog @bind-Open="createOpen" Pipeline="board?.Pipeline" OnSaved="_ => LoadAsync()" />

<Dialog Open="lost is not null" OpenChanged="v => { if (!v) lost = null; }" Class="sm:max-w-md">
    <DialogHeader>
        <DialogTitle>Fırsat kaybedildi</DialogTitle>
        <DialogDescription>Neden kaybedildiğini yazmanız sonraki satışlar için yararlı olur.</DialogDescription>
    </DialogHeader>
    <form id="lost-form" class="grid gap-2" @onsubmit="ConfirmLostAsync" @onsubmit:preventDefault>
        <Label for="lost-reason">Kaybetme nedeni</Label>
        <Input id="lost-reason" @bind-Value="lostReason" maxlength="500" placeholder="Örnek: Fiyat yüksek bulundu" />
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => lost = null">Vazgeç</Button>
        <Button Type="submit" form="lost-form">Taşı</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<PipelineView> pipelines = [];
    private IReadOnlyList<UserSummary> users = [];
    private Board? board;
    private OpportunityView? dragged;
    private (OpportunityView Item, StageView Stage, Guid? Before)? lost;
    private Guid? dropTarget;
    private string? pipelineId, ownerId, search, lostReason, error;
    private bool createOpen;

    private bool CanWrite => CurrentUser.HasPermission(SalesPermissions.Write);

    protected override async Task OnInitializedAsync()
    {
        pipelines = await Sales.PipelinesAsync();
        users = await Users.ActiveUsersAsync();
        pipelineId = (pipelines.FirstOrDefault(p => p.IsDefault) ?? pipelines.FirstOrDefault())?.Id.ToString();
        await LoadAsync();
    }

    private Task FilterAsync(Action change)
    {
        change();
        return LoadAsync();
    }

    private async Task LoadAsync() =>
        board = await Sales.BoardAsync(Guid.TryParse(pipelineId, out var p) ? p : null,
            new BoardFilter(Guid.TryParse(ownerId, out var o) ? o : null, search));

    private async Task DropAsync(StageView stage, Guid? beforeId)
    {
        dropTarget = null;
        if (dragged is not { } item || !CanWrite || beforeId == item.Id)
        {
            return;
        }

        dragged = null;
        if (stage.Kind == StageKind.Lost && item.StageKind != StageKind.Lost)
        {
            (lost, lostReason) = ((item, stage, beforeId), null);
            return;
        }

        await MoveAsync(item, stage, beforeId, null);
    }

    private async Task ConfirmLostAsync()
    {
        if (lost is { } move)
        {
            lost = null;
            await MoveAsync(move.Item, move.Stage, move.Before, lostReason);
        }
    }

    private async Task MoveAsync(OpportunityView item, StageView stage, Guid? beforeId, string? reason)
    {
        var result = await Sales.MoveAsync(item.Id, stage.Id, beforeId, reason);
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }
}
