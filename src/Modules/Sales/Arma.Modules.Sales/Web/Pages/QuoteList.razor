@page "/sales/quotes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SalesPermissions.Read)]
@inject QuoteService Quotes
@inject ICurrentUser CurrentUser

<PageTitle>Teklifler · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Teklifler</h1>
            <p class="text-muted-foreground text-sm">@items.Count teklif</p>
        </div>
        @if (CurrentUser.HasPermission(SalesPermissions.Write))
        {
            <Button Href="sales/quotes/new">Teklif hazırla</Button>
        }
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
        <NativeSelect Value="@status" ValueChanged="FilterAsync" aria-label="Durum">
            <option value="">Tüm durumlar</option>
            @foreach (var option in Enum.GetValues<QuoteStatus>())
            {
                <option value="@option">@SalesLabels.Status(option)</option>
            }
        </NativeSelect>
    </div>

    <Card>
        <CardContent>
            @if (!loaded)
            {
                <Skeleton Class="h-24" />
            }
            else if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Teklif yok.</p>
            }
            else
            {
                <QuoteTable Items="items" />
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<QuoteView> items = [];
    private string? status;
    private bool loaded;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task FilterAsync(string? value)
    {
        status = value;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await Quotes.ListAsync(Enum.TryParse<QuoteStatus>(status, out var s) ? s : null);
        loaded = true;
    }
}
