@page "/sales/quotes/new"
@page "/sales/quotes/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SalesPermissions.Write)]
@inject QuoteService Quotes
@inject SalesService Sales
@inject IContactDirectory Directory
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Yeni teklif" : "Teklifi düzenle") · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <a class="text-muted-foreground text-sm hover:underline" href="sales/quotes">Teklifler</a>
        <h1 class="text-2xl font-semibold tracking-tight">@(Id is null ? "Yeni teklif" : $"Teklif {number}")</h1>
    </div>

    @if (locked)
    {
        <Alert><AlertTitle>Bu teklif düzenlenemez</AlertTitle><AlertDescription>Kabul edilen veya reddedilen teklifler değiştirilemez.</AlertDescription></Alert>
    }
    else
    {
        <FormAlert Error="@error" />

        <form class="flex flex-col gap-6" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <Card>
                <CardContent Class="grid gap-4 sm:grid-cols-2">
                    <div class="grid gap-2 sm:col-span-2">
                        <Label>Müşteri</Label>
                        <ContactPicker @bind-Selected="contact" />
                    </div>
                    @if (opportunity is not null)
                    {
                        <p class="text-muted-foreground text-sm sm:col-span-2">Fırsat: <a class="hover:underline" href="sales/@opportunity.Id">@opportunity.Title</a>. Teklif kabul edilirse fırsat kazanıldı, reddedilirse kaybedildi olarak işaretlenir.</p>
                    }
                    <div class="grid gap-2">
                        <Label for="quote-issued">Teklif tarihi</Label>
                        <input id="quote-issued" type="date" class="@Styles.Input" @bind="issuedOn" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="quote-valid">Geçerlilik</Label>
                        <input id="quote-valid" type="date" class="@Styles.Input" @bind="validUntil" />
                    </div>
                </CardContent>
            </Card>

            <Card>
                <CardHeader><CardTitle>Kalemler</CardTitle></CardHeader>
                <CardContent Class="flex flex-col gap-3">
                    <div class="text-muted-foreground hidden grid-cols-[1fr_5rem_5rem_7rem_5rem_5rem_7rem_2rem] gap-2 text-xs font-medium md:grid">
                        <span>Açıklama</span><span>Miktar</span><span>Birim</span><span>Birim fiyat</span><span>İsk. %</span><span>KDV %</span><span class="text-right">Tutar</span><span></span>
                    </div>
                    @foreach (var line in lines)
                    {
                        <div class="grid gap-2 md:grid-cols-[1fr_5rem_5rem_7rem_5rem_5rem_7rem_2rem] md:items-center" data-line>
                            <Input @bind-Value="line.Description" placeholder="Ürün veya hizmet" aria-label="Açıklama" maxlength="500" />
                            <Input @bind-Value="line.Quantity" inputmode="decimal" aria-label="Miktar" />
                            <Input @bind-Value="line.Unit" placeholder="adet" aria-label="Birim" maxlength="20" />
                            <Input @bind-Value="line.UnitPrice" inputmode="decimal" placeholder="0,00" aria-label="Birim fiyat" />
                            <Input @bind-Value="line.Discount" inputmode="decimal" aria-label="İskonto" />
                            <NativeSelect @bind-Value="line.Vat" aria-label="KDV">
                                @foreach (var rate in QuoteLine.VatRates)
                                {
                                    <option value="@rate">%@rate</option>
                                }
                            </NativeSelect>
                            <span class="text-right text-sm tabular-nums">@SalesLabels.Money(line.Net)</span>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" aria-label="Kalemi sil" OnClick="() => lines.Remove(line)">×</Button>
                        </div>
                    }
                    <div>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => lines.Add(new LineDraft())">Kalem ekle</Button>
                    </div>
                    <dl class="ml-auto grid w-64 grid-cols-2 gap-1 text-sm">
                        <dt class="text-muted-foreground">Ara toplam</dt><dd class="text-right tabular-nums">@SalesLabels.Money(lines.Sum(l => l.Net))</dd>
                        <dt class="text-muted-foreground">KDV</dt><dd class="text-right tabular-nums">@SalesLabels.Money(lines.Sum(l => l.VatAmount))</dd>
                        <dt class="font-semibold">Genel toplam</dt><dd class="text-right font-semibold tabular-nums" data-total>@SalesLabels.Money(lines.Sum(l => l.Net + l.VatAmount))</dd>
                    </dl>
                </CardContent>
            </Card>

            <Card>
                <CardContent Class="grid gap-2">
                    <Label for="quote-terms">Şartlar</Label>
                    <Textarea id="quote-terms" @bind-Value="terms" rows="4" maxlength="4000" placeholder="Ödeme, teslim ve garanti şartları" />
                </CardContent>
            </Card>

            <div class="flex justify-end gap-2">
                <Button Variant="ButtonVariant.Outline" Href="@(Id is null ? "sales/quotes" : $"sales/quotes/{Id}")">Vazgeç</Button>
                <Button Type="submit" Disabled="saving">Kaydet</Button>
            </div>
        </form>
    }
</div>

@code {
    private readonly List<LineDraft> lines = [];
    private ContactSummary? contact;
    private OpportunityView? opportunity;
    private DateOnly issuedOn, validUntil;
    private string? terms, number, error;
    private bool saving, locked;

    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "opportunity")] public Guid? OpportunityQuery { get; set; }

    [SupplyParameterFromQuery(Name = "contact")] public Guid? ContactQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } id)
        {
            var quote = await Quotes.GetAsync(id);
            if (quote is null)
            {
                Navigation.NavigateTo("sales/quotes");
                return;
            }

            locked = quote.Status is QuoteStatus.Accepted or QuoteStatus.Rejected;
            (number, issuedOn, validUntil, terms) = (quote.Number, quote.IssuedOn, quote.ValidUntil, quote.Terms);
            contact = await Directory.FindAsync(quote.ContactId);
            opportunity = quote.OpportunityId is { } o ? await Sales.GetAsync(o) : null;
            lines.AddRange(quote.Lines.Select(LineDraft.From));
            return;
        }

        var settings = await Quotes.SettingsAsync();
        (issuedOn, terms) = (Sales.Today, settings.DefaultTerms);
        validUntil = issuedOn.AddDays(settings.ValidityDays);
        opportunity = OpportunityQuery is { } opp ? await Sales.GetAsync(opp) : null;
        var contactId = opportunity?.ContactId ?? ContactQuery;
        contact = contactId is { } c ? await Directory.FindAsync(c) : null;
        lines.Add(opportunity is { Amount: > 0 } ? new LineDraft { Description = opportunity.Title, UnitPrice = SalesLabels.Number(opportunity.Amount) } : new LineDraft());
    }

    private async Task SaveAsync()
    {
        if (contact is null)
        {
            error = "Müşteri seçin.";
            return;
        }

        var inputs = new List<QuoteLineInput>();
        foreach (var line in lines.Where(l => !string.IsNullOrWhiteSpace(l.Description)))
        {
            if (line.ToInput() is not { } input)
            {
                error = $"\"{line.Description}\" kaleminde miktar veya fiyat hatalı. Sayıları 1.250,50 biçiminde girin.";
                return;
            }

            inputs.Add(input);
        }

        saving = true;
        var result = await Quotes.SaveAsync(Id, new QuoteInput(contact.Id, opportunity?.Id, issuedOn, validUntil, terms, inputs));
        saving = false;
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        Navigation.NavigateTo($"sales/quotes/{result.Value}");
    }

    private sealed class LineDraft
    {
        public string? Description { get; set; }

        public string? Quantity { get; set; } = "1";

        public string? Unit { get; set; }

        public string? UnitPrice { get; set; }

        public string? Discount { get; set; } = "0";

        public string? Vat { get; set; } = "20";

        public decimal Net => ToInput() is { } input ? QuoteLine.NetOf(input) : 0;

        public decimal VatAmount => ToInput() is { } input ? QuoteLine.VatOf(input) : 0;

        public static LineDraft From(QuoteLineView line) => new()
        {
            Description = line.Description,
            Quantity = SalesLabels.Number(line.Quantity),
            Unit = line.Unit,
            UnitPrice = SalesLabels.Number(line.UnitPrice),
            Discount = SalesLabels.Number(line.DiscountRate),
            Vat = line.VatRate.ToString(),
        };

        public QuoteLineInput? ToInput() =>
            SalesLabels.TryParse(Quantity, out var quantity) && SalesLabels.TryParse(string.IsNullOrWhiteSpace(UnitPrice) ? "0" : UnitPrice, out var price)
            && SalesLabels.TryParse(string.IsNullOrWhiteSpace(Discount) ? "0" : Discount, out var discount)
                && int.TryParse(Vat, out var vat)
                ? new QuoteLineInput(Description ?? "", quantity, Unit, price, discount, vat)
                : null;
    }
}
