@inject SalesService Sales

@* Teklif tablosu; teklif listesi, fırsat ve kişi kartı kullanır. *@
<Table>
    <TableHeader>
        <TableRow>
            <TableHead>No</TableHead>
            @if (ShowContact)
            {
                <TableHead>Müşteri</TableHead>
            }
            <TableHead>Tarih</TableHead>
            <TableHead>Geçerlilik</TableHead>
            <TableHead Class="text-right">Toplam</TableHead>
            <TableHead>Durum</TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        @foreach (var quote in Items)
        {
            <TableRow>
                <TableCell Class="font-mono"><a class="font-medium hover:underline" href="sales/quotes/@quote.Id">@quote.Number</a></TableCell>
                @if (ShowContact)
                {
                    <TableCell><a class="hover:underline" href="contacts/@quote.ContactId">@quote.ContactName</a></TableCell>
                }
                <TableCell>@SalesLabels.Date(quote.IssuedOn)</TableCell>
                <TableCell>@SalesLabels.Date(quote.ValidUntil)</TableCell>
                <TableCell Class="text-right tabular-nums">@SalesLabels.Money(quote.Total)</TableCell>
                <TableCell><QuoteBadge Status="quote.Status" Expired="quote.Expired(Sales.Today)" /></TableCell>
            </TableRow>
        }
    </TableBody>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<QuoteView> Items { get; set; } = [];

    [Parameter] public bool ShowContact { get; set; } = true;
}
