@page "/sales/quotes/{Id:guid}/print"
@layout PlainLayout
@attribute [Authorize(Policy = SalesPermissions.Read)]
@inject QuoteService Quotes
@inject IContactDirectory Directory

<PageTitle>Teklif @quote?.Number · Arma CRM</PageTitle>

@if (quote is null)
{
    <div class="mx-auto max-w-3xl p-6">
        <Alert><AlertTitle>Teklif bulunamadı</AlertTitle><AlertDescription>Silinmiş olabilir.</AlertDescription></Alert>
    </div>
}
else
{
    <div class="mx-auto max-w-3xl p-6 print:max-w-none print:p-0">
        <div class="mb-4 flex justify-end gap-2 print:hidden">
            <Button Variant="ButtonVariant.Outline" Href="@($"sales/quotes/{quote.Id}")">Geri</Button>
            <button type="button" class="@ButtonVariants.For(ButtonVariant.Default, ButtonSize.Default)" onclick="window.print()">Yazdır</button>
        </div>

        <article class="bg-background rounded-lg border p-10 print:rounded-none print:border-0 print:p-0">
            <header class="flex items-start justify-between gap-6 border-b pb-6">
                <div>
                    <h1 class="text-lg font-semibold">@(settings.OrganizationName.Length > 0 ? settings.OrganizationName : "Kurum adı girilmemiş")</h1>
                    @if (settings.Address is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.Address</p>
                    }
                    @if (settings.LegalInfo is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.LegalInfo</p>
                    }
                </div>
                <div class="text-right">
                    <p class="text-xl font-semibold tracking-tight">FİYAT TEKLİFİ</p>
                    <p class="font-mono text-sm">No: @quote.Number</p>
                    <p class="text-sm">Tarih: @SalesLabels.Date(quote.IssuedOn)</p>
                    <p class="text-sm">Geçerlilik: @SalesLabels.Date(quote.ValidUntil)</p>
                </div>
            </header>

            <section class="py-6 text-sm">
                <p class="text-muted-foreground">Sayın</p>
                <p class="font-medium">@customer?.DisplayName</p>
                @if (customer?.Email is not null)
                {
                    <p>@customer.Email</p>
                }
            </section>

            <QuoteLinesTable Quote="quote" />

            @if (quote.Terms is not null)
            {
                <section class="mt-8 border-t pt-4 text-sm">
                    <h2 class="mb-1 font-semibold">Şartlar</h2>
                    <p class="whitespace-pre-line">@quote.Terms</p>
                </section>
            }

            <div class="mt-16 grid grid-cols-2 gap-10 text-center text-sm">
                <div class="border-t pt-2">Teklifi veren (kaşe, imza)</div>
                <div class="border-t pt-2">Onaylayan</div>
            </div>
        </article>
    </div>
}

@code {
    private QuoteView? quote;
    private ContactSummary? customer;
    private QuoteSettings settings = new();

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        quote = await Quotes.GetAsync(Id);
        settings = await Quotes.SettingsAsync();
        if (quote is not null)
        {
            customer = await Directory.FindAsync(quote.ContactId);
        }
    }
}
