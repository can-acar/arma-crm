@page "/donations/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GivingPermissions.Read)]
@inject DonationService Donations
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Bağış · Arma CRM</PageTitle>

@if (donation is null)
{
    @if (loaded)
    {
        <Alert><AlertTitle>Bağış bulunamadı</AlertTitle></Alert>
    }
}
else
{
    <div class="flex flex-col gap-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-muted-foreground text-sm"><a class="hover:underline" href="donations">Bağışlar</a></p>
                <h1 class="text-2xl font-semibold tracking-tight">@Money.Format(donation.Amount, donation.Currency)</h1>
                <p class="text-sm"><a class="hover:underline" href="contacts/@donation.ContactId">@donation.ContactName</a> · @GivingLabels.Date(donation.ReceivedOn)</p>
            </div>
            <div class="flex flex-wrap gap-2">
                @if (canReceipt && donation.Status == DonationStatus.Completed && !donation.HasReceipt)
                {
                    <Button OnClick="IssueReceiptAsync">Makbuz kes</Button>
                }
                @if (donation.HasReceipt)
                {
                    <Button Href="@($"donations/{donation.Id}/receipt")" target="_blank">Makbuzu yazdır</Button>
                }
                @if (canWrite && donation.Status is DonationStatus.Completed or DonationStatus.Pending or DonationStatus.Failed)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="() => editorOpen = true">Düzenle</Button>
                }
                @if (canWrite && donation.Status == DonationStatus.Completed)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="() => refundOpen = true">İade</Button>
                }
                @if (canReceipt && donation.HasReceipt)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="() => voidOpen = true">Makbuzu iptal et</Button>
                }
                @if (canDelete && donation.ReceiptNumber is null)
                {
                    <Button Variant="ButtonVariant.Destructive" OnClick="() => deleteOpen = true">Sil</Button>
                }
            </div>
        </div>

        <FormAlert Error="@error" />
        @if (info is not null)
        {
            <Alert><AlertDescription>@info</AlertDescription></Alert>
        }

        <Card>
            <CardContent>
                <dl class="grid gap-x-6 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
                    <div><dt class="text-muted-foreground">Durum</dt><dd><Badge Variant="GivingLabels.StatusVariant(donation.Status)">@GivingLabels.Status(donation.Status)</Badge></dd></div>
                    <div><dt class="text-muted-foreground">Fon</dt><dd>@(donation.FundName ?? "Genel")</dd></div>
                    @if (donation.PledgeId is { } pledgeId)
                    {
                        <div><dt class="text-muted-foreground">Taahhüt</dt><dd><a class="hover:underline" href="donations/pledges/@pledgeId">Taahhüt ödemesi</a></dd></div>
                    }
                    <div><dt class="text-muted-foreground">Ödeme yöntemi</dt><dd>@GivingLabels.Method(donation.Method)</dd></div>
                    <div><dt class="text-muted-foreground">Dekont / işlem no</dt><dd>@(donation.Reference ?? "-")</dd></div>
                    @if (donation.InKindDescription is not null)
                    {
                        <div><dt class="text-muted-foreground">Bağışlanan mal</dt><dd>@donation.InKindDescription</dd></div>
                    }
                    @if (donation.Provider is not null)
                    {
                        <div><dt class="text-muted-foreground">Ödeme kuruluşu</dt><dd>@donation.Provider @donation.ProviderPaymentId</dd></div>
                    }
                    <div>
                        <dt class="text-muted-foreground">Makbuz</dt>
                        <dd>
                            @if (donation.ReceiptNumber is null)
                            {
                                <span>Kesilmedi</span>
                            }
                            else
                            {
                                <span class="@(donation.HasReceipt ? "font-mono" : "font-mono line-through")">@donation.ReceiptNumber</span>
                                <span class="text-muted-foreground"> · @donation.ReceiptIssuedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                @if (donation.ReceiptVoidReason is not null)
                                {
                                    <div class="text-destructive">İptal: @donation.ReceiptVoidReason</div>
                                }
                            }
                        </dd>
                    </div>
                    <div><dt class="text-muted-foreground">Kaydeden</dt><dd>@(donation.CreatedBy ?? "Çevrim içi form") · @donation.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd></div>
                    @if (donation.Note is not null)
                    {
                        <div class="sm:col-span-2 lg:col-span-3"><dt class="text-muted-foreground">Not</dt><dd class="whitespace-pre-line">@donation.Note</dd></div>
                    }
                </dl>
            </CardContent>
        </Card>
    </div>

    <DonationEditor @bind-Open="editorOpen" Editing="donation" OnSaved="_ => LoadAsync()" />

    <Dialog @bind-Open="refundOpen">
        <DialogHeader>
            <DialogTitle>Bağış iade edilsin mi?</DialogTitle>
            <DialogDescription>Bağış toplamlardan düşer; kesilmiş makbuz iptal edilir. Parayı iade etme işlemini bankanızdan veya ödeme kuruluşunun panelinden ayrıca yapın.</DialogDescription>
        </DialogHeader>
        <Input placeholder="İade nedeni" @bind-Value="reason" />
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => refundOpen = false">Vazgeç</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="RefundAsync">İade et</Button>
        </DialogFooter>
    </Dialog>

    <Dialog @bind-Open="voidOpen">
        <DialogHeader>
            <DialogTitle>@donation.ReceiptNumber numaralı makbuz iptal edilsin mi?</DialogTitle>
            <DialogDescription>Numara tekrar kullanılmaz. Gerekirse sonra yeni numarayla makbuz kesebilirsiniz.</DialogDescription>
        </DialogHeader>
        <Input placeholder="İptal nedeni (zorunlu)" @bind-Value="reason" />
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => voidOpen = false">Vazgeç</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="VoidAsync">Makbuzu iptal et</Button>
        </DialogFooter>
    </Dialog>

    <Dialog @bind-Open="deleteOpen">
        <DialogHeader>
            <DialogTitle>Bağış silinsin mi?</DialogTitle>
            <DialogDescription>Yanlış girilen kayıtlar içindir. Denetim izinde kaydı korunur.</DialogDescription>
        </DialogHeader>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => deleteOpen = false">Vazgeç</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="DeleteAsync">Sil</Button>
        </DialogFooter>
    </Dialog>
}

@code {
    private DonationView? donation;
    private bool loaded, canWrite, canDelete, canReceipt, editorOpen, refundOpen, voidOpen, deleteOpen;
    private string? error, info, reason;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        canWrite = CurrentUser.HasPermission(GivingPermissions.Write);
        canDelete = CurrentUser.HasPermission(GivingPermissions.Delete);
        canReceipt = CurrentUser.HasPermission(GivingPermissions.Receipts);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        donation = await Donations.GetAsync(Id);
        loaded = true;
    }

    private async Task IssueReceiptAsync()
    {
        var result = await Donations.IssueReceiptAsync(Id);
        (error, info) = result.IsSuccess ? ((string?)null, $"{result.Value} numaralı makbuz kesildi.") : (result.Error!.Message, (string?)null);
        await LoadAsync();
    }

    private async Task RefundAsync()
    {
        var result = await Donations.RefundAsync(Id, reason);
        refundOpen = false;
        (error, info, reason) = result.IsSuccess ? ((string?)null, "Bağış iade edildi olarak işaretlendi.", (string?)null) : (result.Error!.Message, (string?)null, reason);
        await LoadAsync();
    }

    private async Task VoidAsync()
    {
        var result = await Donations.VoidReceiptAsync(Id, reason ?? "");
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            voidOpen = false;
            return;
        }

        (voidOpen, error, info, reason) = (false, null, "Makbuz iptal edildi.", null);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        var result = await Donations.DeleteAsync(Id);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("donations");
            return;
        }

        (deleteOpen, error) = (false, result.Error!.Message);
    }
}
