@page "/donations/pledges"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GivingPermissions.Read)]
@inject PledgeService Pledges
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Taahhütler · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Taahhütler</h1>
            <p class="text-muted-foreground text-sm">Bağışçıların ileride ödemeyi üstlendiği tutarlar. Taahhüde bağlanan bağışlar taksitleri kapatır; vadesi geçmiş taksiti olanlar gecikmiş sayılır.</p>
        </div>
        @if (canWrite)
        {
            <Button OnClick="() => editorOpen = true">Taahhüt ekle</Button>
        }
    </div>

    @if (totals is not null)
    {
        <div class="grid gap-4 sm:grid-cols-3">
            <Card><CardHeader><CardDescription>Açık taahhüt</CardDescription><CardTitle Class="text-lg">@(totals.Open + totals.Overdue)</CardTitle></CardHeader></Card>
            <Card><CardHeader><CardDescription>Kalan (TL)</CardDescription><CardTitle Class="text-lg">@Money.Format(totals.RemainingTry, "TRY")</CardTitle></CardHeader></Card>
            <Card><CardHeader><CardDescription>Vadesi geçen (TL)</CardDescription><CardTitle Class="@(totals.OverdueTry > 0 ? "text-destructive text-lg" : "text-lg")">@Money.Format(totals.OverdueTry, "TRY")</CardTitle></CardHeader></Card>
        </div>
    }

    <div class="flex flex-wrap gap-2">
        @foreach (var (key, label) in Filters)
        {
            <Button Size="ButtonSize.Sm" Variant="@(State == key ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick="() => Select(key)">@label</Button>
        }
    </div>

    <Card>
        <CardContent>
            @if (items is null)
            {
                <Skeleton Class="h-24" />
            }
            else if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Bu durumda taahhüt yok.</p>
            }
            else
            {
                <PledgeTable Items="items" />
            }
        </CardContent>
    </Card>
</div>

<PledgeEditor @bind-Open="editorOpen" OnSaved="Opened" />

@code {
    private static readonly (string? Key, string Label)[] Filters =
        [("open", "Açık"), ("overdue", "Gecikmiş"), ("fulfilled", "Tamamlanan"), ("cancelled", "İptal"), ("all", "Tümü")];

    private IReadOnlyList<PledgeView>? items;
    private PledgeTotals? totals;
    private bool canWrite, editorOpen;

    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    protected override void OnInitialized() => canWrite = CurrentUser.HasPermission(GivingPermissions.Write);

    protected override async Task OnParametersSetAsync()
    {
        State ??= "open";
        totals = await Pledges.TotalsAsync();
        items = State switch
        {
            "overdue" => await Pledges.ListAsync(PledgeState.Overdue),
            "fulfilled" => await Pledges.ListAsync(PledgeState.Fulfilled),
            "cancelled" => await Pledges.ListAsync(PledgeState.Cancelled),
            "all" => await Pledges.ListAsync(),
            // "Açık" gecikmiş olanları da gösterir.
            _ => (await Pledges.ListAsync()).Where(p => p.State is PledgeState.Open or PledgeState.Overdue).ToList(),
        };
    }

    private void Select(string? key) => Navigation.NavigateTo($"donations/pledges?state={key}");

    private void Opened(Guid id) => Navigation.NavigateTo($"donations/pledges/{id}");
}
