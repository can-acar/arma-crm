@* Para birimine göre toplamlar: "12.500,00 TL (14 bağış) · 300,00 USD (1 bağış)" *@
@if (Totals.Count == 0)
{
    <span class="text-muted-foreground">@Empty</span>
}
else
{
    <span>@string.Join(" · ", Totals.Select(t => $"{Money.Format(t.Amount, t.Currency)} ({t.Count} bağış)"))</span>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CurrencyTotal> Totals { get; set; } = [];

    [Parameter] public string Empty { get; set; } = "Bağış yok";
}
