@page "/donations/{Id:guid}/receipt"
@layout PlainLayout
@attribute [Authorize(Policy = GivingPermissions.Read)]
@inject DonationService Donations
@inject IContactDirectory Directory

<PageTitle>Makbuz @donation?.ReceiptNumber · Arma CRM</PageTitle>

@if (donation is null || !donation.HasReceipt)
{
    <div class="mx-auto max-w-2xl p-6">
        <Alert><AlertTitle>Makbuz bulunamadı</AlertTitle><AlertDescription>Bu bağış için geçerli bir makbuz kesilmemiş veya makbuz iptal edilmiş.</AlertDescription></Alert>
    </div>
}
else
{
    <div class="mx-auto max-w-2xl p-6 print:max-w-none print:p-0">
        <div class="mb-4 flex justify-end gap-2 print:hidden">
            <Button Variant="ButtonVariant.Outline" Href="@($"donations/{donation.Id}")">Geri</Button>
            <button type="button" class="@ButtonVariants.For(ButtonVariant.Default, ButtonSize.Default)" onclick="window.print()">Yazdır</button>
        </div>

        <article class="bg-background rounded-lg border p-10 print:rounded-none print:border-0 print:p-0">
            <header class="flex items-start justify-between gap-6 border-b pb-6">
                <div>
                    <h1 class="text-lg font-semibold">@(settings.OrganizationName.Length > 0 ? settings.OrganizationName : "Kurum adı girilmemiş")</h1>
                    @if (settings.Address is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.Address</p>
                    }
                    @if (settings.LegalInfo is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.LegalInfo</p>
                    }
                </div>
                <div class="text-right">
                    <p class="text-xl font-semibold tracking-tight">BAĞIŞ MAKBUZU</p>
                    <p class="font-mono text-sm">No: @donation.ReceiptNumber</p>
                    <p class="text-sm">Tarih: @donation.ReceiptIssuedAt?.ToLocalTime().ToString("dd.MM.yyyy")</p>
                </div>
            </header>

            <dl class="grid grid-cols-[10rem_1fr] gap-y-3 py-6 text-sm">
                <dt class="text-muted-foreground">Bağışçı</dt>
                <dd class="font-medium">@donor?.DisplayName</dd>
                <dt class="text-muted-foreground">Bağış tarihi</dt>
                <dd>@GivingLabels.Date(donation.ReceivedOn)</dd>
                <dt class="text-muted-foreground">Tutar</dt>
                <dd class="text-base font-semibold">@Money.Format(donation.Amount, donation.Currency)</dd>
                <dt class="text-muted-foreground">Yalnız</dt>
                <dd>#@Money.InWords(donation.Amount, donation.Currency)#</dd>
                <dt class="text-muted-foreground">Ödeme şekli</dt>
                <dd>@GivingLabels.Method(donation.Method)@(donation.Reference is null ? "" : $" ({donation.Reference})")</dd>
                <dt class="text-muted-foreground">Bağışın amacı</dt>
                <dd>@(donation.FundName ?? "Genel bağış")</dd>
                @if (donation.InKindDescription is not null)
                {
                    <dt class="text-muted-foreground">Bağışlanan mal</dt>
                    <dd>@donation.InKindDescription</dd>
                }
            </dl>

            @if (settings.Footer is not null)
            {
                <p class="text-muted-foreground border-t pt-4 text-sm whitespace-pre-line">@settings.Footer</p>
            }

            <div class="mt-16 grid grid-cols-2 gap-10 text-center text-sm">
                <div class="border-t pt-2">Teslim eden</div>
                <div class="border-t pt-2">Teslim alan (kaşe, imza)</div>
            </div>
        </article>
    </div>
}

@code {
    private DonationView? donation;
    private ContactSummary? donor;
    private ReceiptSettings settings = new();

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        donation = await Donations.GetAsync(Id);
        settings = await Donations.ReceiptSettingsAsync();
        if (donation is not null)
        {
            donor = await Directory.FindAsync(donation.ContactId);
        }
    }
}
