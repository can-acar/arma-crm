@page "/donations/annual/{ContactId:guid}/{Year:int}"
@layout PlainLayout
@attribute [Authorize(Policy = GivingPermissions.Read)]
@inject DonationService Donations
@inject IContactDirectory Directory

<PageTitle>@Year bağış özeti · Arma CRM</PageTitle>

@if (donor is null || statement is null)
{
    <div class="mx-auto max-w-2xl p-6">
        <Alert><AlertTitle>Kişi bulunamadı</AlertTitle><AlertDescription>Kayıt silinmiş veya başka bir kayıtla birleştirilmiş olabilir.</AlertDescription></Alert>
    </div>
}
else
{
    <div class="mx-auto max-w-3xl p-6 print:max-w-none print:p-0">
        <div class="mb-4 flex flex-wrap justify-end gap-2 print:hidden">
            <Button Variant="ButtonVariant.Outline" Href="@($"contacts/{ContactId}")">Kişiye dön</Button>
            <Button Variant="ButtonVariant.Outline" Href="@($"donations/annual/{ContactId}/{Year - 1}")">@(Year - 1)</Button>
            <Button Variant="ButtonVariant.Outline" Href="@($"donations/annual/{ContactId}/{Year + 1}")">@(Year + 1)</Button>
            <button type="button" class="@ButtonVariants.For(ButtonVariant.Default, ButtonSize.Default)" onclick="window.print()">Yazdır</button>
        </div>

        <article class="bg-background rounded-lg border p-10 print:rounded-none print:border-0 print:p-0">
            <header class="flex items-start justify-between gap-6 border-b pb-6">
                <div>
                    <h1 class="text-lg font-semibold">@(settings.OrganizationName.Length > 0 ? settings.OrganizationName : "Kurum adı girilmemiş")</h1>
                    @if (settings.Address is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.Address</p>
                    }
                    @if (settings.LegalInfo is not null)
                    {
                        <p class="text-muted-foreground text-sm whitespace-pre-line">@settings.LegalInfo</p>
                    }
                </div>
                <div class="text-right">
                    <p class="text-xl font-semibold tracking-tight">YILLIK BAĞIŞ ÖZETİ</p>
                    <p class="text-sm">@Year yılı</p>
                    <p class="text-muted-foreground text-sm">Düzenleme: @DateTime.Today.ToString("dd.MM.yyyy")</p>
                </div>
            </header>

            <p class="py-6 text-sm">
                Sayın <span class="font-medium">@donor.DisplayName</span>, @Year yılında kurumumuza yaptığınız bağışların dökümü aşağıdadır.
                Desteğiniz için teşekkür ederiz.
            </p>

            @if (statement.Donations.Count == 0)
            {
                <p class="text-muted-foreground text-sm">Bu yıl için tamamlanmış bağış kaydı yok.</p>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b text-left">
                            <th class="py-2 font-medium">Tarih</th>
                            <th class="py-2 font-medium">Amaç</th>
                            <th class="py-2 font-medium">Ödeme</th>
                            <th class="py-2 font-medium">Makbuz no</th>
                            <th class="py-2 text-right font-medium">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in statement.Donations)
                        {
                            <tr class="border-b">
                                <td class="py-2">@GivingLabels.Date(item.ReceivedOn)</td>
                                <td class="py-2">@(item.FundName ?? "Genel bağış")</td>
                                <td class="py-2">@GivingLabels.Method(item.Method)</td>
                                <td class="py-2 font-mono text-xs">@(item.ReceiptVoidReason is null ? item.ReceiptNumber ?? "—" : "—")</td>
                                <td class="py-2 text-right tabular-nums">@Money.Format(item.Amount, item.Currency)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @foreach (var total in statement.Totals)
                        {
                            <tr>
                                <td colspan="4" class="pt-3 text-right font-medium">Toplam (@total.Currency)</td>
                                <td class="pt-3 text-right font-semibold tabular-nums">@Money.Format(total.Amount, total.Currency)</td>
                            </tr>
                        }
                    </tfoot>
                </table>
            }

            @if (settings.Footer is not null)
            {
                <p class="text-muted-foreground mt-8 border-t pt-4 text-sm whitespace-pre-line">@settings.Footer</p>
            }

            <p class="text-muted-foreground mt-6 text-xs">Bu özet bilgilendirme amaçlıdır; her bağışın resmi belgesi kendi makbuzudur.</p>
        </article>
    </div>
}

@code {
    private ContactSummary? donor;
    private Arma.Modules.Giving.Application.AnnualStatement? statement;
    private ReceiptSettings settings = new();

    [Parameter] public Guid ContactId { get; set; }

    [Parameter] public int Year { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        donor = await Directory.FindAsync(ContactId);
        settings = await Donations.ReceiptSettingsAsync();
        statement = donor is null || Year is < 2000 or > 2100 ? null : await Donations.AnnualStatementAsync(donor.Id, Year);
    }
}
