@* Taahhüt listesi ve kişi kartında kullanılan tablo. *@
<Table>
    <TableHeader>
        <TableRow>
            @if (ShowContact)
            {
                <TableHead>Bağışçı</TableHead>
            }
            <TableHead>Plan</TableHead>
            <TableHead Class="text-right">Taahhüt</TableHead>
            <TableHead Class="text-right">Ödenen</TableHead>
            <TableHead Class="text-right">Geciken</TableHead>
            <TableHead>Sıradaki vade</TableHead>
            <TableHead>Durum</TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        @foreach (var pledge in Items)
        {
            <TableRow>
                @if (ShowContact)
                {
                    <TableCell><a class="font-medium hover:underline" href="@($"contacts/{pledge.ContactId}")">@pledge.ContactName</a></TableCell>
                }
                <TableCell>
                    <a class="hover:underline" href="@($"donations/pledges/{pledge.Id}")">@GivingLabels.Plan(pledge.Frequency, pledge.InstallmentCount)</a>
                    <div class="text-muted-foreground text-xs">@(pledge.FundName ?? "Genel")</div>
                </TableCell>
                <TableCell Class="text-right tabular-nums">@Money.Format(pledge.Amount, pledge.Currency)</TableCell>
                <TableCell Class="text-right tabular-nums">
                    @Money.Format(pledge.Paid, pledge.Currency)
                    <div class="bg-muted mt-1 ml-auto h-1.5 w-24 overflow-hidden rounded-full">
                        <div class="bg-primary h-full" style="width: @Percent(pledge)%"></div>
                    </div>
                </TableCell>
                <TableCell Class="@(pledge.Overdue > 0 ? "text-destructive text-right tabular-nums" : "text-muted-foreground text-right tabular-nums")">
                    @(pledge.Overdue > 0 ? Money.Format(pledge.Overdue, pledge.Currency) : "-")
                </TableCell>
                <TableCell>@(pledge.State is PledgeState.Open or PledgeState.Overdue && pledge.NextDueOn is { } due ? GivingLabels.Date(due) : "-")</TableCell>
                <TableCell><Badge Variant="GivingLabels.StateVariant(pledge.State)">@GivingLabels.State(pledge.State)</Badge></TableCell>
            </TableRow>
        }
    </TableBody>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PledgeView> Items { get; set; } = [];

    [Parameter] public bool ShowContact { get; set; } = true;

    private static string Percent(PledgeView pledge) =>
        Math.Min(100, Math.Round(pledge.Paid / pledge.Amount * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
