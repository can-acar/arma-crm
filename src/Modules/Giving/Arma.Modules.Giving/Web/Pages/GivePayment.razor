@page "/bagis/odeme"
@layout PlainLayout
@attribute [AllowAnonymous]

<PageTitle>Ödeme</PageTitle>

<div class="mx-auto max-w-2xl p-6">
    @if (IsAllowed(U))
    {
        <iframe src="@U" title="Güvenli ödeme" class="h-[640px] w-full rounded-lg border bg-white"></iframe>
    }
    else
    {
        <Alert><AlertDescription>Ödeme sayfası bulunamadı. <a class="underline" href="bagis">Bağış formuna dönün.</a></AlertDescription></Alert>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? U { get; set; }

    // Sayfa yalnızca ödeme kuruluşunun güvenli sayfasını çerçeveler; başka adres gösterilmez.
    private static bool IsAllowed(string? url) => url?.StartsWith("https://www.paytr.com/odeme/guvenli/", StringComparison.Ordinal) == true;
}
