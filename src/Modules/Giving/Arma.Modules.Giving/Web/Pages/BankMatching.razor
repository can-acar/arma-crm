@page "/donations/bank"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GivingPermissions.Write)]
@using Arma.Modules.Giving.Application.Banking
@using Arma.SharedKernel.Domain
@inject BankService Bank
@inject FundService Funds
@inject IContactDirectory Directory

<PageTitle>Havale eşleştirme · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Havale eşleştirme</h1>
        <p class="text-muted-foreground text-sm">Bankanın hesap hareketleri dosyasını yükleyin; gelen havale ve EFT'ler bağışçısıyla eşleşince bağış olarak kaydedilir.</p>
    </div>

    <Card>
        <CardHeader>
            <CardTitle>Ekstre yükle</CardTitle>
            <CardDescription>İnternet şubesinden indirilen Excel (.xlsx), CSV veya MT940 dosyası. Daha önce yüklenmiş hareketler atlanır.</CardDescription>
        </CardHeader>
        <CardContent>
            <form class="flex flex-wrap items-center gap-3" @onsubmit="ImportAsync" @onsubmit:preventDefault>
                <InputFile id="bank-file" OnChange="e => (file, error, summary) = (e.File, null, null)" accept=".xlsx,.csv,.txt,.sta,.940" class="@Styles.Input" style="max-width: 24rem" />
                <Button Type="submit" Disabled="@(file is null || importing)">@(importing ? "Okunuyor…" : "Yükle")</Button>
            </form>
            <div class="mt-3"><FormAlert Error="@error" /></div>
            @if (summary is not null)
            {
                <Alert Class="mt-3">
                    <AlertTitle>@summary.New yeni hareket eklendi</AlertTitle>
                    <AlertDescription>
                        Dosyada @summary.Credits gelen hareket vardı@(summary.Duplicates > 0 ? $", {summary.Duplicates} tanesi daha önce yüklendiği için atlandı" : "").
                        @(summary.Suggested > 0 ? $"{summary.Suggested} hareket için bağışçı önerildi." : "Bağışçı önerisi bulunamadı; hareketleri elle eşleştirin.")
                    </AlertDescription>
                </Alert>
            }
        </CardContent>
    </Card>

    <Card>
        <CardHeader>
            <CardTitle>Hareketler</CardTitle>
            <CardAction>
                <div class="flex flex-wrap items-center gap-2">
                    <NativeSelect Class="w-auto" Value="@status" ValueChanged="v => FilterAsync(v)" aria-label="Durum">
                        <option value="Open">Bekleyen</option>
                        <option value="Matched">Bağışa dönüşen</option>
                        <option value="Ignored">Yok sayılan</option>
                    </NativeSelect>
                    @if (status == "Open" && SuggestedCount > 0)
                    {
                        <Button Size="ButtonSize.Sm" OnClick="ConfirmSuggestedAsync" Disabled="busy">Önerileri onayla (@SuggestedCount)</Button>
                    }
                </div>
            </CardAction>
        </CardHeader>
        <CardContent>
            @if (lines is null)
            {
                <Skeleton Class="h-24" />
            }
            else if (lines.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">@(status == "Open" ? "Eşleştirilecek hareket yok." : "Bu durumda hareket yok.")</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Tarih</TableHead>
                            <TableHead Class="text-right">Tutar</TableHead>
                            <TableHead>Gönderen ve açıklama</TableHead>
                            <TableHead>Bağışçı</TableHead>
                            <TableHead><span class="sr-only">İşlem</span></TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var line in lines)
                        {
                            <TableRow data-line="@line.Id">
                                <TableCell Class="whitespace-nowrap">@GivingLabels.Date(line.BookedOn)</TableCell>
                                <TableCell Class="text-right font-medium whitespace-nowrap tabular-nums">@Money.Format(line.Amount, "TRY")</TableCell>
                                <TableCell Class="max-w-xs text-sm whitespace-normal">
                                    @if (line.Counterparty is not null)
                                    {
                                        <div class="font-medium">@line.Counterparty</div>
                                    }
                                    <div class="text-muted-foreground break-words">@line.Description</div>
                                    @if (line.Iban is not null)
                                    {
                                        <div class="text-muted-foreground font-mono text-xs">@line.Iban</div>
                                    }
                                </TableCell>
                                <TableCell Class="text-sm">
                                    @if (line.Status == BankLineStatus.Matched)
                                    {
                                        <a class="hover:underline" href="contacts/@line.ContactId">@(line.ContactName ?? "Silinmiş kişi")</a>
                                        @if (line.DonationId is not null)
                                        {
                                            <div><a class="text-muted-foreground text-xs hover:underline" href="donations/@line.DonationId">Bağışı aç</a></div>
                                        }
                                    }
                                    else if (line.SuggestedContactName is not null)
                                    {
                                        <span>@line.SuggestedContactName</span>
                                        <div class="text-muted-foreground text-xs">Öneri: @(line.SuggestionReason == "IBAN" ? "aynı IBAN'dan önceki havale" : "açıklamadaki ad")@(line.SuggestedFundId is { } f ? $" · {FundName(f)}" : "")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted-foreground">—</span>
                                    }
                                </TableCell>
                                <TableCell>
                                    <div class="flex flex-wrap justify-end gap-1">
                                    @if (line.Status == BankLineStatus.Open)
                                    {
                                        @if (line.SuggestedContactId is { } suggested)
                                        {
                                            <Button Size="ButtonSize.Sm" OnClick="() => ConfirmAsync(line.Id, suggested, line.SuggestedFundId)" Disabled="busy">Onayla</Button>
                                        }
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => OpenMatchAsync(line)">@(line.SuggestedContactId is null ? "Eşleştir" : "Değiştir")</Button>
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ChangeAsync(Bank.IgnoreAsync(line.Id))">Yok say</Button>
                                    }
                                    else if (line.Status == BankLineStatus.Ignored)
                                    {
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ChangeAsync(Bank.ReopenAsync(line.Id))">Geri al</Button>
                                    }
                                    </div>
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
                @if (lines.Count == 500)
                {
                    <p class="text-muted-foreground mt-3 text-xs">İlk 500 hareket gösteriliyor.</p>
                }
            }
        </CardContent>
    </Card>

    @if (statements.Count > 0)
    {
        <Card>
            <CardHeader><CardTitle>Yüklenen dosyalar</CardTitle></CardHeader>
            <CardContent>
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Dosya</TableHead>
                            <TableHead>Yükleme</TableHead>
                            <TableHead Class="text-right">Gelen hareket</TableHead>
                            <TableHead Class="text-right">Atlanan</TableHead>
                            <TableHead Class="text-right">Bekleyen</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var item in statements)
                        {
                            <TableRow>
                                <TableCell>@item.FileName <span class="text-muted-foreground text-xs uppercase">@item.Format</span></TableCell>
                                <TableCell Class="text-sm">@item.ImportedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</TableCell>
                                <TableCell Class="text-right tabular-nums">@item.CreditCount</TableCell>
                                <TableCell Class="text-right tabular-nums">@item.DuplicateCount</TableCell>
                                <TableCell Class="text-right tabular-nums">@item.OpenCount</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </CardContent>
        </Card>
    }
</div>

<Dialog Open="matching is not null" OpenChanged="v => { if (!v) matching = null; }" Class="sm:max-w-md">
    <DialogHeader>
        <DialogTitle>Havaleyi eşleştir</DialogTitle>
        @if (matching is not null)
        {
            <DialogDescription>@GivingLabels.Date(matching.BookedOn) · @Money.Format(matching.Amount, "TRY") · @(matching.Counterparty ?? matching.Description)</DialogDescription>
        }
    </DialogHeader>
    <form id="match-form" class="grid gap-4" @onsubmit="ConfirmMatchAsync" @onsubmit:preventDefault>
        <div class="grid gap-2">
            <Label>Bağışçı</Label>
            <ContactPicker @bind-Selected="matchContact" />
        </div>
        <div class="grid gap-2">
            <Label for="match-fund">Fon</Label>
            <NativeSelect id="match-fund" @bind-Value="matchFund">
                <option value="">Genel bağış</option>
                @foreach (var fund in funds)
                {
                    <option value="@fund.Id">@fund.Name</option>
                }
            </NativeSelect>
        </div>
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => matching = null">Vazgeç</Button>
        <Button Type="submit" form="match-form" Disabled="@(matchContact is null || busy)">Bağış olarak kaydet</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<BankLineView>? lines;
    private IReadOnlyList<StatementView> statements = [];
    private IReadOnlyList<FundView> funds = [];
    private IBrowserFile? file;
    private ImportSummary? summary;
    private BankLineView? matching;
    private ContactSummary? matchContact;
    private string status = "Open";
    private string? matchFund, error;
    private bool importing, busy;

    private int SuggestedCount => lines?.Count(l => l.Status == BankLineStatus.Open && l.SuggestedContactId is not null) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        funds = await Funds.ListAsync(activeOnly: true);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        lines = await Bank.LinesAsync(Enum.Parse<BankLineStatus>(status));
        statements = await Bank.StatementsAsync();
    }

    private async Task FilterAsync(string? value)
    {
        status = value ?? "Open";
        await LoadAsync();
    }

    private string FundName(Guid id) => funds.FirstOrDefault(f => f.Id == id)?.Name ?? "Fon";

    private async Task ImportAsync()
    {
        if (file is null)
        {
            return;
        }

        if (file.Size > BankService.MaxFileBytes)
        {
            error = "Dosya 10 MB'tan büyük olamaz.";
            return;
        }

        importing = true;
        using var buffer = new MemoryStream();
        await file.OpenReadStream(BankService.MaxFileBytes).CopyToAsync(buffer);
        var result = await Bank.ImportAsync(file.Name, buffer.ToArray());
        importing = false;
        summary = result.IsSuccess ? result.Value : null;
        error = result.IsSuccess ? null : result.Error!.Message;
        status = "Open";
        await LoadAsync();
    }

    private async Task ConfirmAsync(Guid lineId, Guid contactId, Guid? fundId)
    {
        busy = true;
        var result = await Bank.ConfirmAsync(lineId, contactId, fundId);
        busy = false;
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }

    private async Task ConfirmSuggestedAsync()
    {
        busy = true;
        await Bank.ConfirmSuggestedAsync();
        busy = false;
        (summary, error) = (null, null);
        await LoadAsync();
        if (SuggestedCount > 0)
        {
            error = $"{SuggestedCount} hareket onaylanamadı (fon pasif veya kişi silinmiş olabilir); elle eşleştirin.";
        }
    }

    private async Task OpenMatchAsync(BankLineView line)
    {
        matchContact = line.SuggestedContactId is { } id ? await Directory.FindAsync(id) : null;
        matchFund = line.SuggestedFundId?.ToString();
        matching = line;
    }

    private async Task ConfirmMatchAsync()
    {
        if (matching is null || matchContact is null)
        {
            return;
        }

        var line = matching.Id;
        matching = null;
        await ConfirmAsync(line, matchContact.Id, Guid.TryParse(matchFund, out var fund) ? fund : null);
    }

    private async Task ChangeAsync(Task<Result<Guid>> action)
    {
        var result = await action;
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }
}
