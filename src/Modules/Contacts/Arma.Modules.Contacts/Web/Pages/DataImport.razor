@page "/admin/import"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ContactsPermissions.Import)]
@using Arma.SharedKernel.Modules
@inject IEnumerable<IDataImporter> Importers
@inject ICurrentUser CurrentUser

<PageTitle>Veri aktarımı · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">CiviCRM'den aktarım</h1>
        <p class="text-muted-foreground text-sm">
            CiviCRM'den dışa aktardığınız CSV dosyalarını sırayla yükleyin. Kayıtlar CiviCRM kimlikleriyle saklanır; aynı dosyayı
            yeniden yüklerseniz yalnızca yeni satırlar eklenir.
        </p>
    </div>

    @foreach (var (importer, index) in steps.Select((s, i) => (s, i + 1)))
    {
        var state = states[importer];
        <Card>
            <CardHeader>
                <CardTitle>@index. @importer.Label</CardTitle>
                <CardDescription>@importer.Hint</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="flex flex-wrap items-center gap-3" @onsubmit="() => RunAsync(importer)" @onsubmit:preventDefault>
                    <InputFile id="@($"import-{index}")" accept=".csv,.txt" class="@Styles.Input" style="max-width: 24rem"
                               OnChange="e => (state.File, state.Error, state.Outcome) = (e.File, null, null)" />
                    <Button Type="submit" Disabled="@(state.File is null || running is not null)">@(running == importer ? "Aktarılıyor…" : "Aktar")</Button>
                </form>
                <p class="text-muted-foreground mt-2 text-xs">Gerekli sütunlar: @string.Join(", ", importer.RequiredColumns.Select(c => c.Replace("|", " / ")))</p>
                <div class="mt-3"><FormAlert Error="@state.Error" /></div>
                @if (state.Outcome is { } outcome)
                {
                    <div class="mt-3 flex flex-col gap-3" data-testid="import-result">
                        <p class="text-sm">@Summary(outcome)</p>
                        @if (outcome.Issues.Count > 0)
                        {
                            <Table>
                                <TableHeader>
                                    <TableRow><TableHead>Satır</TableHead><TableHead>Kayıt</TableHead><TableHead>Neden</TableHead></TableRow>
                                </TableHeader>
                                <TableBody>
                                    @foreach (var issue in outcome.Issues.Take(100))
                                    {
                                        <TableRow>
                                            <TableCell>@issue.Line</TableCell>
                                            <TableCell>@issue.Name</TableCell>
                                            <TableCell Class="whitespace-normal">@issue.Reason</TableCell>
                                        </TableRow>
                                    }
                                </TableBody>
                            </Table>
                            @if (outcome.Issues.Count > 100)
                            {
                                <p class="text-muted-foreground text-xs">İlk 100 satır gösteriliyor.</p>
                            }
                        }
                    </div>
                }
            </CardContent>
        </Card>
    }

    @if (steps.Count == 0)
    {
        <p class="text-muted-foreground text-sm">Aktarım yapmak için gereken izinleriniz yok.</p>
    }
</div>

@code {
    private List<IDataImporter> steps = [];
    private readonly Dictionary<IDataImporter, StepState> states = [];
    private IDataImporter? running;

    protected override void OnInitialized()
    {
        steps = [.. Importers.Where(i => i.Source == CivicrmContactImporter.SourceKey && CurrentUser.HasPermission(i.Permission)).OrderBy(i => i.Order)];
        foreach (var step in steps)
        {
            states[step] = new StepState();
        }
    }

    private async Task RunAsync(IDataImporter importer)
    {
        var state = states[importer];
        if (state.File is null)
        {
            return;
        }

        if (state.File.Size > ImportFile.MaxBytes)
        {
            state.Error = "Dosya en fazla 50 MB olabilir; CiviCRM'de aramayı bölerek birkaç dosya halinde dışa aktarın.";
            return;
        }

        running = importer;
        state.Error = null;
        state.Outcome = null;
        try
        {
            using var buffer = new MemoryStream();
            await state.File.OpenReadStream(ImportFile.MaxBytes).CopyToAsync(buffer);
            var rows = ImportFile.Read(buffer.ToArray());
            if (!rows.IsSuccess)
            {
                state.Error = rows.Error!.Message;
                return;
            }

            var missing = ImportFile.MissingColumns(importer, rows.Value!);
            if (missing.Count > 0)
            {
                state.Error = $"Dosyada şu sütunlar yok: {string.Join(", ", missing)}. CiviCRM'de \"Birincil alanlar\" ile dışa aktarın.";
                return;
            }

            state.Outcome = await importer.ImportAsync(rows.Value!, CancellationToken.None);
        }
        finally
        {
            running = null;
        }
    }

    private static string Summary(ImportOutcome outcome)
    {
        var parts = new List<string> { $"{outcome.Created:N0} yeni kayıt" };
        if (outcome.Matched > 0)
        {
            parts.Add($"{outcome.Matched:N0} mevcut kayıtla eşleşti");
        }

        parts.Add($"{outcome.Skipped:N0} satır atlandı (daha önce aktarılmış ya da kapsam dışı)");
        if (outcome.Issues.Count > 0)
        {
            parts.Add($"{outcome.Issues.Count:N0} satır aktarılamadı");
        }

        return string.Join(", ", parts) + ".";
    }

    private sealed class StepState
    {
        public IBrowserFile? File { get; set; }

        public string? Error { get; set; }

        public ImportOutcome? Outcome { get; set; }
    }
}
