@page "/contacts/groups"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ContactsPermissions.Read)]
@inject TaxonomyService Taxonomy
@inject ICurrentUser CurrentUser

<PageTitle>Etiket ve gruplar · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Etiket ve gruplar</h1>
        <p class="text-muted-foreground text-sm">Etiketler serbest sınıflandırma, gruplar elle üye eklenen listelerdir (bülten aboneleri, yönetim kurulu gibi).</p>
    </div>

    <FormAlert Error="@error" />

    <div class="grid gap-6 lg:grid-cols-2">
        <Card>
            <CardHeader>
                <CardTitle>Gruplar</CardTitle>
                <CardDescription>@groups.Count grup</CardDescription>
            </CardHeader>
            <CardContent class="grid gap-4">
                <ul class="grid gap-2 text-sm">
                    @foreach (var group in groups)
                    {
                        <li class="flex items-center justify-between gap-2">
                            <div>
                                <a class="font-medium hover:underline" href="contacts?group=@group.Id">@group.Name</a>
                                <span class="text-muted-foreground"> · @group.MemberCount üye</span>
                                @if (group.Description is not null)
                                {
                                    <div class="text-muted-foreground text-xs">@group.Description</div>
                                }
                            </div>
                            @if (canWrite)
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="() => DeleteGroupAsync(group.Id)">Sil</Button>
                            }
                        </li>
                    }
                </ul>
                @if (canWrite)
                {
                    <form class="grid gap-2" @onsubmit="CreateGroupAsync" @onsubmit:preventDefault>
                        <Input placeholder="Grup adı" @bind-Value="groupName" />
                        <Input placeholder="Açıklama (isteğe bağlı)" @bind-Value="groupDescription" />
                        <div><Button Type="submit" Size="ButtonSize.Sm">Grup ekle</Button></div>
                    </form>
                }
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardTitle>Etiketler</CardTitle>
                <CardDescription>@tags.Count etiket</CardDescription>
            </CardHeader>
            <CardContent class="grid gap-4">
                <div class="flex flex-wrap gap-2">
                    @foreach (var tag in tags)
                    {
                        @if (canWrite)
                        {
                            <TagBadge Tag="tag" OnRemove="DeleteTagAsync" />
                        }
                        else
                        {
                            <TagBadge Tag="tag" />
                        }
                    }
                </div>
                @if (canWrite)
                {
                    <form class="flex flex-wrap gap-2" @onsubmit="CreateTagAsync" @onsubmit:preventDefault>
                        <Input Class="w-48" placeholder="Etiket adı" @bind-Value="tagName" />
                        <NativeSelect Class="w-32" @bind-Value="tagColor" aria-label="Renk">
                            @foreach (var color in Tag.Colors)
                            {
                                <option value="@color">@ColorName(color)</option>
                            }
                        </NativeSelect>
                        <Button Type="submit" Size="ButtonSize.Sm" Class="h-9">Ekle</Button>
                    </form>
                }
            </CardContent>
        </Card>
    </div>
</div>

@code {
    private IReadOnlyList<TagDto> tags = [];
    private IReadOnlyList<GroupDto> groups = [];
    private string? tagName, groupName, groupDescription, error;
    private string tagColor = "gray";
    private bool canWrite;

    protected override async Task OnInitializedAsync()
    {
        canWrite = CurrentUser.HasPermission(ContactsPermissions.Write);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        tags = await Taxonomy.TagsAsync();
        groups = await Taxonomy.GroupsAsync();
    }

    private async Task CreateTagAsync()
    {
        var result = await Taxonomy.CreateTagAsync(tagName ?? "", tagColor);
        (error, tagName) = result.IsSuccess ? (null, null) : (result.Error!.Message, tagName);
        await LoadAsync();
    }

    private async Task DeleteTagAsync(TagDto tag)
    {
        await Taxonomy.DeleteTagAsync(tag.Id);
        await LoadAsync();
    }

    private async Task CreateGroupAsync()
    {
        var result = await Taxonomy.CreateGroupAsync(groupName ?? "", groupDescription);
        (error, groupName, groupDescription) = result.IsSuccess ? (null, null, null) : (result.Error!.Message, groupName, groupDescription);
        await LoadAsync();
    }

    private async Task DeleteGroupAsync(Guid id)
    {
        await Taxonomy.DeleteGroupAsync(id);
        await LoadAsync();
    }

    private static string ColorName(string color) => color switch
    {
        "red" => "Kırmızı",
        "amber" => "Turuncu",
        "green" => "Yeşil",
        "blue" => "Mavi",
        "purple" => "Mor",
        _ => "Gri",
    };
}
