@using Microsoft.JSInterop
@page "/contacts/search"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ContactsPermissions.Read)]
@inject ContactSearchService Search
@inject TaxonomyService Taxonomy
@inject ICurrentUser CurrentUser
@inject IJSRuntime JS

<PageTitle>Gelişmiş arama · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Gelişmiş arama</h1>
        <p class="text-muted-foreground text-sm">Ölçütleri birleştirin (hepsi birlikte sağlanmalı). Sonucu kaydedebilir, dışa aktarabilir veya bir gruba ekleyip toplu iletide kullanabilirsiniz.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[16rem_1fr]">
        <Card>
            <CardHeader><CardTitle>Kayıtlı aramalar</CardTitle></CardHeader>
            <CardContent>
                @if (saved.Count == 0)
                {
                    <p class="text-muted-foreground text-sm">Henüz kayıtlı arama yok.</p>
                }
                <ul class="grid gap-1 text-sm">
                    @foreach (var item in saved)
                    {
                        <li class="flex items-center justify-between gap-2">
                            <button type="button" class="@(item.Id == current?.Id ? "font-semibold" : "") text-left hover:underline" @onclick="() => OpenAsync(item)">@item.Name</button>
                            @if (canWrite)
                            {
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => DeleteSavedAsync(item.Id)" aria-label="Sil">×</Button>
                            }
                        </li>
                    }
                </ul>
            </CardContent>
        </Card>

        <div class="flex flex-col gap-6">
            <Card>
                <CardHeader>
                    <CardTitle>@(current?.Name ?? "Yeni arama")</CardTitle>
                </CardHeader>
                <CardContent Class="grid gap-3">
                    <FormAlert Error="@error" />
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var index = i;
                        var row = rows[index];
                        var definition = definitions.FirstOrDefault(d => d.Key == row.Key);
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="min-w-48 text-sm">@(definition is null ? row.Key : $"{definition.Group}: {definition.Label}")</span>
                            @switch (definition?.Kind)
                            {
                                case CriterionKind.Choice:
                                    <NativeSelect Class="w-56" Value="@row.Value" ValueChanged="v => rows[index] = row with { Value = v }" aria-label="Değer">
                                        <option value="">Seçin</option>
                                        @foreach (var option in definition.Options ?? [])
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </NativeSelect>
                                    break;
                                case CriterionKind.Date:
                                    <Input Class="w-48" Type="date" Value="@row.Value" ValueChanged="v => rows[index] = row with { Value = v }" aria-label="Tarih" />
                                    break;
                                case CriterionKind.Number:
                                case CriterionKind.Days:
                                    <Input Class="w-32" Type="number" Value="@row.Value" ValueChanged="v => rows[index] = row with { Value = v }" aria-label="Değer" />
                                    @if (definition.Kind == CriterionKind.Days)
                                    {
                                        <span class="text-muted-foreground text-sm">gün</span>
                                    }
                                    break;
                                case CriterionKind.Text:
                                    <Input Class="w-56" Value="@row.Value" ValueChanged="v => rows[index] = row with { Value = v }" aria-label="Değer" />
                                    break;
                            }
                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => rows.RemoveAt(index)">Kaldır</Button>
                        </div>
                    }
                    <div class="flex flex-wrap items-center gap-2">
                        <NativeSelect Class="w-72" Value="@adding" ValueChanged="AddCriterion" aria-label="Ölçüt ekle">
                            <option value="">+ Ölçüt ekle</option>
                            @foreach (var group in definitions.GroupBy(d => d.Group))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var definition in group)
                                    {
                                        <option value="@definition.Key">@definition.Label</option>
                                    }
                                </optgroup>
                            }
                        </NativeSelect>
                        <Button OnClick="() => RunAsync(1)">Ara</Button>
                    </div>
                </CardContent>
            </Card>

            @if (result is not null)
            {
                <Card>
                    <CardHeader>
                        <CardTitle>@result.Total.ToString("N0") kayıt</CardTitle>
                        <CardAction>
                            <div class="flex flex-wrap gap-2">
                                @if (CurrentUser.HasPermission(ContactsPermissions.Export))
                                {
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="ExportAsync">CSV</Button>
                                }
                                @if (canWrite)
                                {
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => groupOpen = true">Gruba ekle</Button>
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => { saveName = current?.Name; saveOpen = true; }">Kaydet</Button>
                                }
                            </div>
                        </CardAction>
                    </CardHeader>
                    <CardContent>
                        @if (notice is not null)
                        {
                            <Alert Class="mb-4"><AlertDescription>@notice</AlertDescription></Alert>
                        }
                        <Table>
                            <TableHeader>
                                <TableRow>
                                    <TableHead>Ad</TableHead>
                                    <TableHead>E-posta</TableHead>
                                    <TableHead>Telefon</TableHead>
                                    <TableHead>İl</TableHead>
                                </TableRow>
                            </TableHeader>
                            <TableBody>
                                @foreach (var item in result.Items)
                                {
                                    <TableRow>
                                        <TableCell><a class="font-medium hover:underline" href="contacts/@item.Id">@item.DisplayName</a></TableCell>
                                        <TableCell>@item.Email</TableCell>
                                        <TableCell>@item.Phone</TableCell>
                                        <TableCell>@item.City</TableCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                        @if (result.Total > result.PageSize)
                        {
                            <div class="mt-4 flex items-center justify-end gap-2 text-sm">
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Disabled="result.Page <= 1" OnClick="() => RunAsync(result.Page - 1)">Önceki</Button>
                                <span>@result.Page / @((result.Total + result.PageSize - 1) / result.PageSize)</span>
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Disabled="result.Page * result.PageSize >= result.Total" OnClick="() => RunAsync(result.Page + 1)">Sonraki</Button>
                            </div>
                        }
                    </CardContent>
                </Card>
            }
        </div>
    </div>
</div>

<Dialog @bind-Open="saveOpen">
    <DialogHeader><DialogTitle>Aramayı kaydet</DialogTitle></DialogHeader>
    <FormAlert Error="@saveError" />
    <form id="save-search" class="grid gap-2" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <Label for="search-name">Ad</Label>
        <Input id="search-name" @bind-Value="saveName" maxlength="120" placeholder="Geçen yıl bağış yapıp bu yıl yapmayanlar" />
        @if (current is not null)
        {
            <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="saveAsNew" /> Yeni arama olarak kaydet</label>
        }
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => saveOpen = false">Vazgeç</Button>
        <Button Type="submit" form="save-search">Kaydet</Button>
    </DialogFooter>
</Dialog>

<Dialog @bind-Open="groupOpen">
    <DialogHeader>
        <DialogTitle>Sonucu gruba ekle</DialogTitle>
        <DialogDescription>@result?.Total kayıt seçilen gruba eklenir; zaten üye olanlar değişmez.</DialogDescription>
    </DialogHeader>
    <NativeSelect @bind-Value="groupId" aria-label="Grup">
        <option value="">Grup seçin</option>
        @foreach (var group in groups)
        {
            <option value="@group.Id">@group.Name</option>
        }
    </NativeSelect>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => groupOpen = false">Vazgeç</Button>
        <Button Disabled="string.IsNullOrEmpty(groupId)" OnClick="AddToGroupAsync">Ekle</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<CriterionDefinition> definitions = [];
    private IReadOnlyList<SavedSearchView> saved = [];
    private IReadOnlyList<GroupDto> groups = [];
    private List<SearchCriterion> rows = [];
    private SavedSearchView? current;
    private PagedResult<ContactListItem>? result;
    private string? adding, error, notice, saveName, saveError, groupId;
    private bool canWrite, saveOpen, groupOpen, saveAsNew;

    [SupplyParameterFromQuery] public Guid? Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        canWrite = CurrentUser.HasPermission(ContactsPermissions.Write);
        definitions = await Search.DefinitionsAsync();
        saved = await Search.SavedAsync();
        groups = await Taxonomy.GroupsAsync();
        if (saved.FirstOrDefault(s => s.Id == Saved) is { } initial)
        {
            await OpenAsync(initial);
        }
    }

    private void AddCriterion(string? key)
    {
        if (!string.IsNullOrEmpty(key))
        {
            rows.Add(new SearchCriterion(key, null));
        }

        adding = null;
    }

    private async Task OpenAsync(SavedSearchView search)
    {
        current = search;
        rows = [.. search.Criteria];
        await RunAsync(1);
    }

    private async Task RunAsync(int pageNumber)
    {
        notice = null;
        var found = await Search.SearchAsync(rows, pageNumber, 50);
        (error, result) = found.IsSuccess ? ((string?)null, found.Value) : (found.Error!.Message, (PagedResult<ContactListItem>?)null);
    }

    private async Task SaveAsync()
    {
        var outcome = await Search.SaveAsync(saveAsNew ? null : current?.Id, saveName ?? "", rows);
        if (!outcome.IsSuccess)
        {
            saveError = outcome.Error!.Message;
            return;
        }

        saveOpen = false;
        saved = await Search.SavedAsync();
        current = saved.First(s => s.Id == outcome.Value);
    }

    private async Task DeleteSavedAsync(Guid id)
    {
        await Search.DeleteSavedAsync(id);
        saved = await Search.SavedAsync();
        current = current?.Id == id ? null : current;
    }

    private async Task AddToGroupAsync()
    {
        var added = await Search.AddToGroupAsync(rows, Guid.Parse(groupId!));
        groupOpen = false;
        notice = added.IsSuccess ? $"{added.Value} kayıt gruba eklendi." : added.Error!.Message;
    }

    private async Task ExportAsync()
    {
        var file = await Search.ExportAsync(rows);
        if (file.IsSuccess)
        {
            await JS.InvokeVoidAsync("armaDownload", "arama-sonucu.csv", "text/csv", Convert.ToBase64String(file.Value!));
        }
    }
}
