@inject CustomFieldService CustomFields

@* Kişi kartında kurumun tanımladığı ek alanlar. Tanımlı alan yoksa hiç görünmez. *@
@if (values.Count > 0)
{
    <Card>
        <CardHeader>
            <CardTitle>Ek bilgiler</CardTitle>
            @if (CanWrite)
            {
                <CardAction><Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="Open">Düzenle</Button></CardAction>
            }
        </CardHeader>
        <CardContent>
            <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
                @foreach (var item in values)
                {
                    <dt class="text-muted-foreground">@item.Label</dt>
                    <dd class="whitespace-pre-line">@(item.Display ?? "—")</dd>
                }
            </dl>
        </CardContent>
    </Card>

    <Dialog Open="editOpen" OpenChanged="v => editOpen = v" Class="sm:max-w-lg">
        <DialogHeader><DialogTitle>Ek bilgileri düzenle</DialogTitle></DialogHeader>
        <FormAlert Error="@error" />
        <form id="custom-fields-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            @foreach (var item in values)
            {
                var id = $"cf-{item.FieldId:N}";
                <div class="grid gap-2">
                    <Label for="@id">@item.Label</Label>
                    @switch (item.Type)
                    {
                        case CustomFieldType.Choice:
                            <NativeSelect id="@id" Value="@drafts[item.FieldId]" ValueChanged="v => drafts[item.FieldId] = v">
                                <option value="">Seçilmedi</option>
                                @foreach (var option in item.Options)
                                {
                                    <option value="@option">@option</option>
                                }
                            </NativeSelect>
                            break;
                        case CustomFieldType.YesNo:
                            <NativeSelect id="@id" Value="@drafts[item.FieldId]" ValueChanged="v => drafts[item.FieldId] = v">
                                <option value="">Belirtilmedi</option>
                                <option value="true">Evet</option>
                                <option value="false">Hayır</option>
                            </NativeSelect>
                            break;
                        case CustomFieldType.Date:
                            <input id="@id" type="date" class="@Styles.Input" value="@drafts[item.FieldId]" @onchange="e => drafts[item.FieldId] = e.Value?.ToString()" />
                            break;
                        case CustomFieldType.Number:
                            <Input id="@id" inputmode="decimal" Value="@drafts[item.FieldId]" ValueChanged="v => drafts[item.FieldId] = v" />
                            break;
                        default:
                            <Input id="@id" maxlength="@CustomField.MaxTextLength" Value="@drafts[item.FieldId]" ValueChanged="v => drafts[item.FieldId] = v" />
                            break;
                    }
                    @if (item.HelpText is not null)
                    {
                        <p class="text-muted-foreground text-xs">@item.HelpText</p>
                    }
                </div>
            }
        </form>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => editOpen = false">Vazgeç</Button>
            <Button Type="submit" form="custom-fields-form">Kaydet</Button>
        </DialogFooter>
    </Dialog>
}

@code {
    private IReadOnlyList<CustomFieldValue> values = [];
    private Dictionary<Guid, string?> drafts = [];
    private bool editOpen;
    private string? error;

    [Parameter] public Guid ContactId { get; set; }

    [Parameter] public bool CanWrite { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    protected override async Task OnParametersSetAsync() => values = await CustomFields.ValuesAsync(ContactId);

    private void Open()
    {
        // Sayı ekranda Türkçe biçimde (1.250,5) düzenlenir; tarih ve diğerleri saklandığı gibi.
        drafts = values.ToDictionary(v => v.FieldId, v => v.Type == CustomFieldType.Number ? v.Display : v.Value);
        error = null;
        editOpen = true;
    }

    private async Task SaveAsync()
    {
        var result = await CustomFields.SaveValuesAsync(ContactId, drafts);
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        editOpen = false;
        values = await CustomFields.ValuesAsync(ContactId);
        await OnSaved.InvokeAsync();
    }
}
