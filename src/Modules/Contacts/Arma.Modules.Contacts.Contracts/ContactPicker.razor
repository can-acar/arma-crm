@namespace Arma.Modules.Contacts.Contracts
@inject IContactDirectory Directory

@* Ad, e-posta veya telefonla kişi arar ve seçtirir. Diğer modüller (bağış, aktivite) de kullanır. *@
<div class="relative">
    @if (Selected is not null)
    {
        <div class="border-input flex h-9 items-center justify-between rounded-md border px-3 text-sm">
            <span>@Selected.DisplayName <span class="text-muted-foreground">@Selected.Email</span></span>
            <button type="button" class="text-muted-foreground hover:text-foreground text-xs" @onclick="ClearAsync">Değiştir</button>
        </div>
    }
    else
    {
        <Input Type="search" placeholder="@Placeholder" Value="@term" ValueChanged="SearchAsync" aria-label="@Placeholder" autocomplete="off" />
        @if (results.Count > 0)
        {
            <ul class="bg-popover text-popover-foreground absolute z-40 mt-1 max-h-64 w-full overflow-auto rounded-md border p-1 shadow-md" role="listbox">
                @foreach (var contact in results)
                {
                    <li role="option" aria-selected="false">
                        <button type="button" class="hover:bg-accent flex w-full flex-col items-start rounded-sm px-2 py-1.5 text-left text-sm" @onclick="() => SelectAsync(contact)">
                            <span>@contact.DisplayName</span>
                            <span class="text-muted-foreground text-xs">@(contact.Email ?? contact.Phone)</span>
                        </button>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private string? term;
    private IReadOnlyList<ContactSummary> results = [];
    private CancellationTokenSource? pending;

    [Parameter] public ContactSummary? Selected { get; set; }

    [Parameter] public EventCallback<ContactSummary?> SelectedChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Kişi veya kurum ara";

    /// <summary>Listeden çıkarılacak kayıt (örneğin kaydın kendisi).</summary>
    [Parameter] public Guid? Exclude { get; set; }

    private async Task SearchAsync(string? value)
    {
        term = value;
        pending?.Cancel();
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            results = [];
            return;
        }

        pending = new CancellationTokenSource();
        var token = pending.Token;
        try
        {
            await Task.Delay(200, token);
            var found = await Directory.SearchAsync(value, 8, token);
            results = found.Where(c => c.Id != Exclude).ToList();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SelectAsync(ContactSummary contact)
    {
        Selected = contact;
        results = [];
        term = null;
        await SelectedChanged.InvokeAsync(contact);
    }

    private async Task ClearAsync()
    {
        Selected = null;
        await SelectedChanged.InvokeAsync(null);
    }
}
