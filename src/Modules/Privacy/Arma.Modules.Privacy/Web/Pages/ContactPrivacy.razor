@inject ConsentRecordService Consents
@inject PersonalDataService PersonalData
@inject DataRequestService Requests
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@* Kişi kartındaki "KVKK" sekmesi: açık rıza durumu, başvurular, dışa aktarma ve anonimleştirme. *@
<div class="grid gap-4">
    @if (anonymizedAt is { } at)
    {
        <Alert><AlertDescription>Bu kişi @PrivacyLabels.Date(at) tarihinde anonimleştirildi. Kanunen saklanan kayıtlar (bağış, makbuz) kişiyle ilişkilendirilmeden duruyor.</AlertDescription></Alert>
    }

    <Card>
        <CardHeader>
            <CardTitle>Açık rıza</CardTitle>
            <CardDescription>Kayıtlar değiştirilmez; her onay ve geri alma metnin o anki sürümüyle saklanır.</CardDescription>
        </CardHeader>
        <CardContent Class="grid gap-3">
            <FormAlert Error="@error" />
            @if (states.Count == 0)
            {
                <p class="text-muted-foreground text-sm">Yayımlanmış açık rıza metni yok. Aydınlatma metinleri ekranından ekleyebilirsiniz.</p>
            }
            @foreach (var state in states)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
                    <div class="grid gap-1">
                        <div class="flex items-center gap-2">
                            <a class="font-medium hover:underline" href="kvkk/@state.Slug" target="_blank">@state.Title</a>
                            @if (state.Granted == true)
                            {
                                <Badge>Rıza var</Badge>
                            }
                            else if (state.Granted == false)
                            {
                                <Badge Variant="BadgeVariant.Destructive">Geri alındı</Badge>
                            }
                            else
                            {
                                <Badge Variant="BadgeVariant.Outline">Kayıt yok</Badge>
                            }
                            @if (state.Outdated)
                            {
                                <Badge Variant="BadgeVariant.Outline">Eski sürüm (@state.VersionNumber / @state.CurrentVersion)</Badge>
                            }
                        </div>
                        @if (state.RecordedAt is { } recorded)
                        {
                            <span class="text-muted-foreground text-xs">Sürüm @state.VersionNumber · @PrivacyLabels.Source(state.Source) · @PrivacyLabels.Date(recorded)</span>
                        }
                    </div>
                    @if (canManage && anonymizedAt is null)
                    {
                        <div class="flex gap-2">
                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => RecordAsync(state.NoticeId, true)">Rıza alındı</Button>
                            @if (state.Granted == true)
                            {
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => RecordAsync(state.NoticeId, false)">Geri alındı</Button>
                            }
                        </div>
                    }
                </div>
            }
            @if (history.Count > 0)
            {
                <details class="text-sm">
                    <summary class="text-muted-foreground cursor-pointer">Geçmiş (@history.Count kayıt)</summary>
                    <ul class="mt-2 grid gap-1">
                        @foreach (var item in history)
                        {
                            <li>@PrivacyLabels.Date(item.RecordedAt) · @item.Title (sürüm @item.VersionNumber) · @(item.Granted ? "rıza verildi" : "geri alındı") · @PrivacyLabels.Source(item.Source)</li>
                        }
                    </ul>
                </details>
            }
        </CardContent>
    </Card>

    @if (requests.Count > 0)
    {
        <Card>
            <CardHeader><CardTitle>Başvurular</CardTitle></CardHeader>
            <CardContent>
                <ul class="grid gap-2 text-sm">
                    @foreach (var request in requests)
                    {
                        <li><a class="font-medium hover:underline" href="privacy/requests/@request.Id">@PrivacyLabels.Type(request.Type)</a> · @request.ReceivedOn.ToString("dd.MM.yyyy") · @PrivacyLabels.Status(request.Status)</li>
                    }
                </ul>
            </CardContent>
        </Card>
    }

    @if (canExport || canErase)
    {
        <Card>
            <CardHeader>
                <CardTitle>Kişinin verileri</CardTitle>
                <CardDescription>Tüm modüllerdeki verisi tek dosyada indirilir; anonimleştirme kişiyi tanımlayan veriyi her yerden kalıcı olarak siler.</CardDescription>
            </CardHeader>
            <CardContent Class="flex flex-wrap gap-2">
                @if (canExport)
                {
                    <Button Variant="ButtonVariant.Outline" Href="@($"api/v1/privacy/contacts/{ContactId}/export")" target="_blank">Verileri indir (JSON)</Button>
                }
                @if (canErase && anonymizedAt is null)
                {
                    <Button Variant="ButtonVariant.Destructive" OnClick="() => confirmOpen = true">Anonimleştir</Button>
                }
            </CardContent>
        </Card>
    }
</div>

<Dialog @bind-Open="confirmOpen">
    <DialogHeader>
        <DialogTitle>Kişi anonimleştirilsin mi?</DialogTitle>
        <DialogDescription>Ad, iletişim bilgileri, kimlik numarası, adresler, notlar ve ileti içerikleri kalıcı olarak silinir. Bağış tutarları ve makbuzlar kanun gereği kalır. Bu işlem geri alınamaz.</DialogDescription>
    </DialogHeader>
    <FormAlert Error="@eraseError" />
    <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="confirmed" /> Geri alınamayacağını anladım</label>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => confirmOpen = false">Vazgeç</Button>
        <Button Variant="ButtonVariant.Destructive" Disabled="!confirmed" OnClick="AnonymizeAsync">Anonimleştir</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<ConsentState> states = [];
    private IReadOnlyList<ConsentHistoryItem> history = [];
    private IReadOnlyList<DataRequestView> requests = [];
    private DateTimeOffset? anonymizedAt;
    private string? error, eraseError;
    private bool canManage, canExport, canErase, confirmOpen, confirmed;

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        canManage = CurrentUser.HasPermission(PrivacyPermissions.Manage);
        canExport = CurrentUser.HasPermission(PrivacyPermissions.Export);
        canErase = CurrentUser.HasPermission(PrivacyPermissions.Erase);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        states = await Consents.ForContactAsync(ContactId);
        history = await Consents.HistoryAsync(ContactId);
        requests = await Requests.ListAsync(contactId: ContactId);
        anonymizedAt = await PersonalData.AnonymizedAtAsync(ContactId);
    }

    private async Task RecordAsync(Guid noticeId, bool granted)
    {
        var result = await Consents.RecordAsync(ContactId, noticeId, granted, "manual", null, null);
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }

    private async Task AnonymizeAsync()
    {
        var openErasure = requests.FirstOrDefault(r => r.Type == Domain.RequestType.Erasure && r.Status is Domain.RequestStatus.New or Domain.RequestStatus.InProgress);
        var result = await PersonalData.AnonymizeAsync(ContactId, openErasure?.Id);
        if (!result.IsSuccess)
        {
            eraseError = result.Error!.Message;
            return;
        }

        confirmOpen = false;
        Navigation.Refresh(forceReload: true);
    }
}
