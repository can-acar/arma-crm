@page "/privacy/requests"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PrivacyPermissions.Read)]
@inject DataRequestService Requests
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>KVKK başvuruları · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">KVKK başvuruları</h1>
            <p class="text-muted-foreground text-sm">İlgili kişi başvuruları en geç 30 gün içinde yanıtlanmalıdır. Kamuya açık form: <a class="underline" href="kvkk/basvuru" target="_blank">/kvkk/basvuru</a></p>
        </div>
        <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 text-sm"><Checkbox Checked="openOnly" CheckedChanged="ToggleAsync" /> Yalnızca açık</label>
            @if (canManage)
            {
                <Button OnClick="() => editorOpen = true">Başvuru kaydet</Button>
            }
        </div>
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Başvuru yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Başvuran</TableHead>
                            <TableHead>Talep</TableHead>
                            <TableHead>Geliş</TableHead>
                            <TableHead>Son gün</TableHead>
                            <TableHead>Durum</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var request in items)
                        {
                            <TableRow>
                                <TableCell>
                                    <a class="font-medium hover:underline" href="privacy/requests/@request.Id">@request.RequesterName</a>
                                    <div class="text-muted-foreground text-xs">@PrivacyLabels.Channel(request.Channel)</div>
                                </TableCell>
                                <TableCell>@PrivacyLabels.Type(request.Type)</TableCell>
                                <TableCell>@request.ReceivedOn.ToString("dd.MM.yyyy")</TableCell>
                                <TableCell>
                                    @request.DueOn.ToString("dd.MM.yyyy")
                                    @if (request.IsOverdue)
                                    {
                                        <Badge Variant="BadgeVariant.Destructive" Class="ml-2">Süre geçti</Badge>
                                    }
                                    else if (request.Status is RequestStatus.New or RequestStatus.InProgress && request.DaysLeft <= 7)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="ml-2">@request.DaysLeft gün</Badge>
                                    }
                                </TableCell>
                                <TableCell><Badge Variant="request.Status == RequestStatus.New ? BadgeVariant.Default : BadgeVariant.Secondary">@PrivacyLabels.Status(request.Status)</Badge></TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

<Dialog @bind-Open="editorOpen">
    <DialogHeader>
        <DialogTitle>Başvuru kaydet</DialogTitle>
        <DialogDescription>E-posta, KEP, posta veya elden gelen başvurular için.</DialogDescription>
    </DialogHeader>
    <FormAlert Error="@error" />
    <form id="request-form" class="grid gap-4" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid gap-2">
                <Label for="r-type">Talep</Label>
                <NativeSelect id="r-type" @bind-Value="type">
                    @foreach (var t in PrivacyLabels.Types)
                    {
                        <option value="@((int)t)">@PrivacyLabels.Type(t)</option>
                    }
                </NativeSelect>
            </div>
            <div class="grid gap-2">
                <Label for="r-channel">Geliş yolu</Label>
                <NativeSelect id="r-channel" @bind-Value="channel">
                    @foreach (var c in new[] { RequestChannel.Email, RequestChannel.InPerson, RequestChannel.Mail, RequestChannel.Web })
                    {
                        <option value="@((int)c)">@PrivacyLabels.Channel(c)</option>
                    }
                </NativeSelect>
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="r-name">Ad soyad</Label>
            <Input id="r-name" @bind-Value="name" maxlength="200" />
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="grid gap-2">
                <Label for="r-email">E-posta</Label>
                <Input id="r-email" type="email" @bind-Value="email" />
            </div>
            <div class="grid gap-2">
                <Label for="r-phone">Telefon</Label>
                <Input id="r-phone" @bind-Value="phone" />
            </div>
            <div class="grid gap-2">
                <Label for="r-date">Geliş tarihi</Label>
                <Input id="r-date" type="date" @bind-Value="received" />
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="r-description">Başvuru metni</Label>
            <Textarea id="r-description" @bind-Value="description" rows="5" maxlength="5000" />
        </div>
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => editorOpen = false">Vazgeç</Button>
        <Button Type="submit" form="request-form">Kaydet</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<DataRequestView> items = [];
    private string? type = "2", channel = "2", name, email, phone, description, error;
    private string? received = DateTime.Today.ToString("yyyy-MM-dd");
    private bool openOnly = true, canManage, editorOpen;

    protected override async Task OnInitializedAsync()
    {
        canManage = CurrentUser.HasPermission(PrivacyPermissions.Manage);
        items = await Requests.ListAsync(openOnly);
    }

    private async Task ToggleAsync(bool value)
    {
        openOnly = value;
        items = await Requests.ListAsync(openOnly);
    }

    private async Task CreateAsync()
    {
        var result = await Requests.CreateAsync(new CreateDataRequest((RequestType)int.Parse(type ?? "2"), (RequestChannel)int.Parse(channel ?? "2"),
            name ?? "", email, phone, description ?? "", DateOnly.TryParse(received, out var date) ? date : null));
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        Navigation.NavigateTo($"privacy/requests/{result.Value}");
    }
}
