@page "/privacy/notices"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PrivacyPermissions.Read)]
@inject NoticeService Notices
@inject ICurrentUser CurrentUser

<PageTitle>Aydınlatma metinleri · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Aydınlatma ve rıza metinleri</h1>
            <p class="text-muted-foreground text-sm">Yayımlanan her sürüm değişmeden saklanır. Rızalar, verildiği andaki sürüme bağlanır.</p>
        </div>
        @if (canManage)
        {
            <Button OnClick="() => Edit(null)">Metin ekle</Button>
        }
    </div>

    <Card>
        <CardContent>
            @if (notices.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz metin yok. Örnek: bağışçı aydınlatma metni, ticari ileti açık rıza metni.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Metin</TableHead>
                            <TableHead>Tür</TableHead>
                            <TableHead>Sürüm</TableHead>
                            <TableHead></TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var notice in notices)
                        {
                            <TableRow>
                                <TableCell>
                                    <div class="font-medium">@notice.Title</div>
                                    @if (notice.CurrentVersion > 0)
                                    {
                                        <a class="text-muted-foreground text-xs hover:underline" href="kvkk/@notice.Slug" target="_blank">/kvkk/@notice.Slug</a>
                                    }
                                </TableCell>
                                <TableCell>@(notice.RequiresConsent ? "Açık rıza" : "Aydınlatma")</TableCell>
                                <TableCell>
                                    @if (notice.CurrentVersion == 0)
                                    {
                                        <Badge Variant="BadgeVariant.Outline">Taslak</Badge>
                                    }
                                    else
                                    {
                                        <span>@notice.CurrentVersion · @PrivacyLabels.Date(notice.PublishedAt!.Value)</span>
                                        @if (notice.HasUnpublishedChanges)
                                        {
                                            <Badge Variant="BadgeVariant.Outline" Class="ml-2">Yayımlanmamış değişiklik</Badge>
                                        }
                                    }
                                </TableCell>
                                <TableCell Class="text-right whitespace-nowrap">
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ShowVersionsAsync(notice)">Sürümler</Button>
                                    @if (canManage)
                                    {
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => Edit(notice)">Düzenle</Button>
                                        @if (notice.HasUnpublishedChanges)
                                        {
                                            <Button Size="ButtonSize.Sm" OnClick="() => PublishAsync(notice.Id)">Yayımla</Button>
                                        }
                                    }
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
    <FormAlert Error="@listError" />
</div>

<Dialog @bind-Open="editorOpen">
    <DialogHeader>
        <DialogTitle>@(editing is null ? "Metin ekle" : "Metni düzenle")</DialogTitle>
        <DialogDescription>Kaydedilen metin taslaktır; kamuya açık sayfada ve rıza kayıtlarında görünmesi için yayımlayın.</DialogDescription>
    </DialogHeader>
    <FormAlert Error="@error" />
    <form id="notice-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid gap-2">
                <Label for="n-title">Başlık</Label>
                <Input id="n-title" @bind-Value="title" maxlength="200" />
            </div>
            <div class="grid gap-2">
                <Label for="n-slug">Adres (/kvkk/...)</Label>
                <Input id="n-slug" @bind-Value="slug" maxlength="80" placeholder="bagisci-aydinlatma" disabled="@(editing?.CurrentVersion > 0)" />
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="n-text">Metin</Label>
            <Textarea id="n-text" @bind-Value="text" rows="14" maxlength="50000" />
        </div>
        <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="requiresConsent" /> Açık rıza metni (kişiden onay alınır ve kaydedilir)</label>
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => editorOpen = false">Vazgeç</Button>
        <Button Type="submit" form="notice-form">Taslağı kaydet</Button>
    </DialogFooter>
</Dialog>

<Dialog @bind-Open="versionsOpen">
    <DialogHeader>
        <DialogTitle>@versionsTitle</DialogTitle>
    </DialogHeader>
    @if (versions.Count == 0)
    {
        <p class="text-muted-foreground text-sm">Henüz yayımlanmadı.</p>
    }
    <div class="grid max-h-[60vh] gap-4 overflow-y-auto">
        @foreach (var version in versions)
        {
            <div class="grid gap-1 text-sm">
                <div class="font-medium">Sürüm @version.Number · @PrivacyLabels.Date(version.PublishedAt)</div>
                <p class="text-muted-foreground whitespace-pre-wrap">@version.Text</p>
            </div>
        }
    </div>
</Dialog>

@code {
    private IReadOnlyList<NoticeView> notices = [];
    private IReadOnlyList<NoticeVersionView> versions = [];
    private NoticeView? editing;
    private string? title, slug, text, error, listError, versionsTitle;
    private bool requiresConsent, canManage, editorOpen, versionsOpen;

    protected override async Task OnInitializedAsync()
    {
        canManage = CurrentUser.HasPermission(PrivacyPermissions.Manage);
        notices = await Notices.ListAsync();
    }

    private void Edit(NoticeView? notice)
    {
        editing = notice;
        (title, slug, text, requiresConsent, error) = (notice?.Title, notice?.Slug, notice?.DraftText, notice?.RequiresConsent ?? false, null);
        editorOpen = true;
    }

    private async Task SaveAsync()
    {
        var result = await Notices.SaveAsync(editing?.Id, new SaveNoticeRequest(title ?? "", slug ?? "", requiresConsent, text ?? ""));
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        editorOpen = false;
        notices = await Notices.ListAsync();
    }

    private async Task PublishAsync(Guid id)
    {
        var result = await Notices.PublishAsync(id);
        listError = result.IsSuccess ? null : result.Error!.Message;
        notices = await Notices.ListAsync();
    }

    private async Task ShowVersionsAsync(NoticeView notice)
    {
        versionsTitle = notice.Title;
        versions = await Notices.VersionsAsync(notice.Id);
        versionsOpen = true;
    }
}
