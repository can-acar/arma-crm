@page "/privacy/inventory"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PrivacyPermissions.Read)]
@inject PersonalDataService PersonalData

<PageTitle>Kişisel veri envanteri · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Kişisel veri envanteri</h1>
            <p class="text-muted-foreground text-sm">Arma CRM'in tuttuğu kişisel veriler, amaçları ve saklama süreleri. VERBİS kaydı hazırlarken başlangıç olarak kullanın; kurumunuzun politikasına göre gözden geçirin.</p>
        </div>
        <Button Variant="ButtonVariant.Outline" Href="api/v1/privacy/inventory.csv" target="_blank">CSV indir</Button>
    </div>

    <Card>
        <CardContent>
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Modül</TableHead>
                        <TableHead>Veri</TableHead>
                        <TableHead>Kategori</TableHead>
                        <TableHead>Amaç</TableHead>
                        <TableHead>Hukuki sebep</TableHead>
                        <TableHead>Saklama</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in items)
                    {
                        <TableRow>
                            <TableCell>@item.Module</TableCell>
                            <TableCell Class="font-medium">@item.Data</TableCell>
                            <TableCell>@item.Category</TableCell>
                            <TableCell>@item.Purpose</TableCell>
                            <TableCell>@item.LegalBasis</TableCell>
                            <TableCell>@item.Retention</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<Arma.SharedKernel.Privacy.PersonalDataItem> items = [];

    protected override void OnInitialized() => items = PersonalData.Inventory();
}
