@inject MembershipService Members
@inject IContactDirectory Directory

@* Üye kaydı penceresi. Üye listesi ve kişi kartı kullanır. *@
<Dialog Open="Open" OpenChanged="OpenChanged" Class="sm:max-w-lg">
    <DialogHeader>
        <DialogTitle>Üye kaydet</DialogTitle>
        <DialogDescription>Üye numarası sırayla verilir.</DialogDescription>
    </DialogHeader>

    <FormAlert Error="@error" />

    <form id="join-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="grid gap-2">
            <Label>Kişi</Label>
            <ContactPicker @bind-Selected="contact" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid gap-2">
                <Label for="join-type">Üyelik türü</Label>
                <NativeSelect id="join-type" Value="@typeId" ValueChanged="TypeChanged">
                    @foreach (var type in types)
                    {
                        <option value="@type.Id">@type.Name (@MembershipLabels.Duration(type.DurationMonths))</option>
                    }
                </NativeSelect>
            </div>
            <div class="grid gap-2">
                <Label for="join-start">Başlangıç</Label>
                <input id="join-start" type="date" class="@Styles.Input" @bind="startOn" />
            </div>
        </div>
        <DuesFields @bind-Collect="collect" @bind-Amount="amount" @bind-Method="method" @bind-PaidOn="paidOn" />
        <div class="grid gap-2">
            <Label for="join-note">Not</Label>
            <Textarea id="join-note" @bind-Value="note" rows="2" maxlength="1000" />
        </div>
    </form>

    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => OpenChanged.InvokeAsync(false)">Vazgeç</Button>
        <Button Type="submit" form="join-form" Disabled="saving || types.Count == 0">Kaydet</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<MembershipTypeView> types = [];
    private ContactSummary? contact;
    private string? typeId, note, error, amount;
    private DuesMethod method = DuesMethod.BankTransfer;
    private DateOnly startOn, paidOn;
    private bool collect, saving, wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public Guid? ContactId { get; set; }

    [Parameter] public EventCallback<Guid> OnSaved { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen)
        {
            types = await Members.TypesAsync(activeOnly: true);
            contact = ContactId is { } id ? await Directory.FindAsync(id) : null;
            (startOn, paidOn, note, error, saving) = (Members.Today, Members.Today, null, types.Count == 0 ? "Önce bir üyelik türü tanımlayın." : null, false);
            TypeChanged(types.FirstOrDefault()?.Id.ToString());
        }

        wasOpen = Open;
    }

    private void TypeChanged(string? value)
    {
        typeId = value;
        var fee = types.FirstOrDefault(t => t.Id.ToString() == value)?.Fee ?? 0;
        collect = fee > 0;
        amount = fee > 0 ? fee.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) : null;
    }

    private async Task SaveAsync()
    {
        if (contact is null || !Guid.TryParse(typeId, out var type))
        {
            error = "Kişi ve üyelik türü seçin.";
            return;
        }

        DuesInput? dues = null;
        if (collect)
        {
            if (!MembershipLabels.TryParseMoney(amount, out var value))
            {
                error = "Aidat tutarını 1.250,00 biçiminde girin.";
                return;
            }

            dues = new(value, paidOn, method, null);
        }

        saving = true;
        var result = await Members.JoinAsync(new JoinRequest(contact.Id, type, startOn, note, dues));
        saving = false;
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        await OpenChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync(result.Value);
    }
}
