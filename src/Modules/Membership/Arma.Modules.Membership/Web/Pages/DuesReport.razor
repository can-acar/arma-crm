@page "/memberships/dues"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MembershipPermissions.Read)]
@inject MembershipService Members

<PageTitle>Aidatlar · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Aidatlar</h1>
            <p class="text-muted-foreground text-sm">Seçilen aralıkta alınan aidat: <span class="font-medium">@MembershipLabels.Money(total)</span> · @items.Count ödeme</p>
        </div>
        <div class="flex gap-2">
            <input type="date" class="@Styles.Input" aria-label="Başlangıç" value="@from.ToString("yyyy-MM-dd")" @onchange="e => ChangeAsync(e.Value, true)" />
            <input type="date" class="@Styles.Input" aria-label="Bitiş" value="@to.ToString("yyyy-MM-dd")" @onchange="e => ChangeAsync(e.Value, false)" />
        </div>
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Bu aralıkta aidat ödemesi yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Tarih</TableHead>
                            <TableHead>Üye</TableHead>
                            <TableHead>Tür</TableHead>
                            <TableHead Class="text-right">Tutar</TableHead>
                            <TableHead>Yöntem</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var (payment, member) in items)
                        {
                            <TableRow>
                                <TableCell>@MembershipLabels.Date(payment.PaidOn)</TableCell>
                                <TableCell><a class="hover:underline" href="memberships/@member.Id">@member.ContactName</a> <span class="text-muted-foreground">#@member.Number</span></TableCell>
                                <TableCell>@member.TypeName</TableCell>
                                <TableCell Class="text-right tabular-nums">@MembershipLabels.Money(payment.Amount)</TableCell>
                                <TableCell>@MembershipLabels.Method(payment.Method)</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<(DuesView Payment, MemberView Member)> items = [];
    private decimal total;
    private DateOnly from, to;

    protected override async Task OnInitializedAsync()
    {
        to = Members.Today;
        from = new DateOnly(to.Year, 1, 1);
        await LoadAsync();
    }

    private async Task ChangeAsync(object? value, bool start)
    {
        if (!DateOnly.TryParse(value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var date))
        {
            return;
        }

        if (start)
        {
            from = date;
        }
        else
        {
            to = date;
        }

        await LoadAsync();
    }

    private async Task LoadAsync() => (items, total) = await Members.PaymentsBetweenAsync(from, to);
}
