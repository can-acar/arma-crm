@* Üye listesi tablosu; üye listesi ve kişi kartı kullanır. *@
<Table>
    <TableHeader>
        <TableRow>
            <TableHead>No</TableHead>
            @if (ShowContact)
            {
                <TableHead>Üye</TableHead>
            }
            <TableHead>Tür</TableHead>
            <TableHead>Dönem</TableHead>
            <TableHead>Durum</TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        @foreach (var member in Items)
        {
            <TableRow>
                <TableCell Class="tabular-nums"><a class="font-medium hover:underline" href="memberships/@member.Id">@member.Number</a></TableCell>
                @if (ShowContact)
                {
                    <TableCell><a class="hover:underline" href="contacts/@member.ContactId">@member.ContactName</a></TableCell>
                }
                <TableCell>@member.TypeName</TableCell>
                <TableCell class="whitespace-nowrap">@MembershipLabels.Date(member.StartOn) – @(member.EndOn is { } end ? MembershipLabels.Date(end) : "süresiz")</TableCell>
                <TableCell><StatusBadge Status="member.Status" /></TableCell>
            </TableRow>
        }
    </TableBody>
</Table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MemberView> Items { get; set; } = [];

    [Parameter] public bool ShowContact { get; set; } = true;
}
