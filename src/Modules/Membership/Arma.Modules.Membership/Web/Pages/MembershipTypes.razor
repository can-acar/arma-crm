@page "/memberships/types"
@rendermode InteractiveServer
@attribute [Authorize(Policy = MembershipPermissions.Read)]
@inject MembershipService Members
@inject ICurrentUser CurrentUser

<PageTitle>Üyelik türleri · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Üyelik türleri</h1>
            <p class="text-muted-foreground text-sm">Asıl, fahri, öğrenci üyelik gibi. Süre ve aidat türe göre belirlenir.</p>
        </div>
        @if (canManage)
        {
            <Button OnClick="() => Edit(null)">Tür ekle</Button>
        }
    </div>

    <Card>
        <CardContent>
            @if (types.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz üyelik türü yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Tür</TableHead>
                            <TableHead>Süre</TableHead>
                            <TableHead Class="text-right">Aidat</TableHead>
                            <TableHead Class="text-right">Ek süre</TableHead>
                            <TableHead Class="text-right">Aktif üye</TableHead>
                            <TableHead></TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var type in types)
                        {
                            <TableRow>
                                <TableCell>
                                    <a class="font-medium hover:underline" href="memberships?type=@type.Id">@type.Name</a>
                                    @if (!type.IsActive)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="ml-2">Pasif</Badge>
                                    }
                                    @if (type.Description is not null)
                                    {
                                        <div class="text-muted-foreground text-xs">@type.Description</div>
                                    }
                                </TableCell>
                                <TableCell>@MembershipLabels.Duration(type.DurationMonths)</TableCell>
                                <TableCell Class="text-right tabular-nums">@(type.Fee > 0 ? MembershipLabels.Money(type.Fee) : "Aidatsız")</TableCell>
                                <TableCell Class="text-right tabular-nums">@type.GraceDays gün</TableCell>
                                <TableCell Class="text-right tabular-nums">@type.ActiveMembers</TableCell>
                                <TableCell Class="text-right">
                                    @if (canManage)
                                    {
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => Edit(type)">Düzenle</Button>
                                    }
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

<Dialog @bind-Open="editorOpen">
    <DialogHeader>
        <DialogTitle>@(editing is null ? "Üyelik türü ekle" : "Üyelik türünü düzenle")</DialogTitle>
    </DialogHeader>
    <FormAlert Error="@error" />
    <form id="type-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="grid gap-2">
            <Label for="type-name">Ad</Label>
            <Input id="type-name" @bind-Value="name" maxlength="120" />
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="grid gap-2">
                <Label for="type-duration">Süre (ay)</Label>
                <Input id="type-duration" Type="number" min="0" max="120" @bind-Value="duration" />
                <p class="text-muted-foreground text-xs">0 ise ömür boyu</p>
            </div>
            <div class="grid gap-2">
                <Label for="type-fee">Aidat (TL)</Label>
                <Input id="type-fee" inputmode="decimal" @bind-Value="fee" placeholder="0,00" />
            </div>
            <div class="grid gap-2">
                <Label for="type-grace">Ek süre (gün)</Label>
                <Input id="type-grace" Type="number" min="0" max="365" @bind-Value="grace" />
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="type-description">Açıklama</Label>
            <Textarea id="type-description" @bind-Value="description" rows="2" maxlength="500" />
        </div>
        @if (editing is not null)
        {
            <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="isActive" /> Etkin (pasif türe yeni üye kaydedilmez)</label>
        }
    </form>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => editorOpen = false">Vazgeç</Button>
        <Button Type="submit" form="type-form">Kaydet</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<MembershipTypeView> types = [];
    private MembershipTypeView? editing;
    private string? name, description, fee, duration, grace, error;
    private bool isActive = true, canManage, editorOpen;

    protected override async Task OnInitializedAsync()
    {
        canManage = CurrentUser.HasPermission(MembershipPermissions.Settings);
        types = await Members.TypesAsync();
    }

    private void Edit(MembershipTypeView? type)
    {
        editing = type;
        (name, description, isActive, error) = (type?.Name, type?.Description, type?.IsActive ?? true, null);
        duration = (type?.DurationMonths ?? 12).ToString();
        grace = (type?.GraceDays ?? 30).ToString();
        fee = type?.Fee.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
        editorOpen = true;
    }

    private async Task SaveAsync()
    {
        if (!int.TryParse(duration, out var months) || !int.TryParse(grace, out var graceDays))
        {
            error = "Süre ve ek süre sayı olmalı.";
            return;
        }

        var amount = 0m;
        if (!string.IsNullOrWhiteSpace(fee) && !MembershipLabels.TryParseMoney(fee, out amount))
        {
            error = "Aidatı 1.250,00 biçiminde girin.";
            return;
        }

        var result = await Members.SaveTypeAsync(editing?.Id, new SaveMembershipTypeRequest(name ?? "", description, months, amount, graceDays, isActive));
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        editorOpen = false;
        types = await Members.TypesAsync();
    }
}
