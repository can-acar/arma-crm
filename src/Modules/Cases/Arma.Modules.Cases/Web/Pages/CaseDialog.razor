@inject CaseService Cases
@inject IContactDirectory Directory
@inject ICurrentUser CurrentUser

@* Vaka açma ve düzenleme penceresi. *@
<Dialog Open="Open" OpenChanged="OpenChanged" Class="sm:max-w-lg">
    <DialogHeader>
        <DialogTitle>@(Existing is null ? "Yeni vaka" : "Vakayı düzenle")</DialogTitle>
    </DialogHeader>

    <FormAlert Error="@error" />

    <form id="case-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        @if (Existing is null)
        {
            <div class="grid gap-2">
                <Label>Kişi</Label>
                <ContactPicker @bind-Selected="contact" />
            </div>
            <div class="grid gap-2">
                <Label for="case-type">Vaka türü</Label>
                <NativeSelect id="case-type" @bind-Value="typeId">
                    <option value="">Seçin</option>
                    @foreach (var type in types)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </NativeSelect>
                @if (SelectedType is { Steps.Count: > 0 } selected)
                {
                    <p class="text-muted-foreground text-xs">Açılınca @selected.Steps.Count adım oluşur: @string.Join(", ", selected.Steps.Select(s => s.Title))</p>
                }
            </div>
        }
        <div class="grid gap-2">
            <Label for="case-subject">Konu</Label>
            <Input id="case-subject" @bind-Value="subject" maxlength="200" placeholder="Örnek: Kira yardımı başvurusu" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid gap-2">
                <Label for="case-priority">Öncelik</Label>
                <NativeSelect id="case-priority" @bind-Value="priority">
                    @foreach (var option in Enum.GetValues<CasePriority>())
                    {
                        <option value="@option">@CaseLabels.Priority(option)</option>
                    }
                </NativeSelect>
            </div>
            <div class="grid gap-2">
                <Label for="case-assignee">Sorumlu</Label>
                <NativeSelect id="case-assignee" @bind-Value="assigneeId">
                    <option value="">Atanmamış</option>
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.FullName</option>
                    }
                </NativeSelect>
            </div>
        </div>
        <div class="grid gap-2">
            <Label for="case-description">Açıklama</Label>
            <Textarea id="case-description" @bind-Value="description" rows="4" maxlength="4000" />
            <p class="text-muted-foreground text-xs">Açıklama vakayı görebilen herkese açıktır; hassas bilgileri gizli not olarak ekleyin.</p>
        </div>
    </form>

    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => OpenChanged.InvokeAsync(false)">Vazgeç</Button>
        <Button Type="submit" form="case-form" Disabled="saving">@(Existing is null ? "Vakayı aç" : "Kaydet")</Button>
    </DialogFooter>
</Dialog>

@code {
    private IReadOnlyList<CaseTypeView> types = [];
    private IReadOnlyList<UserSummary> users = [];
    private ContactSummary? contact;
    private string? typeId, subject, description, assigneeId, error;
    private string priority = nameof(CasePriority.Normal);
    private bool saving, wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public CaseDetail? Existing { get; set; }

    [Parameter] public Guid? ContactId { get; set; }

    [Parameter] public EventCallback<Guid> OnSaved { get; set; }

    private CaseTypeView? SelectedType => types.FirstOrDefault(t => t.Id.ToString() == typeId);

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen)
        {
            users = await Cases.AssignableUsersAsync();
            (error, saving) = (null, false);
            if (Existing is { } item)
            {
                (subject, description, priority) = (item.Summary.Subject, item.Description, item.Summary.Priority.ToString());
                assigneeId = item.Summary.AssigneeId?.ToString();
            }
            else
            {
                types = await Cases.TypesAsync(activeOnly: true);
                (subject, description, priority, typeId) = (null, null, nameof(CasePriority.Normal), types.Count == 1 ? types[0].Id.ToString() : null);
                assigneeId = users.Any(u => u.Id.ToString() == CurrentUser.Id) ? CurrentUser.Id : null;
                contact = ContactId is { } id ? await Directory.FindAsync(id) : null;
            }
        }

        wasOpen = Open;
    }

    private async Task SaveAsync()
    {
        var level = Enum.Parse<CasePriority>(priority);
        Guid? assignee = Guid.TryParse(assigneeId, out var a) ? a : null;
        Result<Guid> result;
        if (Existing is null)
        {
            if (contact is null || !Guid.TryParse(typeId, out var type))
            {
                error = "Kişi ve vaka türü gerekli.";
                return;
            }

            saving = true;
            result = await Cases.OpenAsync(new OpenCaseRequest(contact.Id, type, subject ?? "", description, level, assignee));
        }
        else
        {
            saving = true;
            result = await Cases.UpdateAsync(Existing.Summary.Id, new UpdateCaseRequest(subject ?? "", description, level, assignee));
        }

        saving = false;
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        await OpenChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync(result.Value);
    }
}
