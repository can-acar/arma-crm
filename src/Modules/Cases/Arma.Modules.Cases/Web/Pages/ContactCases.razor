@inject CaseService Cases
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@* Kişi kartındaki "Vakalar" sekmesi. *@
<Card>
    <CardHeader>
        <CardTitle>Vakalar</CardTitle>
        @if (CurrentUser.HasPermission(CasesPermissions.Write))
        {
            <CardAction><Button Size="ButtonSize.Sm" OnClick="() => dialogOpen = true">Vaka aç</Button></CardAction>
        }
    </CardHeader>
    <CardContent>
        @if (items.Count == 0)
        {
            <p class="text-muted-foreground text-sm">Vaka yok.</p>
        }
        else
        {
            <CaseTable Items="items" ShowContact="false" />
        }
    </CardContent>
</Card>

<CaseDialog @bind-Open="dialogOpen" ContactId="ContactId" OnSaved="Opened" />

@code {
    private IReadOnlyList<CaseListItem> items = [];
    private void Opened(Guid id) => Navigation.NavigateTo(Navigation.BaseUri + "cases/" + id);

    private bool dialogOpen;

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnParametersSetAsync() => items = await Cases.ForContactAsync(ContactId);
}
