@page "/cases/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = CasesPermissions.Read)]
@inject CaseService Cases
@inject ICurrentUser CurrentUser

<PageTitle>@(item?.Summary.Number ?? "Vaka") · Arma CRM</PageTitle>

@if (!loaded)
{
    <Skeleton Class="h-40" />
}
else if (item is null)
{
    <Alert><AlertTitle>Vaka bulunamadı</AlertTitle><AlertDescription>Silinmiş veya hiç oluşturulmamış olabilir.</AlertDescription></Alert>
}
else
{
    var summary = item.Summary;
    var closed = summary.Status == CaseStatus.Closed;
    <div class="flex flex-col gap-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex flex-col gap-1">
                <div class="text-muted-foreground text-sm"><a class="hover:underline" href="cases">Vakalar</a> / @summary.Number</div>
                <h1 class="text-2xl font-semibold tracking-tight">@summary.Subject</h1>
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    <Badge Variant="CaseLabels.StatusVariant(summary.Status)">@CaseLabels.Status(summary.Status)</Badge>
                    <span class="@CaseLabels.PriorityClass(summary.Priority)">@CaseLabels.Priority(summary.Priority) öncelik</span>
                    <span class="text-muted-foreground">· @summary.TypeName</span>
                </div>
            </div>
            @if (canWrite)
            {
                <div class="flex flex-wrap gap-2">
                    @if (!closed)
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick="() => editOpen = true">Düzenle</Button>
                        @if (summary.Status == CaseStatus.Open)
                        {
                            <Button Variant="ButtonVariant.Outline" OnClick="() => ChangeStatusAsync(CaseStatus.OnHold)">Beklemeye al</Button>
                        }
                        else
                        {
                            <Button Variant="ButtonVariant.Outline" OnClick="() => ChangeStatusAsync(CaseStatus.Open)">Devam ettir</Button>
                        }
                        <Button OnClick="() => (closeOpen, outcome, closeError) = (true, null, null)">Vakayı kapat</Button>
                    }
                    else
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick="() => ChangeStatusAsync(CaseStatus.Open)">Yeniden aç</Button>
                    }
                </div>
            }
        </div>

        <FormAlert Error="@error" />

        <div class="grid gap-6 lg:grid-cols-3">
            <div class="flex flex-col gap-6 lg:col-span-2">
                <Card>
                    <CardHeader>
                        <CardTitle>Adımlar</CardTitle>
                        <CardDescription>@summary.StepsDone / @summary.StepsTotal tamamlandı</CardDescription>
                    </CardHeader>
                    <CardContent>
                        @if (item.Steps.Count == 0)
                        {
                            <p class="text-muted-foreground text-sm">Adım yok.</p>
                        }
                        else
                        {
                            <ul class="flex flex-col divide-y" data-testid="case-steps">
                                @foreach (var step in item.Steps)
                                {
                                    <li class="flex items-center gap-3 py-2">
                                        <Checkbox Checked="step.CompletedAt is not null" CheckedChanged="v => ToggleStepAsync(step.Id, v)" disabled="@(!canWrite || closed)" aria-label="@step.Title" />
                                        <div class="flex min-w-0 flex-1 flex-col">
                                            <span class="@(step.CompletedAt is null ? "" : "text-muted-foreground line-through")">@step.Title</span>
                                            <span class="text-muted-foreground text-xs">
                                                @if (step.CompletedAt is { } done)
                                                {
                                                    @($"{done.ToLocalTime():dd.MM.yyyy} · {step.CompletedBy ?? "tamamlandı"}")
                                                }
                                                else if (step.DueOn is { } due)
                                                {
                                                    <span class="@(step.IsOverdue ? "text-destructive font-medium" : "")">Son gün @due.ToString("dd.MM.yyyy")@(step.IsOverdue ? " · gecikti" : "")</span>
                                                }
                                            </span>
                                        </div>
                                        @if (canWrite && !closed)
                                        {
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => DeleteStepAsync(step.Id)" aria-label="Adımı sil">Sil</Button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (canWrite && !closed)
                        {
                            <form class="mt-4 flex flex-wrap items-center gap-2" @onsubmit="AddStepAsync" @onsubmit:preventDefault>
                                <Input id="step-title" @bind-Value="stepTitle" placeholder="Yeni adım" maxlength="200" Class="min-w-48 flex-1" />
                                <input id="step-due" type="date" class="@Styles.Input" style="max-width: 11rem" @bind="stepDue" aria-label="Son gün" />
                                <Button Type="submit" Variant="ButtonVariant.Outline">Adım ekle</Button>
                            </form>
                        }
                    </CardContent>
                </Card>

                <Card>
                    <CardHeader>
                        <CardTitle>Notlar</CardTitle>
                        <CardDescription>Gizli olmayan notlar kişinin zaman çizelgesinde de görünür.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        @if (canWrite)
                        {
                            <form class="mb-4 flex flex-col gap-2" @onsubmit="AddNoteAsync" @onsubmit:preventDefault>
                                <Textarea id="note-body" @bind-Value="noteBody" rows="3" maxlength="8000" placeholder="Görüşme, ziyaret, karar…" />
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    @if (canConfidential)
                                    {
                                        <label class="flex items-center gap-2 text-sm">
                                            <Checkbox id="note-confidential" @bind-Checked="noteConfidential" />
                                            Gizli not (yalnızca gizli not yetkisi olanlar görür)
                                        </label>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <Button Type="submit" Size="ButtonSize.Sm">Not ekle</Button>
                                </div>
                            </form>
                        }
                        @if (notes.Count == 0)
                        {
                            <p class="text-muted-foreground text-sm">Not yok.</p>
                        }
                        else
                        {
                            <ul class="flex flex-col gap-3" data-testid="case-notes">
                                @foreach (var note in notes)
                                {
                                    <li class="@(note.IsConfidential ? "border-amber-500/40 bg-amber-500/5" : "") rounded-md border p-3">
                                        <div class="text-muted-foreground mb-1 flex items-center justify-between gap-2 text-xs">
                                            <span>
                                                @note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(note.CreatedBy ?? "Sistem")
                                                @if (note.IsConfidential)
                                                {
                                                    <Badge Variant="BadgeVariant.Outline" Class="ml-2">Gizli</Badge>
                                                }
                                            </span>
                                            @if (canWrite)
                                            {
                                                <button type="button" class="hover:text-foreground" @onclick="() => DeleteNoteAsync(note.Id)">Sil</button>
                                            }
                                        </div>
                                        <p class="text-sm whitespace-pre-line">@note.Body</p>
                                    </li>
                                }
                            </ul>
                        }
                    </CardContent>
                </Card>
            </div>

            <Card>
                <CardHeader><CardTitle>Bilgiler</CardTitle></CardHeader>
                <CardContent>
                    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
                        <dt class="text-muted-foreground">Kişi</dt>
                        <dd><a class="font-medium hover:underline" href="contacts/@summary.ContactId">@summary.ContactName</a></dd>
                        <dt class="text-muted-foreground">Sorumlu</dt>
                        <dd>@(summary.AssigneeName ?? "Atanmamış")</dd>
                        <dt class="text-muted-foreground">Açılış</dt>
                        <dd>@summary.OpenedOn.ToString("dd.MM.yyyy")</dd>
                        @if (summary.ClosedOn is { } closedOn)
                        {
                            <dt class="text-muted-foreground">Kapanış</dt>
                            <dd>@closedOn.ToString("dd.MM.yyyy")</dd>
                            <dt class="text-muted-foreground">Sonuç</dt>
                            <dd class="whitespace-pre-line">@item.Outcome</dd>
                        }
                        <dt class="text-muted-foreground">Açan</dt>
                        <dd>@(item.CreatedBy ?? "—")</dd>
                    </dl>
                    @if (item.Description is not null)
                    {
                        <Separator Class="my-4" />
                        <p class="text-sm whitespace-pre-line">@item.Description</p>
                    }
                </CardContent>
            </Card>
        </div>
    </div>

    <CaseDialog @bind-Open="editOpen" Existing="item" OnSaved="_ => LoadAsync()" />

    <Dialog @bind-Open="closeOpen" Class="sm:max-w-md">
        <DialogHeader>
            <DialogTitle>Vakayı kapat</DialogTitle>
            <DialogDescription>Sonuç kişinin zaman çizelgesine de yazılır.</DialogDescription>
        </DialogHeader>
        <FormAlert Error="@closeError" />
        <form id="close-form" class="grid gap-2" @onsubmit="CloseAsync" @onsubmit:preventDefault>
            <Label for="case-outcome">Sonuç</Label>
            <Textarea id="case-outcome" @bind-Value="outcome" rows="3" maxlength="500" placeholder="Örnek: Kira yardımı yapıldı" />
            @if (summary.StepsDone < summary.StepsTotal)
            {
                <p class="text-muted-foreground text-xs">@(summary.StepsTotal - summary.StepsDone) adım tamamlanmadı.</p>
            }
        </form>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => closeOpen = false">Vazgeç</Button>
            <Button Type="submit" form="close-form">Kapat</Button>
        </DialogFooter>
    </Dialog>
}

@code {
    private CaseDetail? item;
    private IReadOnlyList<CaseNoteView> notes = [];
    private string? error, stepTitle, noteBody, outcome, closeError;
    private DateOnly? stepDue;
    private bool loaded, canWrite, canConfidential, noteConfidential, editOpen, closeOpen;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        canWrite = CurrentUser.HasPermission(CasesPermissions.Write);
        canConfidential = CurrentUser.HasPermission(CasesPermissions.Confidential);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        item = await Cases.GetAsync(Id);
        notes = item is null ? [] : await Cases.NotesAsync(Id, canConfidential);
        loaded = true;
    }

    private async Task Run(Func<Task<Result<Guid>>> action)
    {
        var result = await action();
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }

    private Task ChangeStatusAsync(CaseStatus status) => Run(() => Cases.ChangeStatusAsync(Id, status, null));

    private async Task CloseAsync()
    {
        var result = await Cases.ChangeStatusAsync(Id, CaseStatus.Closed, outcome);
        if (!result.IsSuccess)
        {
            closeError = result.Error!.Message;
            return;
        }

        closeOpen = false;
        await LoadAsync();
    }

    private Task ToggleStepAsync(Guid stepId, bool done) => Run(() => Cases.SetStepDoneAsync(stepId, done));

    private async Task DeleteStepAsync(Guid stepId)
    {
        await Cases.DeleteStepAsync(stepId);
        await LoadAsync();
    }

    private async Task AddStepAsync()
    {
        await Run(() => Cases.AddStepAsync(Id, stepTitle ?? "", stepDue));
        if (error is null)
        {
            (stepTitle, stepDue) = (null, null);
        }
    }

    private async Task AddNoteAsync()
    {
        await Run(() => Cases.AddNoteAsync(Id, noteBody ?? "", canConfidential && noteConfidential));
        if (error is null)
        {
            (noteBody, noteConfidential) = (null, false);
        }
    }

    private async Task DeleteNoteAsync(Guid noteId)
    {
        await Cases.DeleteNoteAsync(noteId);
        await LoadAsync();
    }
}
