@inherits LayoutComponentBase

@* Bağışçı portalı: yönetim menüsü olmayan, oturum gerektirmeyen sayfalar. *@
<div class="bg-muted/40 min-h-svh">
    <header class="bg-background border-b">
        <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
            <a href="portal/hesap" class="font-semibold">Bağışçı portalı</a>
            @if (signedIn)
            {
                <form method="post" @formname="portal-logout" @onsubmit="SignOut">
                    <AntiforgeryToken />
                    <Button Type="submit" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">Çıkış</Button>
                </form>
            }
        </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-6">
        @Body
    </main>
</div>

@code {
    private bool signedIn;

    [Inject] private PortalService Portal { get; set; } = default!;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync() => signedIn = await Portal.ContactIdAsync() is not null;

    private void SignOut()
    {
        Portal.SignOut();
        Navigation.NavigateTo("portal", forceLoad: true);
    }
}
