@page "/portal/hesap"
@layout PortalLayout
@attribute [AllowAnonymous]
@inject PortalService Portal
@inject IContactDirectory Directory
@inject IEnumerable<IPortalSection> Sections
@inject NavigationManager Navigation

<PageTitle>Bağışçı portalı · Hesabım</PageTitle>

@if (contact is not null)
{
    <div class="grid gap-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Merhaba, @contact.DisplayName</h1>
            <p class="text-muted-foreground text-sm">@contact.Email</p>
        </div>
        @foreach (var part in Sections.OrderBy(s => s.Order))
        {
            <section aria-label="@part.Title" data-section="@part.Key" class="empty:hidden">
                <DynamicComponent Type="part.ComponentType" Parameters="@(new Dictionary<string, object> { ["ContactId"] = contact.Id })" />
            </section>
        }
    </div>
}

@code {
    private ContactSummary? contact;

    protected override async Task OnInitializedAsync()
    {
        if (await Portal.ContactIdAsync() is not { } id || await Directory.FindAsync(id) is not { } found)
        {
            Navigation.NavigateTo("portal");
            return;
        }

        contact = found;
    }
}
