@page "/tasks"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ActivitiesPermissions.Read)]
@inherits ActivityPageBase
@inject TimeProvider Clock

<PageTitle>Görevlerim · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Görevlerim</h1>
            <p class="text-muted-foreground text-sm">Size atanmış açık görevler, son tarihe göre</p>
        </div>
        @if (CanWrite)
        {
            <Button OnClick="() => New(ActivityKind.Task)">Yeni görev</Button>
        }
    </div>

    <FormAlert Error="@Error" />

    @if (userId is null)
    {
        <Alert><AlertDescription>Görevler yalnızca kullanıcı hesaplarına atanabilir.</AlertDescription></Alert>
    }
    else
    {
        @foreach (var (title, items, empty) in Sections)
        {
            <Card>
                <CardHeader>
                    <CardTitle>@title</CardTitle>
                    <CardDescription>@items.Count görev</CardDescription>
                </CardHeader>
                <CardContent>
                    @if (items.Count == 0)
                    {
                        <p class="text-muted-foreground text-sm">@empty</p>
                    }
                    else
                    {
                        <ul class="divide-y">
                            @foreach (var activity in items)
                            {
                                <ActivityItem Activity="activity" CanWrite="CanWrite" CanDelete="CanDelete"
                                              OnComplete="CompleteAsync" OnReopen="ReopenAsync" OnEdit="Edit" OnDelete="AskDelete" />
                            }
                        </ul>
                    }
                </CardContent>
            </Card>
        }
    }
</div>

<ActivityEditor @bind-Open="EditorOpen" Editing="Editing" DefaultKind="NewKind" OnSaved="ReloadAsync" />
<DeleteActivityDialog Activity="Deleting" OnConfirm="DeleteAsync" OnCancel="() => Deleting = null" />

@code {
    private Guid? userId;
    private IReadOnlyList<ActivityView> open = [];

    private IEnumerable<(string Title, IReadOnlyList<ActivityView> Items, string Empty)> Sections
    {
        get
        {
            var now = Clock.GetLocalNow();
            var endOfDay = now.Date.AddDays(1);
            yield return ("Geciken", open.Where(a => a.IsOverdue).ToList(), "Geciken göreviniz yok.");
            yield return ("Bugün", open.Where(a => !a.IsOverdue && a.DueAt?.ToLocalTime() < endOfDay).ToList(), "Bugün için görev yok.");
            yield return ("Yaklaşan", open.Where(a => a.DueAt is null || a.DueAt.Value.ToLocalTime() >= endOfDay).ToList(), "Yaklaşan görev yok.");
        }
    }

    protected override async Task ReloadAsync()
    {
        userId = Guid.TryParse(CurrentUser.Id, out var id) ? id : null;
        if (userId is { } me)
        {
            var page = await Activities.ListAsync(new ActivityFilter(AssignedTo: me, Kind: ActivityKind.Task, Status: ActivityStatus.Open, PageSize: 200));
            open = page.Items;
        }
    }
}
