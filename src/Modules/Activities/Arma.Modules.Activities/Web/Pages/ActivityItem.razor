@* Zaman çizelgesi ve listelerdeki tek aktivite satırı. *@
<li class="flex gap-3 py-3">
    <span class="@($"mt-0.5 h-fit shrink-0 rounded-md px-2 py-0.5 text-xs font-medium {ActivityLabels.KindClass(Activity.Kind)}")">@ActivityLabels.Kind(Activity.Kind)</span>
    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-2">
            <span class="@(Activity.Status == ActivityStatus.Done && Activity.IsTask ? "font-medium line-through decoration-1" : "font-medium")">@Activity.Subject</span>
            @if (Activity.IsTask)
            {
                @if (Activity.IsOverdue)
                {
                    <Badge Variant="BadgeVariant.Destructive">Gecikti</Badge>
                }
                else if (Activity.Status != ActivityStatus.Open)
                {
                    <Badge Variant="BadgeVariant.Secondary">@ActivityLabels.Status(Activity.Status)</Badge>
                }
            }
        </div>
        @if (Activity.Body is not null)
        {
            <p class="text-muted-foreground mt-1 text-sm whitespace-pre-line">@Activity.Body</p>
        }
        <div class="text-muted-foreground mt-1 flex flex-wrap gap-x-3 text-xs">
            @if (Activity.IsTask && Activity.Status == ActivityStatus.Open)
            {
                <span>@(Activity.DueAt is null ? "Son tarih yok" : $"Son tarih {ActivityLabels.Date(Activity.DueAt)}")</span>
            }
            else
            {
                <span>@ActivityLabels.Date(Activity.When)</span>
            }
            @if (Activity.AssignedToName is not null)
            {
                <span>@Activity.AssignedToName</span>
            }
            @if (ShowContacts)
            {
                @foreach (var contact in Activity.Contacts)
                {
                    <a class="hover:text-foreground underline-offset-2 hover:underline" href="contacts/@contact.Id">@contact.DisplayName</a>
                }
            }
            @if (Activity.IsSystem)
            {
                <span>Otomatik kayıt</span>
            }
        </div>
    </div>
    @if (CanWrite && !Activity.IsSystem)
    {
        <div class="flex shrink-0 items-start gap-1">
            @if (Activity.IsTask && Activity.Status == ActivityStatus.Open)
            {
                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => OnComplete.InvokeAsync(Activity)">Tamamla</Button>
            }
            else if (Activity.IsTask)
            {
                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => OnReopen.InvokeAsync(Activity)">Yeniden aç</Button>
            }
            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => OnEdit.InvokeAsync(Activity)">Düzenle</Button>
            @if (CanDelete)
            {
                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => OnDelete.InvokeAsync(Activity)">Sil</Button>
            }
        </div>
    }
</li>

@code {
    [Parameter, EditorRequired] public ActivityView Activity { get; set; } = default!;

    [Parameter] public bool ShowContacts { get; set; } = true;

    [Parameter] public bool CanWrite { get; set; }

    [Parameter] public bool CanDelete { get; set; }

    [Parameter] public EventCallback<ActivityView> OnComplete { get; set; }

    [Parameter] public EventCallback<ActivityView> OnReopen { get; set; }

    [Parameter] public EventCallback<ActivityView> OnEdit { get; set; }

    [Parameter] public EventCallback<ActivityView> OnDelete { get; set; }
}
