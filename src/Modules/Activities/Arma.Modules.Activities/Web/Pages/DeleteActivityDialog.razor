<Dialog Open="Activity is not null" OpenChanged="OnOpenChanged">
    <DialogHeader>
        <DialogTitle>Aktivite silinsin mi?</DialogTitle>
        <DialogDescription>"@Activity?.Subject" zaman çizelgesinden kalkar. Denetim izinde kaydı korunur.</DialogDescription>
    </DialogHeader>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => OnOpenChanged(false)">Vazgeç</Button>
        <Button Variant="ButtonVariant.Destructive" OnClick="OnConfirm">Sil</Button>
    </DialogFooter>
</Dialog>

@code {
    [Parameter] public ActivityView? Activity { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private Task OnOpenChanged(bool open) => open ? Task.CompletedTask : OnCancel.InvokeAsync();
}
