@page "/events"
@rendermode InteractiveServer
@attribute [Authorize(Policy = EventsPermissions.Read)]
@inject EventService Events
@inject ICurrentUser CurrentUser

<PageTitle>Etkinlikler · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Etkinlikler</h1>
            <p class="text-muted-foreground text-sm">Seminer, eğitim, gala, kermes. Yayımlanan etkinliğe web sayfasından kayıt alınır.</p>
        </div>
        @if (CurrentUser.HasPermission(EventsPermissions.Write))
        {
            <Button Href="events/new">Yeni etkinlik</Button>
        }
    </div>

    <div class="flex gap-2">
        <Button Size="ButtonSize.Sm" Variant="past ? ButtonVariant.Outline : ButtonVariant.Secondary" OnClick="() => ShowAsync(false)">Yaklaşan</Button>
        <Button Size="ButtonSize.Sm" Variant="past ? ButtonVariant.Secondary : ButtonVariant.Outline" OnClick="() => ShowAsync(true)">Geçmiş</Button>
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">@(past ? "Geçmiş etkinlik yok." : "Yaklaşan etkinlik yok.")</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Etkinlik</TableHead>
                            <TableHead>Tarih</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead Class="text-right">Kayıt</TableHead>
                            <TableHead Class="text-right">Yedek</TableHead>
                            <TableHead Class="text-right">Katılan</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var item in items)
                        {
                            <TableRow>
                                <TableCell>
                                    <a class="font-medium hover:underline" href="events/@item.Id">@item.Title</a>
                                    @if (item.Location is not null)
                                    {
                                        <div class="text-muted-foreground text-xs">@item.Location</div>
                                    }
                                </TableCell>
                                <TableCell class="whitespace-nowrap">@EventLabels.When(item.StartsAt, item.EndsAt)</TableCell>
                                <TableCell><Badge Variant="item.Status == EventStatus.Published ? BadgeVariant.Secondary : BadgeVariant.Outline">@EventLabels.EventStatus(item.Status)</Badge></TableCell>
                                <TableCell Class="text-right tabular-nums">@item.Registered@(item.Capacity is { } c ? $"/{c}" : "")</TableCell>
                                <TableCell Class="text-right tabular-nums">@item.Waitlisted</TableCell>
                                <TableCell Class="text-right tabular-nums">@item.CheckedIn</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<EventSummary> items = [];
    private bool past;

    protected override Task OnInitializedAsync() => ShowAsync(false);

    private async Task ShowAsync(bool showPast)
    {
        past = showPast;
        items = await Events.ListAsync(past);
    }
}
