@inject EventService Events

@* Kişi kartındaki "Etkinlikler" sekmesi. Kayıt etkinlik sayfasından yapılır. *@
<Card>
    <CardHeader><CardTitle>Etkinlik kayıtları</CardTitle></CardHeader>
    <CardContent>
        @if (items.Count == 0)
        {
            <p class="text-muted-foreground text-sm">Etkinlik kaydı yok.</p>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Etkinlik</TableHead>
                        <TableHead>Tarih</TableHead>
                        <TableHead>Bilet</TableHead>
                        <TableHead>Durum</TableHead>
                        <TableHead>Giriş</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in items)
                    {
                        <TableRow>
                            <TableCell><a class="hover:underline" href="events/@r.EventId">@r.EventTitle</a></TableCell>
                            <TableCell>@r.StartsAt.ToLocalTime().ToString("dd.MM.yyyy")</TableCell>
                            <TableCell>@(r.TicketName ?? "—")</TableCell>
                            <TableCell>@EventLabels.Status(r.Status)@(r.Payment == PaymentState.Unpaid ? " · ödenmedi" : "")</TableCell>
                            <TableCell>@(r.CheckedInAt is null ? "—" : "Katıldı")</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private IReadOnlyList<ContactRegistrationView> items = [];

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnInitializedAsync() => items = await Events.ForContactAsync(ContactId);
}
