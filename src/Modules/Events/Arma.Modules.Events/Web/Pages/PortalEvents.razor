@inject EventService Events
@inject TimeProvider Clock

@* Bağışçı portalında "Etkinliklerim": yaklaşan kayıtlar bilet bağlantısıyla, geçmiş katılımlar. *@
@if (upcoming.Count > 0 || past.Count > 0)
{
    <Card>
        <CardHeader><CardTitle>Etkinliklerim</CardTitle></CardHeader>
        <CardContent Class="grid gap-2">
            @foreach (var registration in upcoming)
            {
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border p-3 text-sm">
                    <div>
                        <div class="font-medium">@registration.EventTitle</div>
                        <div class="text-muted-foreground text-xs">@registration.StartsAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@(registration.TicketName is null ? "" : $" · {registration.TicketName}") · @EventLabels.Status(registration.Status)</div>
                    </div>
                    @if (registration.Status == RegistrationStatus.Registered)
                    {
                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Href="@($"e/bilet/{registration.Code}")" target="_blank">Bilet</Button>
                    }
                </div>
            }
            @if (past.Count > 0)
            {
                <p class="text-muted-foreground mt-2 text-xs">Katıldığınız etkinlikler: @string.Join(", ", past.Select(r => $"{r.EventTitle} ({r.StartsAt.ToLocalTime():dd.MM.yyyy})"))</p>
            }
        </CardContent>
    </Card>
}

@code {
    private IReadOnlyList<ContactRegistrationView> upcoming = [], past = [];

    [Parameter] public Guid ContactId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var all = await Events.ForContactAsync(ContactId);
        var now = Clock.GetUtcNow();
        upcoming = [.. all.Where(r => r.StartsAt >= now && r.Status != RegistrationStatus.Cancelled).OrderBy(r => r.StartsAt)];
        past = [.. all.Where(r => r.StartsAt < now && r.CheckedInAt is not null).Take(10)];
    }
}
