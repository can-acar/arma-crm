@page "/events/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = EventsPermissions.Read)]
@inject EventService Events
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>@(item?.Title ?? "Etkinlik") · Arma CRM</PageTitle>

@if (item is null)
{
    @if (loaded)
    {
        <Alert><AlertTitle>Etkinlik bulunamadı</AlertTitle></Alert>
    }
}
else
{
    <div class="flex flex-col gap-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-muted-foreground text-sm"><a class="hover:underline" href="events">Etkinlikler</a></p>
                <h1 class="flex items-center gap-2 text-2xl font-semibold tracking-tight">@item.Title <Badge Variant="item.Status == EventStatus.Published ? BadgeVariant.Secondary : BadgeVariant.Outline">@EventLabels.EventStatus(item.Status)</Badge></h1>
                <p class="text-sm">@EventLabels.When(item.StartsAt, item.EndsAt)@(item.Location is null ? "" : $" · {item.Location}")</p>
            </div>
            <div class="flex flex-wrap gap-2">
                @if (CurrentUser.HasPermission(EventsPermissions.CheckIn) && item.Status != EventStatus.Cancelled)
                {
                    <Button Href="@($"events/{item.Id}/checkin")">Giriş ekranı</Button>
                }
                @if (item.Status != EventStatus.Draft)
                {
                    <Button Variant="ButtonVariant.Outline" Href="@($"e/{item.Slug}")" target="_blank">Kayıt sayfası</Button>
                }
                @if (canWrite && item.Status != EventStatus.Cancelled)
                {
                    <Button Variant="ButtonVariant.Outline" Href="@($"events/{item.Id}/edit")">Düzenle</Button>
                    <Button Variant="ButtonVariant.Outline" OnClick="TogglePublishAsync">@(item.Status == EventStatus.Published ? "Yayından kaldır" : "Yayımla")</Button>
                    <Button Variant="ButtonVariant.Ghost" OnClick="() => cancelOpen = true">Etkinliği iptal et</Button>
                }
            </div>
        </div>

        <FormAlert Error="@error" />

        <div class="grid gap-4 sm:grid-cols-4">
            <Stat Label="Kesin kayıt" Value="@($"{item.Registered}{(item.Capacity is { } c ? $" / {c}" : "")}")" />
            <Stat Label="Yedek liste" Value="@item.Waitlisted.ToString()" />
            <Stat Label="Giriş yapan" Value="@item.CheckedIn.ToString()" />
            <Stat Label="Tahsil edilen" Value="@string.Format(Turkish, "{0:N2} TL", participants.Where(p => p.Payment == PaymentState.Paid && p.Status == RegistrationStatus.Registered).Sum(p => p.Amount))" />
        </div>

        <Card>
            <CardHeader>
                <CardTitle>Bilet türleri</CardTitle>
                <CardDescription>Bilet türü yoksa kayıt ücretsizdir. Kapalı tür kayıt sayfasında görünmez (davetli gibi).</CardDescription>
                @if (canWrite)
                {
                    <CardAction><Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => EditTicket(null)">Bilet türü ekle</Button></CardAction>
                }
            </CardHeader>
            @if (item.Tickets.Count > 0)
            {
                <CardContent>
                    <Table>
                        <TableBody>
                            @foreach (var ticket in item.Tickets)
                            {
                                <TableRow>
                                    <TableCell Class="font-medium">@ticket.Name @if (!ticket.IsPublic) { <Badge Variant="BadgeVariant.Outline" Class="ml-2">Kapalı</Badge> }</TableCell>
                                    <TableCell Class="text-right tabular-nums">@EventLabels.Money(ticket.Price)</TableCell>
                                    <TableCell Class="text-right tabular-nums">@ticket.Registered@(ticket.Capacity is { } tc ? $" / {tc}" : "") kayıt</TableCell>
                                    <TableCell Class="text-right">
                                        @if (canWrite)
                                        {
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => EditTicket(ticket)">Düzenle</Button>
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => DeleteTicketAsync(ticket.Id)">Sil</Button>
                                        }
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </CardContent>
            }
        </Card>

        <Card>
            <CardHeader>
                <CardTitle>Katılımcılar</CardTitle>
                <CardAction>
                    <div class="flex gap-2">
                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Href="@($"api/v1/events/{item.Id}/participants.csv")" target="_blank">CSV</Button>
                        @if (canWrite && item.Status != EventStatus.Cancelled)
                        {
                            <Button Size="ButtonSize.Sm" OnClick="OpenRegister">Katılımcı ekle</Button>
                        }
                    </div>
                </CardAction>
            </CardHeader>
            <CardContent>
                @if (participants.Count == 0)
                {
                    <p class="text-muted-foreground text-sm">Henüz kayıt yok.</p>
                }
                else
                {
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Kişi</TableHead>
                                <TableHead>Bilet</TableHead>
                                <TableHead>Durum</TableHead>
                                <TableHead>Ödeme</TableHead>
                                <TableHead>Giriş</TableHead>
                                <TableHead></TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var p in participants)
                            {
                                <TableRow Class="@(p.Status == RegistrationStatus.Cancelled ? "text-muted-foreground" : "")">
                                    <TableCell>
                                        <a class="hover:underline" href="contacts/@p.ContactId">@p.Name</a>
                                        <div class="text-muted-foreground text-xs">@p.Email · <span class="font-mono">@p.Code</span>@(p.Source == "web" ? " · web" : "")</div>
                                    </TableCell>
                                    <TableCell>@(p.TicketName ?? "—")</TableCell>
                                    <TableCell><Badge Variant="p.Status == RegistrationStatus.Registered ? BadgeVariant.Secondary : BadgeVariant.Outline">@EventLabels.Status(p.Status)</Badge></TableCell>
                                    <TableCell>
                                        @if (p.Payment == PaymentState.Free)
                                        {
                                            <span class="text-muted-foreground">Ücretsiz</span>
                                        }
                                        else if (canWrite)
                                        {
                                            <label class="flex items-center gap-2"><Checkbox Checked="p.Payment == PaymentState.Paid" CheckedChanged="v => MarkPaidAsync(p.Id, v)" /> @EventLabels.Money(p.Amount)</label>
                                        }
                                        else
                                        {
                                            @EventLabels.Payment(p.Payment)
                                        }
                                    </TableCell>
                                    <TableCell class="whitespace-nowrap">@(p.CheckedInAt?.ToLocalTime().ToString("dd.MM HH:mm") ?? "—")</TableCell>
                                    <TableCell Class="text-right whitespace-nowrap">
                                        @if (p.CheckedInAt is not null)
                                        {
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Href="@($"e/bilet/{p.Code}/belge")" target="_blank">Belge</Button>
                                            @if (canWrite)
                                            {
                                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => UndoCheckInAsync(p.Id)">Girişi geri al</Button>
                                            }
                                        }
                                        else if (canCheckIn && p.Status == RegistrationStatus.Registered)
                                        {
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => CheckInAsync(p.Code)">Giriş</Button>
                                        }
                                        @if (canWrite && p.Status != RegistrationStatus.Cancelled)
                                        {
                                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => CancelRegistrationAsync(p.Id)">İptal</Button>
                                        }
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            </CardContent>
        </Card>

        @if (item.Description is not null)
        {
            <Card>
                <CardHeader><CardTitle>Açıklama</CardTitle></CardHeader>
                <CardContent><p class="text-sm whitespace-pre-line">@item.Description</p></CardContent>
            </Card>
        }
    </div>

    <Dialog @bind-Open="ticketOpen">
        <DialogHeader><DialogTitle>@(editingTicket is null ? "Bilet türü ekle" : "Bilet türünü düzenle")</DialogTitle></DialogHeader>
        <FormAlert Error="@dialogError" />
        <form id="ticket-form" class="grid gap-4" @onsubmit="SaveTicketAsync" @onsubmit:preventDefault>
            <div class="grid gap-2">
                <Label for="ticket-name">Ad</Label>
                <Input id="ticket-name" @bind-Value="ticketName" maxlength="100" placeholder="Tam, Öğrenci, Davetli" />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="grid gap-2">
                    <Label for="ticket-price">Fiyat (TL)</Label>
                    <Input id="ticket-price" inputmode="decimal" @bind-Value="ticketPrice" placeholder="Ücretsiz" />
                </div>
                <div class="grid gap-2">
                    <Label for="ticket-capacity">Kontenjan</Label>
                    <Input id="ticket-capacity" Type="number" min="1" @bind-Value="ticketCapacity" placeholder="Etkinlik kontenjanı" />
                </div>
            </div>
            <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="ticketPublic" /> Kayıt sayfasında görünsün</label>
        </form>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => ticketOpen = false">Vazgeç</Button>
            <Button Type="submit" form="ticket-form">Kaydet</Button>
        </DialogFooter>
    </Dialog>

    <Dialog @bind-Open="registerOpen">
        <DialogHeader>
            <DialogTitle>Katılımcı ekle</DialogTitle>
            <DialogDescription>Kontenjan doluysa yedek listeye alınır. Kişinin e-postasına bilet gönderilir.</DialogDescription>
        </DialogHeader>
        <FormAlert Error="@dialogError" />
        <form id="register-form" class="grid gap-4" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
            <div class="grid gap-2">
                <Label>Kişi</Label>
                <ContactPicker @bind-Selected="registerContact" />
            </div>
            @if (item.Tickets.Count > 0)
            {
                <div class="grid gap-2">
                    <Label for="register-ticket">Bilet</Label>
                    <NativeSelect id="register-ticket" @bind-Value="registerTicket">
                        @foreach (var ticket in item.Tickets)
                        {
                            <option value="@ticket.Id">@ticket.Name (@EventLabels.Money(ticket.Price))</option>
                        }
                    </NativeSelect>
                </div>
            }
            <div class="grid gap-2">
                <Label for="register-note">Not</Label>
                <Input id="register-note" @bind-Value="registerNote" maxlength="500" placeholder="Vejetaryen menü" />
            </div>
        </form>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => registerOpen = false">Vazgeç</Button>
            <Button Type="submit" form="register-form">Kaydet</Button>
        </DialogFooter>
    </Dialog>

    <Dialog @bind-Open="cancelOpen">
        <DialogHeader>
            <DialogTitle>Etkinliği iptal et</DialogTitle>
            <DialogDescription>Kayıtlı ve yedekteki herkese iptal e-postası gönderilir. Geri alınamaz.</DialogDescription>
        </DialogHeader>
        <div class="grid gap-2">
            <Label for="cancel-message">E-postaya eklenecek açıklama</Label>
            <Textarea id="cancel-message" @bind-Value="cancelMessage" rows="3" maxlength="1000" placeholder="Ücretli biletlerin iadesi için sizinle iletişime geçeceğiz." />
        </div>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => cancelOpen = false">Vazgeç</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="CancelEventAsync">İptal et</Button>
        </DialogFooter>
    </Dialog>
}

@code {
    private static readonly System.Globalization.CultureInfo Turkish = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    private EventView? item;
    private IReadOnlyList<ParticipantView> participants = [];
    private TicketView? editingTicket;
    private ContactSummary? registerContact;
    private string? error, dialogError, ticketName, ticketPrice, ticketCapacity, registerTicket, registerNote, cancelMessage;
    private bool loaded, canWrite, canCheckIn, ticketOpen, registerOpen, cancelOpen, ticketPublic = true;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        canWrite = CurrentUser.HasPermission(EventsPermissions.Write);
        canCheckIn = CurrentUser.HasPermission(EventsPermissions.CheckIn);
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        item = await Events.GetAsync(Id);
        participants = await Events.ParticipantsAsync(Id);
    }

    private async Task TogglePublishAsync() => await Done(await Events.PublishAsync(Id, item!.Status != EventStatus.Published));

    private async Task CancelEventAsync()
    {
        cancelOpen = false;
        await Done(await Events.CancelEventAsync(Id, cancelMessage));
    }

    private void EditTicket(TicketView? ticket)
    {
        editingTicket = ticket;
        (ticketName, ticketPublic, dialogError) = (ticket?.Name, ticket?.IsPublic ?? true, null);
        ticketPrice = ticket is { Price: > 0 } ? ticket.Price.ToString("N2", Turkish) : null;
        ticketCapacity = ticket?.Capacity?.ToString();
        ticketOpen = true;
    }

    private async Task SaveTicketAsync()
    {
        if (!EventLabels.TryParseMoney(ticketPrice, out var price))
        {
            dialogError = "Fiyatı 250,00 biçiminde girin.";
            return;
        }

        int? seats = int.TryParse(ticketCapacity, out var c) ? c : null;
        var result = await Events.SaveTicketAsync(Id, editingTicket?.Id, ticketName ?? "", price, seats, ticketPublic);
        if (!result.IsSuccess)
        {
            dialogError = result.Error!.Message;
            return;
        }

        ticketOpen = false;
        await LoadAsync();
    }

    private async Task DeleteTicketAsync(Guid ticketId) => await Done(await Events.DeleteTicketAsync(ticketId));

    private void OpenRegister()
    {
        (registerContact, registerNote, dialogError) = (null, null, null);
        registerTicket = item!.Tickets.FirstOrDefault()?.Id.ToString();
        registerOpen = true;
    }

    private async Task RegisterAsync()
    {
        if (registerContact is null)
        {
            dialogError = "Kişi seçin.";
            return;
        }

        var result = await Events.RegisterAsync(Id, registerContact.Id, Guid.TryParse(registerTicket, out var t) ? t : null, "staff", registerNote);
        if (!result.IsSuccess)
        {
            dialogError = result.Error!.Message;
            return;
        }

        registerOpen = false;
        await LoadAsync();
    }

    private async Task MarkPaidAsync(Guid registrationId, bool paid) => await Done(await Events.MarkPaidAsync(registrationId, paid));

    private async Task CheckInAsync(string code)
    {
        var result = await Events.CheckInAsync(Id, code);
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }

    private async Task UndoCheckInAsync(Guid registrationId) => await Done(await Events.UndoCheckInAsync(registrationId));

    private async Task CancelRegistrationAsync(Guid registrationId) => await Done(await Events.CancelRegistrationAsync(registrationId));

    private async Task Done(Arma.SharedKernel.Domain.Result<Guid> result)
    {
        error = result.IsSuccess ? null : result.Error!.Message;
        await LoadAsync();
    }
}
