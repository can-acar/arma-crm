@page "/events/new"
@page "/events/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = EventsPermissions.Write)]
@inject EventService Events
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Yeni etkinlik" : "Etkinliği düzenle") · Arma CRM</PageTitle>

<div class="flex max-w-3xl flex-col gap-6">
    <div>
        <a class="text-muted-foreground text-sm hover:underline" href="@(Id is null ? "events" : $"events/{Id}")">@(Id is null ? "Etkinlikler" : title)</a>
        <h1 class="text-2xl font-semibold tracking-tight">@(Id is null ? "Yeni etkinlik" : "Etkinliği düzenle")</h1>
    </div>

    <FormAlert Error="@error" />

    <Card>
        <CardContent>
            <form id="event-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div class="grid gap-4 sm:grid-cols-[2fr_1fr]">
                    <div class="grid gap-2">
                        <Label for="ev-title">Ad</Label>
                        <Input id="ev-title" @bind-Value="title" maxlength="200" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="ev-slug">Adres (/e/...)</Label>
                        <Input id="ev-slug" @bind-Value="slug" maxlength="80" placeholder="bahar-semineri" />
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="grid gap-2">
                        <Label for="ev-start">Başlangıç</Label>
                        <input id="ev-start" type="datetime-local" class="@Styles.Input" @bind="startsAt" @bind:format="yyyy-MM-ddTHH:mm" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="ev-end">Bitiş</Label>
                        <input id="ev-end" type="datetime-local" class="@Styles.Input" @bind="endsAt" @bind:format="yyyy-MM-ddTHH:mm" />
                    </div>
                </div>
                <div class="grid gap-2">
                    <Label for="ev-location">Yer</Label>
                    <Input id="ev-location" @bind-Value="location" maxlength="300" placeholder="Kültür Merkezi, Salon A veya çevrim içi bağlantı" />
                </div>
                <div class="grid gap-2">
                    <Label for="ev-description">Açıklama</Label>
                    <Textarea id="ev-description" @bind-Value="description" rows="5" maxlength="5000" />
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="grid gap-2">
                        <Label for="ev-capacity">Kontenjan</Label>
                        <Input id="ev-capacity" Type="number" min="1" @bind-Value="capacity" placeholder="Sınırsız" />
                        <p class="text-muted-foreground text-xs">Dolunca yeni kayıtlar yedek listeye alınır.</p>
                    </div>
                    <div class="grid gap-2">
                        <Label for="ev-closes">Web kaydı kapanış</Label>
                        <input id="ev-closes" type="datetime-local" class="@Styles.Input" @bind="closesAt" @bind:format="yyyy-MM-ddTHH:mm" />
                        <p class="text-muted-foreground text-xs">Boşsa etkinlik başlayana kadar açık.</p>
                    </div>
                </div>
                <div class="grid gap-2">
                    <Label for="ev-note">Onay e-postasına eklenecek not</Label>
                    <Textarea id="ev-note" @bind-Value="note" rows="2" maxlength="1000" placeholder="Girişte kimlik gösterilecektir." />
                </div>
                <div class="flex gap-2">
                    <Button Type="submit">Kaydet</Button>
                    <Button Variant="ButtonVariant.Ghost" Href="@(Id is null ? "events" : $"events/{Id}")">Vazgeç</Button>
                </div>
            </form>
        </CardContent>
    </Card>
</div>

@code {
    private string? title, slug, location, description, note, capacity, error;
    private DateTime startsAt, endsAt;
    private DateTime? closesAt;

    [Parameter] public Guid? Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id && await Events.GetAsync(id) is { } item)
        {
            (title, slug, location, description, note) = (item.Title, item.Slug, item.Location, item.Description, item.ConfirmationNote);
            (startsAt, endsAt, closesAt) = (item.StartsAt.LocalDateTime, item.EndsAt.LocalDateTime, item.RegistrationClosesAt?.LocalDateTime);
            capacity = item.Capacity?.ToString();
        }
        else
        {
            startsAt = DateTime.Today.AddDays(14).AddHours(14);
            endsAt = startsAt.AddHours(2);
        }
    }

    private async Task SaveAsync()
    {
        int? seats = null;
        if (!string.IsNullOrWhiteSpace(capacity))
        {
            if (!int.TryParse(capacity, out var value))
            {
                error = "Kontenjan sayı olmalı.";
                return;
            }

            seats = value;
        }

        var details = new EventDetails(title ?? "", slug ?? "", description, location, Local(startsAt), Local(endsAt), seats, closesAt is { } c ? Local(c) : null, note);
        var result = await Events.SaveAsync(Id, details);
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        Navigation.NavigateTo($"events/{result.Value}");
    }

    private static DateTimeOffset Local(DateTime value) => new(DateTime.SpecifyKind(value, DateTimeKind.Local));
}
