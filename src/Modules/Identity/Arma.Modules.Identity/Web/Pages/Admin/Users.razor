@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = IdentityPermissions.ManageUsers)]
@inject UserAdminService Service
@inject RoleAdminService RoleService
@inject ICurrentUser CurrentUser

<PageTitle>Kullanıcılar · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Kullanıcılar</h1>
            <p class="text-muted-foreground text-sm">Arma CRM'e giriş yapabilen kişiler</p>
        </div>
        <Button OnClick="() => showCreate = !showCreate">@(showCreate ? "Vazgeç" : "Yeni kullanıcı")</Button>
    </div>

    <FormAlert Error="@error" Info="@info" />

    @if (showCreate)
    {
        <Card>
            <CardHeader>
                <CardTitle>Yeni kullanıcı</CardTitle>
                <CardDescription>Geçici parolayı kullanıcıya güvenli bir yoldan iletin; ilk girişte değiştirmesini isteyin.</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="grid gap-4 sm:grid-cols-2" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <div class="grid gap-2">
                        <Label For="name">Ad soyad</Label>
                        <Input id="name" @bind-Value="newName" required />
                    </div>
                    <div class="grid gap-2">
                        <Label For="email">E-posta</Label>
                        <Input id="email" Type="email" @bind-Value="newEmail" required />
                    </div>
                    <div class="grid gap-2">
                        <Label For="password">Geçici parola</Label>
                        <Input id="password" Type="text" @bind-Value="newPassword" required />
                    </div>
                    <div class="grid gap-2">
                        <Label For="role">Rol</Label>
                        <NativeSelect id="role" @bind-Value="newRole">
                            @foreach (var role in roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </NativeSelect>
                    </div>
                    <div class="sm:col-span-2"><Button Type="submit">Oluştur</Button></div>
                </form>
            </CardContent>
        </Card>
    }

    <Card>
        <CardContent>
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Ad soyad</TableHead>
                        <TableHead>Rol</TableHead>
                        <TableHead>Durum</TableHead>
                        <TableHead>Son giriş</TableHead>
                        <TableHead><span class="sr-only">İşlemler</span></TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var user in users)
                    {
                        <TableRow>
                            <TableCell>
                                <div class="font-medium">@user.FullName</div>
                                <div class="text-muted-foreground text-xs">@user.Email</div>
                            </TableCell>
                            <TableCell>
                                <NativeSelect Class="h-8 w-40" Value="@user.Role" ValueChanged="role => ChangeRoleAsync(user, role)" aria-label="Rol">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </NativeSelect>
                            </TableCell>
                            <TableCell>
                                <div class="flex flex-wrap gap-1">
                                    @if (!user.IsActive)
                                    {
                                        <Badge Variant="BadgeVariant.Secondary">Pasif</Badge>
                                    }
                                    else if (user.IsLockedOut)
                                    {
                                        <Badge Variant="BadgeVariant.Destructive">Kilitli</Badge>
                                    }
                                    else
                                    {
                                        <Badge Variant="BadgeVariant.Outline">Aktif</Badge>
                                    }
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <Badge Variant="BadgeVariant.Outline">2FA</Badge>
                                    }
                                </div>
                            </TableCell>
                            <TableCell class="text-muted-foreground text-sm">@(user.LastLoginAt?.ToLocalTime().ToString("g") ?? "Hiç")</TableCell>
                            <TableCell>
                                <div class="flex justify-end gap-1">
                                    @if (user.IsLockedOut)
                                    {
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => UnlockAsync(user)">Kilidi aç</Button>
                                    }
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ResetTwoFactorAsync(user)">2FA sıfırla</Button>
                                    }
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ToggleActiveAsync(user)">
                                        @(user.IsActive ? "Pasifleştir" : "Etkinleştir")
                                    </Button>
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<UserListItem> users = [];
    private IReadOnlyList<string> roles = [];
    private bool showCreate;
    private string? newName, newEmail, newPassword, newRole;
    private string? error, info;

    protected override async Task OnInitializedAsync()
    {
        roles = await RoleService.NamesAsync();
        newRole = roles.FirstOrDefault(r => r == SystemRoles.Staff) ?? roles.FirstOrDefault();
        await LoadAsync();
    }

    private async Task LoadAsync() => users = await Service.ListAsync();

    private async Task CreateAsync()
    {
        var result = await Service.CreateAsync(new CreateUserRequest(newName ?? "", newEmail ?? "", newPassword ?? "", newRole ?? ""));
        if (!result.IsSuccess)
        {
            (error, info) = (result.Error!.Message, null);
            return;
        }

        (error, info) = (null, $"{newName} eklendi.");
        (newName, newEmail, newPassword, showCreate) = (null, null, null, false);
        await LoadAsync();
    }

    private Task ChangeRoleAsync(UserListItem user, string? role) =>
        RunAsync(Service.ChangeRoleAsync(user.Id, role ?? "", CurrentUser.Id), $"{user.FullName} artık {role} rolünde.");

    private Task UnlockAsync(UserListItem user) =>
        RunAsync(Service.UnlockAsync(user.Id), $"{user.FullName} için kilit açıldı.");

    private Task ResetTwoFactorAsync(UserListItem user) =>
        RunAsync(Service.ResetTwoFactorAsync(user.Id), $"{user.FullName} için 2FA sıfırlandı; bir sonraki girişte yeniden kuracak.");

    private Task ToggleActiveAsync(UserListItem user) =>
        RunAsync(Service.SetActiveAsync(user.Id, !user.IsActive, CurrentUser.Id),
            user.IsActive ? $"{user.FullName} pasifleştirildi." : $"{user.FullName} etkinleştirildi.");

    private async Task RunAsync(Task<Arma.SharedKernel.Domain.Result<bool>> action, string success)
    {
        var result = await action;
        (error, info) = result.IsSuccess ? ((string?)null, success) : (result.Error!.Message, (string?)null);
        await LoadAsync();
    }
}
