@page "/admin/api-clients"
@rendermode InteractiveServer
@attribute [Authorize(Policy = IdentityPermissions.ManageApiClients)]
@inject ApiClientService Service
@inject PermissionCatalog Catalog

<PageTitle>API istemcileri · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">API istemcileri</h1>
            <p class="text-muted-foreground text-sm">Web sitesi, muhasebe yazılımı gibi sistemlerin Arma CRM API'sine erişimi</p>
        </div>
        <Button OnClick="() => showCreate = !showCreate">@(showCreate ? "Vazgeç" : "Yeni istemci")</Button>
    </div>

    <FormAlert Error="@error" />

    @if (created is not null)
    {
        <Alert>
            <AlertTitle>İstemci oluşturuldu. Gizli anahtarı şimdi kopyalayın; bir daha gösterilmeyecek.</AlertTitle>
            <AlertDescription>
                <div class="mt-2 grid gap-1 font-mono text-xs">
                    <span>client_id: @created.ClientId</span>
                    <span class="break-all">client_secret: @created.ClientSecret</span>
                </div>
                <p class="mt-2 text-xs">Belirteç almak için: <code>POST /connect/token</code>, <code>grant_type=client_credentials</code></p>
            </AlertDescription>
        </Alert>
    }

    @if (showCreate)
    {
        <Card>
            <CardHeader><CardTitle>Yeni istemci</CardTitle></CardHeader>
            <CardContent>
                <form class="grid gap-4" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <div class="grid gap-2">
                        <Label For="name">Ad</Label>
                        <Input id="name" @bind-Value="newName" placeholder="Örneğin Kurum web sitesi" required />
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        @foreach (var permission in Catalog.All.OrderBy(p => p.Name))
                        {
                            <label class="flex items-start gap-2 text-sm">
                                <Checkbox Class="mt-0.5" Checked="selectedPermissions.Contains(permission.Name)" CheckedChanged="on => Toggle(permission.Name, on)" />
                                <span>@permission.Description <code class="text-muted-foreground text-xs">@permission.Name</code></span>
                            </label>
                        }
                    </div>
                    <div><Button Type="submit">Oluştur</Button></div>
                </form>
            </CardContent>
        </Card>
    }

    <Card>
        <CardContent>
            @if (clients.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz API istemcisi yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Ad</TableHead>
                            <TableHead>client_id</TableHead>
                            <TableHead>İzinler</TableHead>
                            <TableHead><span class="sr-only">İşlemler</span></TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var client in clients)
                        {
                            <TableRow>
                                <TableCell class="font-medium">@client.DisplayName</TableCell>
                                <TableCell class="font-mono text-xs">@client.ClientId</TableCell>
                                <TableCell>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var permission in client.Permissions)
                                        {
                                            <Badge Variant="BadgeVariant.Secondary">@permission</Badge>
                                        }
                                    </div>
                                </TableCell>
                                <TableCell class="text-right">
                                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => DeleteAsync(client.ClientId)">Sil</Button>
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<ApiClientListItem> clients = [];
    private readonly HashSet<string> selectedPermissions = [];
    private CreatedApiClient? created;
    private bool showCreate;
    private string? newName;
    private string? error;

    protected override async Task OnInitializedAsync() => clients = await Service.ListAsync();

    private void Toggle(string permission, bool on)
    {
        if (on)
        {
            selectedPermissions.Add(permission);
        }
        else
        {
            selectedPermissions.Remove(permission);
        }
    }

    private async Task CreateAsync()
    {
        var result = await Service.CreateAsync(newName ?? "", selectedPermissions);
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        (created, error, newName, showCreate) = (result.Value, null, null, false);
        selectedPermissions.Clear();
        clients = await Service.ListAsync();
    }

    private async Task DeleteAsync(string clientId)
    {
        await Service.DeleteAsync(clientId);
        created = null;
        clients = await Service.ListAsync();
    }
}
