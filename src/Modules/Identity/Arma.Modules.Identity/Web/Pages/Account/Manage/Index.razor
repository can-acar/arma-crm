@page "/account/manage"
@inject UserManager<ArmaUser> Users
@inject SignInManager<ArmaUser> SignIn

<PageTitle>Hesabım · Arma CRM</PageTitle>

<div class="mx-auto flex max-w-2xl flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Hesabım</h1>
        <p class="text-muted-foreground text-sm">@user?.Email</p>
    </div>

    <Card>
        <CardHeader>
            <CardTitle>Profil</CardTitle>
        </CardHeader>
        <CardContent>
            <EditForm Model="Profile" FormName="profile" OnValidSubmit="SaveProfileAsync" method="post" class="grid gap-4">
                <DataAnnotationsValidator />
                <FormMessage Info="@profileMessage" />
                <div class="grid gap-2">
                    <Label For="name">Ad soyad</Label>
                    <InputText id="name" @bind-Value="Profile.FullName" class="@Styles.Input" required />
                </div>
                <div><Button Type="submit">Kaydet</Button></div>
            </EditForm>
        </CardContent>
    </Card>

    <Card>
        <CardHeader>
            <CardTitle>Parola değiştir</CardTitle>
        </CardHeader>
        <CardContent>
            <EditForm Model="Password" FormName="password" OnValidSubmit="ChangePasswordAsync" method="post" class="grid gap-4">
                <DataAnnotationsValidator />
                <FormMessage Error="@passwordError" Info="@passwordMessage" />
                <div class="grid gap-2">
                    <Label For="current">Mevcut parola</Label>
                    <InputText id="current" type="password" autocomplete="current-password" @bind-Value="Password.Current" class="@Styles.Input" required />
                </div>
                <div class="grid gap-2">
                    <Label For="new">Yeni parola</Label>
                    <InputText id="new" type="password" autocomplete="new-password" @bind-Value="Password.New" class="@Styles.Input" required />
                </div>
                <div class="grid gap-2">
                    <Label For="confirm">Yeni parola (tekrar)</Label>
                    <InputText id="confirm" type="password" autocomplete="new-password" @bind-Value="Password.Confirm" class="@Styles.Input" required />
                    <ValidationMessage For="() => Password.Confirm" class="text-destructive text-sm" />
                </div>
                <div><Button Type="submit">Parolayı değiştir</Button></div>
            </EditForm>
        </CardContent>
    </Card>

    <Card>
        <CardHeader>
            <CardTitle>İki adımlı doğrulama</CardTitle>
            <CardDescription>@(user?.TwoFactorEnabled == true ? "Açık" : "Kapalı")</CardDescription>
            <CardAction><Button Href="account/manage/2fa" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Yönet</Button></CardAction>
        </CardHeader>
    </Card>
</div>

@code {
    protected override void OnInitialized()
    {
        Profile ??= new();
        Password ??= new();
    }

    private ArmaUser? user;
    private string? profileMessage;
    private string? passwordError;
    private string? passwordMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")] private ProfileModel Profile { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "password")] private PasswordModel Password { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await Users.GetUserAsync(HttpContext.User);
        if (user is not null && string.IsNullOrEmpty(Profile.FullName))
        {
            Profile.FullName = user.FullName;
        }
    }

    private async Task SaveProfileAsync()
    {
        user!.FullName = Profile.FullName.Trim();
        await Users.UpdateAsync(user);
        await SignIn.RefreshSignInAsync(user);
        profileMessage = "Profil kaydedildi.";
    }

    private async Task ChangePasswordAsync()
    {
        var result = await Users.ChangePasswordAsync(user!, Password.Current, Password.New);
        if (!result.Succeeded)
        {
            passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignIn.RefreshSignInAsync(user!);
        passwordMessage = "Parola değiştirildi. Diğer cihazlardaki oturumlar kapanacak.";
    }

    private sealed class ProfileModel
    {
        [Required(ErrorMessage = "Ad soyad gerekli.")]
        public string FullName { get; set; } = "";
    }

    private sealed class PasswordModel
    {
        [Required] public string Current { get; set; } = "";

        [Required] public string New { get; set; } = "";

        [Compare(nameof(New), ErrorMessage = "Parolalar aynı değil.")]
        public string Confirm { get; set; } = "";
    }
}
