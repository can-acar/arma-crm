@page "/account/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SignInManager<ArmaUser> SignIn
@inject UserManager<ArmaUser> Users
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>Giriş · Arma CRM</PageTitle>

<Card>
    <CardHeader>
        <CardTitle><h1 class="text-xl">Giriş yap</h1></CardTitle>
        <CardDescription>E-posta adresiniz ve parolanızla oturum açın</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post" class="grid gap-4">
            <DataAnnotationsValidator />
            <FormMessage Error="@error" />
            <div class="grid gap-2">
                <Label For="email">E-posta</Label>
                <InputText id="email" type="email" autocomplete="username" @bind-Value="Input.Email" class="@Styles.Input" required />
                <ValidationMessage For="() => Input.Email" class="text-destructive text-sm" />
            </div>
            <div class="grid gap-2">
                <Label For="password">Parola</Label>
                <InputText id="password" type="password" autocomplete="current-password" @bind-Value="Input.Password" class="@Styles.Input" required />
            </div>
            <label class="flex items-center gap-2 text-sm">
                <InputCheckbox @bind-Value="Input.RememberMe" class="@Styles.Checkbox" /> Beni hatırla
            </label>
            <Button Type="submit" Class="w-full">Giriş yap</Button>
        </EditForm>
    </CardContent>
</Card>

@code {
    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private string? error;

    [SupplyParameterFromForm] private LoginModel Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task LoginAsync()
    {
        var user = await Users.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            error = "E-posta veya parola hatalı.";
            return;
        }

        var result = await SignIn.PasswordSignInAsync(user, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            user.LastLoginAt = Clock.GetUtcNow();
            await Users.UpdateAsync(user);
            Navigation.NavigateTo(SafeReturnUrl(ReturnUrl), forceLoad: true);
        }
        else if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo($"account/login-2fa?rememberMe={Input.RememberMe}&returnUrl={Uri.EscapeDataString(SafeReturnUrl(ReturnUrl))}");
        }
        else if (result.IsLockedOut)
        {
            error = "Çok fazla hatalı deneme nedeniyle hesap geçici olarak kilitlendi. 15 dakika sonra tekrar deneyin.";
        }
        else if (result.IsNotAllowed)
        {
            error = "Bu hesap pasif. Yöneticinize başvurun.";
        }
        else
        {
            error = "E-posta veya parola hatalı.";
        }
    }

    internal static string SafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") ? url : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "E-posta gerekli.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta girin.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Parola gerekli.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
