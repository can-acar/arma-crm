@page "/account/login-2fa"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SignInManager<ArmaUser> SignIn
@inject UserManager<ArmaUser> Users
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>İki adımlı doğrulama · Arma CRM</PageTitle>

<Card>
    <CardHeader>
        <CardTitle><h1 class="text-xl">İki adımlı doğrulama</h1></CardTitle>
        <CardDescription>Doğrulama uygulamanızdaki 6 haneli kodu girin</CardDescription>
    </CardHeader>
    <CardContent>
        <EditForm Model="Input" FormName="login-2fa" OnValidSubmit="VerifyAsync" method="post" class="grid gap-4">
            <DataAnnotationsValidator />
            <FormMessage Error="@error" />
            <div class="grid gap-2">
                <Label For="code">Doğrulama kodu</Label>
                <InputText id="code" autocomplete="one-time-code" inputmode="numeric" @bind-Value="Input.Code" class="@Styles.Input" required />
                <ValidationMessage For="() => Input.Code" class="text-destructive text-sm" />
            </div>
            <label class="flex items-center gap-2 text-sm">
                <InputCheckbox @bind-Value="Input.RememberMachine" class="@Styles.Checkbox" /> Bu cihazı 30 gün hatırla
            </label>
            <Button Type="submit" Class="w-full">Doğrula</Button>
            <p class="text-muted-foreground text-center text-sm">
                Telefonunuza erişemiyor musunuz?
                <a class="underline underline-offset-4" href="account/login-recovery?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">Kurtarma koduyla girin</a>
            </p>
        </EditForm>
    </CardContent>
</Card>

@code {
    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private string? error;

    [SupplyParameterFromForm] private TwoFactorModel Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await SignIn.GetTwoFactorAuthenticationUserAsync() is null)
        {
            Navigation.NavigateTo("account/login");
        }
    }

    private async Task VerifyAsync()
    {
        var user = await SignIn.GetTwoFactorAuthenticationUserAsync();
        if (user is null)
        {
            Navigation.NavigateTo("account/login");
            return;
        }

        var code = Input.Code.Replace(" ", "").Replace("-", "");
        var result = await SignIn.TwoFactorAuthenticatorSignInAsync(code, RememberMe, Input.RememberMachine);
        if (result.Succeeded)
        {
            user.LastLoginAt = Clock.GetUtcNow();
            await Users.UpdateAsync(user);
            Navigation.NavigateTo(Login.SafeReturnUrl(ReturnUrl), forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            error = "Çok fazla hatalı deneme nedeniyle hesap geçici olarak kilitlendi.";
        }
        else
        {
            error = "Kod geçersiz.";
        }
    }

    private sealed class TwoFactorModel
    {
        [Required(ErrorMessage = "Kod gerekli.")]
        [StringLength(7, MinimumLength = 6, ErrorMessage = "Kod 6 haneli olmalı.")]
        public string Code { get; set; } = "";

        public bool RememberMachine { get; set; }
    }
}
