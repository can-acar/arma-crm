@page "/abonelik/iptal"
@page "/abonelik/iptal/tamam"
@layout PublicLayout
@attribute [AllowAnonymous]
@inject ConsentService Consents
@inject NavigationManager Navigation

<PageTitle>Abonelik iptali</PageTitle>

<div class="mx-auto max-w-lg p-6">
    <Card>
        <CardHeader>
            <CardTitle><h1 class="text-xl">@title</h1></CardTitle>
            <CardDescription>@message</CardDescription>
        </CardHeader>
        @if (target is not null)
        {
            <CardContent>
                @* Bağlantı önizleyen e-posta istemcileri iptali tetiklemesin diye iptal bir düğmeyle onaylanır. *@
                <form method="post" action="api/v1/unsubscribe?t=@Uri.EscapeDataString(T!)">
                    <Button Type="submit">Aboneliğimi iptal et</Button>
                </form>
            </CardContent>
        }
    </Card>
</div>

@code {
    private string title = "", message = "";
    private (Guid ContactId, Channel Channel)? target;

    [SupplyParameterFromQuery] public string? T { get; set; }

    [SupplyParameterFromQuery] public string? Hata { get; set; }

    protected override void OnInitialized()
    {
        if (Navigation.Uri.Contains("/abonelik/iptal/tamam", StringComparison.Ordinal))
        {
            (title, message) = ("Aboneliğiniz iptal edildi", "Size bu kanaldan artık tanıtım ve duyuru iletisi gönderilmeyecek. Bilgilendirme iletileri (makbuz gibi) gelmeye devam edebilir.");
            return;
        }

        target = Hata is null ? Consents.ReadUnsubscribeToken(T) : null;
        (title, message) = target is { } t
            ? ("Abonelik iptali", $"{(t.Channel == Channel.Sms ? "SMS" : "E-posta")} ile gönderilen tanıtım ve duyuru iletilerini artık almak istemiyorsanız onaylayın.")
            : ("Bağlantı geçersiz", "İptal bağlantısı geçersiz veya eksik. İletideki bağlantıyı yeniden açmayı deneyin ya da kurumla iletişime geçin.");
    }
}
