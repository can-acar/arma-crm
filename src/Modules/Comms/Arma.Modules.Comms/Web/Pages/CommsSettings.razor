@page "/admin/comms"
@rendermode InteractiveServer
@attribute [Authorize(Policy = CommsPermissions.Settings)]
@inject MessageService Messages
@inject ConsentService Consents
@inject Microsoft.Extensions.Options.IOptions<CommsOptions> Options

<PageTitle>E-posta ve SMS · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">E-posta ve SMS</h1>
        <p class="text-muted-foreground text-sm">Bağlantı bilgileri güvenlik için ekrandan değil, kurulumdaki <code>.env</code> dosyasından verilir. Burada durum görülür ve deneme gönderimi yapılır.</p>
    </div>

    @if (string.IsNullOrWhiteSpace(settings.PublicUrl))
    {
        <Alert Variant="AlertVariant.Destructive">
            <AlertDescription>Dış adres (<code>ARMA_PUBLIC_URL</code>) tanımlı değil. Ticari e-postalara abonelik iptal bağlantısı eklenemez; kanun gereği bu bağlantı zorunludur.</AlertDescription>
        </Alert>
    }

    <div class="grid gap-6 lg:grid-cols-3">
        <Card>
            <CardHeader>
                <CardTitle>E-posta</CardTitle>
                <CardDescription>@Describe(emailProvider) @(emailProvider == "smtp" ? $"· {settings.Email.Host}:{settings.Email.Port} · {settings.Email.FromAddress}" : "")</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="grid gap-2" @onsubmit="TestEmailAsync" @onsubmit:preventDefault>
                    <Label for="test-email">Deneme e-postası gönder</Label>
                    <div class="flex gap-2">
                        <Input id="test-email" type="email" @bind-Value="testEmail" placeholder="ad@kurum.org" />
                        <Button Type="submit" Variant="ButtonVariant.Outline">Gönder</Button>
                    </div>
                    <SendOutcome Value="emailResult" />
                </form>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardTitle>SMS</CardTitle>
                <CardDescription>@Describe(smsProvider) @(smsProvider == "netgsm" ? $"· başlık {settings.Sms.Header}" : "")</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="grid gap-2" @onsubmit="TestSmsAsync" @onsubmit:preventDefault>
                    <Label for="test-sms">Deneme SMS'i gönder</Label>
                    <div class="flex gap-2">
                        <Input id="test-sms" type="tel" @bind-Value="testPhone" placeholder="05XX XXX XX XX" />
                        <Button Type="submit" Variant="ButtonVariant.Outline">Gönder</Button>
                    </div>
                    <SendOutcome Value="smsResult" />
                </form>
            </CardContent>
        </Card>

        <Card>
            <CardHeader>
                <CardTitle>İleti Yönetim Sistemi (İYS)</CardTitle>
                <CardDescription>@(settings.Iys.Enabled ? $"Açık · İYS no {settings.Iys.IysCode}, marka {settings.Iys.BrandCode}" : "Kapalı: izin değişiklikleri İYS'ye bildirilmez")</CardDescription>
            </CardHeader>
            @if (settings.Iys.Enabled)
            {
                <CardContent Class="grid gap-2">
                    <div><Button Variant="ButtonVariant.Outline" OnClick="RetryAsync">Başarısız bildirimleri yeniden dene</Button></div>
                    @if (retried is not null)
                    {
                        <p class="text-muted-foreground text-sm">@retried kayıt yeniden denendi.</p>
                    }
                </CardContent>
            }
        </Card>
    </div>
</div>

@code {
    private CommsOptions settings = new();
    private string emailProvider = "", smsProvider = "";
    private string? testEmail, testPhone;
    private SendResult? emailResult, smsResult;
    private int? retried;

    protected override void OnInitialized()
    {
        settings = Options.Value;
        emailProvider = settings.Email.Provider.Trim().ToLowerInvariant();
        smsProvider = settings.Sms.Provider.Trim().ToLowerInvariant();
    }

    private async Task TestEmailAsync() =>
        emailResult = string.IsNullOrWhiteSpace(testEmail) ? SendResult.Fail("E-posta adresi girin.") : await Messages.SendTestEmailAsync(testEmail);

    private async Task TestSmsAsync() => smsResult = await Messages.SendTestSmsAsync(testPhone ?? "");

    private async Task RetryAsync() => retried = await Consents.RetryIysAsync();

    private static string Describe(string provider) => provider switch
    {
        "smtp" => "SMTP",
        "netgsm" => "Netgsm",
        "test" => "Test (gerçek gönderim yok)",
        _ => "Kapalı",
    };
}
