@page "/comms/mailings/new"
@page "/comms/mailings/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = CommsPermissions.Mailings)]
@implements IDisposable
@inject MailingService Mailings
@inject IContactAudiences Audiences
@inject NavigationManager Navigation

<PageTitle>@(mailing?.Name ?? "Yeni ileti") · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <a class="text-muted-foreground text-sm hover:underline" href="comms/mailings">Toplu ileti</a>
            <h1 class="text-2xl font-semibold tracking-tight">@(mailing?.Name ?? "Yeni ileti")</h1>
        </div>
        @if (mailing is not null)
        {
            <Badge Variant="BadgeVariant.Secondary">@CommsLabels.Mailing(mailing.Status)</Badge>
        }
    </div>

    <FormAlert Error="@error" />

    @if (editable)
    {
        <div class="grid gap-6 lg:grid-cols-3">
            <Card Class="lg:col-span-2">
                <CardContent>
                    <form id="mailing-form" class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <div class="grid gap-2">
                            <Label for="m-name">Ad (yalnızca listede görünür)</Label>
                            <Input id="m-name" @bind-Value="name" maxlength="200" />
                        </div>
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div class="grid gap-2">
                                <Label for="m-channel">Kanal</Label>
                                <NativeSelect id="m-channel" Value="@((int)channel + "")" ValueChanged="ChangeChannelAsync">
                                    <option value="1">E-posta</option>
                                    <option value="2">SMS</option>
                                </NativeSelect>
                            </div>
                            <div class="grid gap-2">
                                <Label for="m-group">Grup</Label>
                                <NativeSelect id="m-group" Value="@groupId" ValueChanged="v => ChangeAudienceAsync(v, tagId)">
                                    <option value="">Tüm kişiler</option>
                                    @foreach (var group in groups)
                                    {
                                        <option value="@group.Id">@group.Name (@group.Count)</option>
                                    }
                                </NativeSelect>
                            </div>
                            <div class="grid gap-2">
                                <Label for="m-tag">Etiket</Label>
                                <NativeSelect id="m-tag" Value="@tagId" ValueChanged="v => ChangeAudienceAsync(groupId, v)">
                                    <option value="">Etiket seçme</option>
                                    @foreach (var tag in tags)
                                    {
                                        <option value="@tag.Id">@tag.Name (@tag.Count)</option>
                                    }
                                </NativeSelect>
                            </div>
                        </div>
                        @if (templates.Count > 0)
                        {
                            <div class="grid gap-2">
                                <Label for="m-template">Şablon</Label>
                                <NativeSelect id="m-template" Value="@templateId" ValueChanged="UseTemplate">
                                    <option value="">Şablon kullanma</option>
                                    @foreach (var template in templates)
                                    {
                                        <option value="@template.Id">@template.Name</option>
                                    }
                                </NativeSelect>
                            </div>
                        }
                        @if (channel == Channel.Email)
                        {
                            <div class="grid gap-2">
                                <Label for="m-subject">Konu</Label>
                                <Input id="m-subject" @bind-Value="subject" maxlength="300" />
                            </div>
                        }
                        <div class="grid gap-2">
                            <Label for="m-body">Metin</Label>
                            <Textarea id="m-body" @bind-Value="body" rows="10" maxlength="@(channel == Channel.Email ? 20000 : 900)" />
                            <span class="text-muted-foreground text-xs">Kullanılabilir alanlar: @string.Join(", ", MessageText.Fields.Select(f => $"{f.Field} ({f.Description})"))</span>
                        </div>
                        <label class="flex items-center gap-2 text-sm"><Checkbox Checked="commercial" CheckedChanged="ChangeCommercialAsync" /> Ticari ileti: yalnızca izni onaylı kişilere gider, iptal bağlantısı eklenir</label>
                    </form>
                </CardContent>
                <CardFooter Class="flex gap-2">
                    <Button Type="submit" form="mailing-form" Variant="ButtonVariant.Outline">Taslağı kaydet</Button>
                    @if (mailing is not null)
                    {
                        <Button OnClick="() => confirmOpen = true" Disabled="preview?.Reachable is null or 0">Gönder</Button>
                    }
                </CardFooter>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>Alıcılar</CardTitle>
                    <CardDescription>Gönderim anındaki duruma göre yeniden hesaplanır.</CardDescription>
                </CardHeader>
                <CardContent>
                    @if (preview is not null)
                    {
                        <dl class="grid grid-cols-[1fr_auto] gap-2 text-sm">
                            <dt>Hedef kitle</dt><dd class="tabular-nums">@preview.Total</dd>
                            <dt>Adresi olmayan</dt><dd class="tabular-nums">@preview.NoAddress</dd>
                            @if (commercial)
                            {
                                <dt>İzni olmayan</dt><dd class="tabular-nums">@preview.NoConsent</dd>
                            }
                            <dt class="font-medium">Gönderilecek</dt><dd class="font-medium tabular-nums">@preview.Reachable</dd>
                        </dl>
                    }
                </CardContent>
            </Card>
        </div>
    }
    else if (mailing is not null)
    {
        <div class="grid gap-4 sm:grid-cols-4">
            <Stat Label="Kuyrukta" Value="mailing.Pending" />
            <Stat Label="Gönderildi" Value="mailing.Sent" />
            <Stat Label="Başarısız" Value="mailing.Failed" />
            <Stat Label="Gönderilmedi" Value="mailing.Skipped" />
        </div>

        <Card>
            <CardHeader>
                <CardTitle>@(mailing.Subject ?? "SMS metni")</CardTitle>
                <CardDescription>@CommsLabels.Channel(mailing.Channel)@(mailing.IsCommercial ? " · ticari" : "") · @(mailing.StartedAt is { } s ? CommsLabels.DateTime(s) : "")</CardDescription>
            </CardHeader>
            <CardContent><p class="text-sm whitespace-pre-wrap">@mailing.Body</p></CardContent>
        </Card>

        <Card>
            <CardHeader><CardTitle>Alıcılar</CardTitle></CardHeader>
            <CardContent>
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Adres</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead>Not</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var recipient in recipients)
                        {
                            <TableRow>
                                <TableCell><a class="hover:underline" href="contacts/@recipient.ContactId">@(recipient.To ?? "(adres yok)")</a></TableCell>
                                <TableCell><Badge Variant="CommsLabels.StatusVariant(recipient.Status)">@CommsLabels.Status(recipient.Status)</Badge></TableCell>
                                <TableCell Class="text-muted-foreground text-xs">@recipient.Error</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </CardContent>
        </Card>
    }
</div>

<Dialog @bind-Open="confirmOpen">
    <DialogHeader>
        <DialogTitle>İleti gönderilsin mi?</DialogTitle>
        <DialogDescription>@preview?.Reachable kişiye @CommsLabels.Channel(channel).ToLowerInvariant() gönderilecek. Gönderim başladıktan sonra durdurulamaz.</DialogDescription>
    </DialogHeader>
    <DialogFooter>
        <Button Variant="ButtonVariant.Outline" OnClick="() => confirmOpen = false">Vazgeç</Button>
        <Button OnClick="StartAsync">Gönder</Button>
    </DialogFooter>
</Dialog>

@code {
    private MailingView? mailing;
    private IReadOnlyList<MessageView> recipients = [];
    private IReadOnlyList<AudienceList> groups = [], tags = [];
    private IReadOnlyList<TemplateView> templates = [];
    private AudiencePreview? preview;
    private Channel channel = Channel.Email;
    private string? name, subject, body, groupId, tagId, templateId, error;
    private bool commercial, confirmOpen, editable = true;
    private Timer? refresh;

    [Parameter] public Guid? Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        groups = await Audiences.GroupsAsync();
        tags = await Audiences.TagsAsync();
        if (Id is { } id)
        {
            mailing = await Mailings.GetAsync(id);
            if (mailing is null)
            {
                error = "İleti bulunamadı.";
                editable = false;
                return;
            }

            (name, channel, subject, body, commercial) = (mailing.Name, mailing.Channel, mailing.Subject, mailing.Body, mailing.IsCommercial);
            (groupId, tagId) = (mailing.GroupId?.ToString(), mailing.TagId?.ToString());
            editable = mailing.Status == MailingStatus.Draft;
            if (!editable)
            {
                await LoadProgressAsync();
                return;
            }
        }

        templates = await Mailings.TemplatesAsync(channel);
        await PreviewAsync();
    }

    private async Task LoadProgressAsync()
    {
        mailing = await Mailings.GetAsync(mailing!.Id);
        recipients = await Mailings.RecipientsAsync(mailing!.Id);
        if (mailing.Status == MailingStatus.Sending)
        {
            refresh ??= new Timer(_ => InvokeAsync(async () =>
            {
                await LoadProgressAsync();
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else
        {
            refresh?.Dispose();
            refresh = null;
        }
    }

    private async Task PreviewAsync() =>
        preview = await Mailings.PreviewAsync(channel, commercial, ParseId(groupId), ParseId(tagId));

    private async Task ChangeChannelAsync(string? value)
    {
        channel = value == "2" ? Channel.Sms : Channel.Email;
        templates = await Mailings.TemplatesAsync(channel);
        templateId = null;
        await PreviewAsync();
    }

    private async Task ChangeAudienceAsync(string? group, string? tag)
    {
        (groupId, tagId) = (group, tag);
        await PreviewAsync();
    }

    private async Task ChangeCommercialAsync(bool value)
    {
        commercial = value;
        await PreviewAsync();
    }

    private void UseTemplate(string? value)
    {
        templateId = value;
        if (templates.FirstOrDefault(t => t.Id.ToString() == value) is { } template)
        {
            (subject, body) = (template.Subject, template.Body);
        }
    }

    private async Task<bool> SaveDraftAsync()
    {
        var result = await Mailings.SaveAsync(mailing?.Id, new SaveMailingRequest(name ?? "", channel, channel == Channel.Email ? subject : null, body ?? "", commercial, ParseId(groupId), ParseId(tagId)));
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return false;
        }

        error = null;
        if (mailing is null)
        {
            Navigation.NavigateTo($"comms/mailings/{result.Value}");
            return false;
        }

        mailing = await Mailings.GetAsync(result.Value!);
        return true;
    }

    private async Task SaveAsync() => await SaveDraftAsync();

    private async Task StartAsync()
    {
        confirmOpen = false;
        if (!await SaveDraftAsync())
        {
            return;
        }

        var result = await Mailings.StartAsync(mailing!.Id);
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        editable = false;
        await LoadProgressAsync();
    }

    private static Guid? ParseId(string? value) => Guid.TryParse(value, out var id) ? id : null;

    public void Dispose() => refresh?.Dispose();
}
