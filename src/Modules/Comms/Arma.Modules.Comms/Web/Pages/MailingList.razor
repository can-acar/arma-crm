@page "/comms/mailings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = CommsPermissions.Mailings)]
@inject MailingService Mailings

<PageTitle>Toplu ileti · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Toplu ileti</h1>
            <p class="text-muted-foreground text-sm">Bir gruba veya etikete e-posta ya da SMS. Ticari iletiler yalnızca izni onaylı kişilere gider.</p>
        </div>
        <Button Href="comms/mailings/new">Yeni ileti</Button>
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz toplu ileti yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>İleti</TableHead>
                            <TableHead>Kanal</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead Class="text-right">Gönderilen</TableHead>
                            <TableHead Class="text-right">Gönderilmeyen</TableHead>
                            <TableHead>Tarih</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var mailing in items)
                        {
                            <TableRow>
                                <TableCell><a class="font-medium hover:underline" href="comms/mailings/@mailing.Id">@mailing.Name</a></TableCell>
                                <TableCell>@CommsLabels.Channel(mailing.Channel)</TableCell>
                                <TableCell><Badge Variant="mailing.Status == MailingStatus.Draft ? BadgeVariant.Outline : BadgeVariant.Secondary">@CommsLabels.Mailing(mailing.Status)</Badge></TableCell>
                                <TableCell Class="text-right tabular-nums">@mailing.Sent</TableCell>
                                <TableCell Class="text-right tabular-nums">@(mailing.Failed + mailing.Skipped)</TableCell>
                                <TableCell Class="whitespace-nowrap">@CommsLabels.DateTime(mailing.StartedAt ?? mailing.CreatedAt)</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<MailingView> items = [];

    protected override async Task OnInitializedAsync() => items = await Mailings.ListAsync();
}
