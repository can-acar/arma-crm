@page "/forms/new"
@page "/forms/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = FormsPermissions.Read)]
@inject FormService Forms
@inject IContactAudiences Audiences
@inject Arma.Modules.Privacy.Contracts.INoticeDirectory Notices
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Yeni form" : name) · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <a class="text-muted-foreground text-sm hover:underline" href="forms">Formlar</a>
            <h1 class="text-2xl font-semibold tracking-tight">@(Id is null ? "Yeni form" : name)</h1>
        </div>
        @if (Id is not null)
        {
            <div class="flex gap-2">
                <Button Variant="ButtonVariant.Outline" Href="@($"forms/{Id}/submissions")">Yanıtlar (@submissionCount)</Button>
                <Button Variant="ButtonVariant.Outline" Href="@($"f/{slug}")" target="_blank">Formu aç</Button>
            </div>
        }
    </div>

    <FormAlert Error="@error" />
    @if (saved)
    {
        <Alert><AlertDescription>Kaydedildi.</AlertDescription></Alert>
    }

    <form id="form-editor" class="grid gap-6 lg:grid-cols-3" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="grid gap-6 lg:col-span-2">
            <Card>
                <CardHeader><CardTitle>Genel</CardTitle></CardHeader>
                <CardContent Class="grid gap-4">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="grid gap-2">
                            <Label for="f-name">Ad (yalnızca listede)</Label>
                            <Input id="f-name" @bind-Value="name" maxlength="200" />
                        </div>
                        <div class="grid gap-2">
                            <Label for="f-slug">Adres (/f/...)</Label>
                            <Input id="f-slug" @bind-Value="slug" maxlength="80" placeholder="gonullu-basvuru" />
                        </div>
                    </div>
                    <div class="grid gap-2">
                        <Label for="f-title">Başlık</Label>
                        <Input id="f-title" @bind-Value="title" maxlength="200" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="f-intro">Açıklama</Label>
                        <Textarea id="f-intro" @bind-Value="intro" rows="2" maxlength="2000" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="f-success">Gönderimden sonra gösterilecek mesaj</Label>
                        <Input id="f-success" @bind-Value="success" maxlength="500" placeholder="Teşekkür ederiz, yanıtınız alındı." />
                    </div>
                    <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="active" /> Yayında (kapalı form yanıt kabul etmez)</label>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>Alanlar</CardTitle>
                    <CardDescription>Ad, soyad ve e-posta alanlarını kişi kaydına eşlerseniz yanıt kişiye bağlanır; aynı e-postayla kişi varsa o kayıt kullanılır.</CardDescription>
                </CardHeader>
                <CardContent Class="grid gap-4">
                    @for (var i = 0; i < fields.Count; i++)
                    {
                        var index = i;
                        var field = fields[index];
                        <div class="grid gap-2 rounded-md border p-3">
                            <div class="grid gap-2 sm:grid-cols-[1fr_9rem_9rem]">
                                <Input @bind-Value="field.Label" placeholder="Etiket" aria-label="Etiket" />
                                <NativeSelect @bind-Value="field.Type" aria-label="Tür">
                                    @foreach (var type in Enum.GetValues<FieldType>())
                                    {
                                        <option value="@type">@FormLabels.Type(type)</option>
                                    }
                                </NativeSelect>
                                <NativeSelect @bind-Value="field.MapsTo" aria-label="Kişi alanı">
                                    <option value="">Kişiye aktarma</option>
                                    @foreach (var map in FieldMap.All)
                                    {
                                        <option value="@map">@FormLabels.Map(map)</option>
                                    }
                                </NativeSelect>
                            </div>
                            @if (field.Type == "Select")
                            {
                                <Input @bind-Value="field.Options" placeholder="Seçenekler, virgülle: Hafta içi, Hafta sonu" aria-label="Seçenekler" />
                            }
                            <div class="flex flex-wrap items-center gap-3 text-sm">
                                <label class="flex items-center gap-2"><Checkbox @bind-Checked="field.Required" /> Zorunlu</label>
                                <Input Class="h-8 flex-1" @bind-Value="field.Help" placeholder="Yardım metni (isteğe bağlı)" aria-label="Yardım" />
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Disabled="index == 0" OnClick="() => Move(index, -1)">Yukarı</Button>
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Disabled="index == fields.Count - 1" OnClick="() => Move(index, 1)">Aşağı</Button>
                                <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => fields.RemoveAt(index)">Kaldır</Button>
                            </div>
                        </div>
                    }
                    <div class="flex flex-wrap gap-2">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => fields.Add(new())">Alan ekle</Button>
                        @if (fields.Count == 0)
                        {
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="AddContactFields">Ad, soyad, e-posta, telefon ekle</Button>
                        }
                    </div>
                </CardContent>
            </Card>
        </div>

        <div class="grid content-start gap-6">
            <Card>
                <CardHeader>
                    <CardTitle>Gönderimden sonra</CardTitle>
                    <CardDescription>Kişiye bağlanan yanıtlarda uygulanır.</CardDescription>
                </CardHeader>
                <CardContent Class="grid gap-4">
                    <div class="grid gap-2">
                        <Label for="f-tag">Etiket ekle</Label>
                        <Input id="f-tag" @bind-Value="tagName" maxlength="60" placeholder="Gönüllü adayı" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="f-group">Gruba ekle</Label>
                        <NativeSelect id="f-group" @bind-Value="groupId">
                            <option value="">Grup seçme</option>
                            @foreach (var group in groups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </NativeSelect>
                    </div>
                    <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="askEmail" /> E-posta ile ticari ileti izni sor</label>
                    <label class="flex items-center gap-2 text-sm"><Checkbox @bind-Checked="askSms" /> SMS ile ticari ileti izni sor</label>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>KVKK</CardTitle>
                    <CardDescription>Metinler KVKK > Aydınlatma metinleri ekranından yayımlanır.</CardDescription>
                </CardHeader>
                <CardContent Class="grid gap-4">
                    <div class="grid gap-2">
                        <Label for="f-info">Aydınlatma metni bağlantısı</Label>
                        <NativeSelect id="f-info" @bind-Value="infoNotice">
                            <option value="">Yok</option>
                            @foreach (var notice in notices)
                            {
                                <option value="@notice.Slug">@notice.Title</option>
                            }
                        </NativeSelect>
                    </div>
                    <div class="grid gap-2">
                        <Label for="f-consent">Zorunlu açık rıza</Label>
                        <NativeSelect id="f-consent" @bind-Value="consentNotice">
                            <option value="">Yok</option>
                            @foreach (var notice in notices.Where(n => n.RequiresConsent))
                            {
                                <option value="@notice.Slug">@notice.Title</option>
                            }
                        </NativeSelect>
                    </div>
                </CardContent>
            </Card>

            @if (Id is not null)
            {
                <Card>
                    <CardHeader>
                        <CardTitle>Web sitesine ekle</CardTitle>
                        <CardDescription>Bu kodu sitenizin sayfasına yapıştırın.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <code class="bg-muted block rounded p-2 text-xs break-all">&lt;iframe src="@EmbedUrl" style="width:100%;min-height:640px;border:0" title="@title"&gt;&lt;/iframe&gt;</code>
                    </CardContent>
                </Card>
            }

            @if (canManage)
            {
                <div class="flex gap-2">
                    <Button Type="submit">Kaydet</Button>
                    @if (Id is not null)
                    {
                        <Button Variant="ButtonVariant.Ghost" OnClick="DeleteAsync">Sil</Button>
                    }
                </div>
            }
        </div>
    </form>
</div>

@code {
    private List<FieldDraft> fields = [];
    private IReadOnlyList<AudienceList> groups = [];
    private IReadOnlyList<Arma.Modules.Privacy.Contracts.NoticeOption> notices = [];
    private string? name, slug, title, intro, success, tagName, groupId, infoNotice, consentNotice, error;
    private bool active = true, askEmail, askSms, saved, canManage;
    private int submissionCount;

    [Parameter] public Guid? Id { get; set; }

    private string EmbedUrl => $"{Navigation.BaseUri}f/{slug}?embed=1";

    protected override async Task OnParametersSetAsync()
    {
        canManage = CurrentUser.HasPermission(FormsPermissions.Manage);
        groups = await Audiences.GroupsAsync();
        notices = await Notices.PublishedAsync();
        if (Id is { } id && await Forms.GetAsync(id) is { } form)
        {
            var s = form.Settings;
            (name, slug, title, intro, success, active, tagName) = (s.Name, s.Slug, s.Title, s.Intro, s.SuccessMessage, s.IsActive, s.TagName);
            (groupId, askEmail, askSms, infoNotice, consentNotice) = (s.GroupId?.ToString(), s.AskEmailConsent, s.AskSmsConsent, s.InfoNoticeSlug, s.ConsentNoticeSlug);
            fields = [.. form.Fields.Select(FieldDraft.From)];
            submissionCount = form.SubmissionCount;
        }
    }

    private void AddContactFields()
    {
        fields.Add(new() { Label = "Ad", MapsTo = FieldMap.FirstName, Required = true });
        fields.Add(new() { Label = "Soyad", MapsTo = FieldMap.LastName, Required = true });
        fields.Add(new() { Label = "E-posta", Type = nameof(FieldType.Email), MapsTo = FieldMap.Email, Required = true });
        fields.Add(new() { Label = "Telefon", Type = nameof(FieldType.Phone), MapsTo = FieldMap.Phone });
    }

    private void Move(int index, int delta)
    {
        (fields[index], fields[index + delta]) = (fields[index + delta], fields[index]);
    }

    private async Task SaveAsync()
    {
        saved = false;
        var settings = new FormSettings(name ?? "", slug ?? "", title ?? "", intro, success, active, tagName,
            Guid.TryParse(groupId, out var g) ? g : null, askEmail, askSms, consentNotice, infoNotice);
        var result = await Forms.SaveAsync(Id, settings, [.. fields.Select(f => f.ToField())]);
        if (!result.IsSuccess)
        {
            error = result.Error!.Message;
            return;
        }

        error = null;
        if (Id is null)
        {
            Navigation.NavigateTo($"forms/{result.Value}");
            return;
        }

        saved = true;
        await OnParametersSetAsync();
    }

    private async Task DeleteAsync()
    {
        await Forms.DeleteAsync(Id!.Value);
        Navigation.NavigateTo("forms");
    }

    private sealed class FieldDraft
    {
        public string Key { get; set; } = "";

        public string? Label { get; set; }

        public string? Type { get; set; } = nameof(FieldType.Text);

        public bool Required { get; set; }

        public string? Options { get; set; }

        public string? MapsTo { get; set; }

        public string? Help { get; set; }

        public static FieldDraft From(FormField f) => new()
        {
            Key = f.Key, Label = f.Label, Type = f.Type.ToString(), Required = f.Required,
            Options = string.Join(", ", f.Options), MapsTo = f.MapsTo, Help = f.Help,
        };

        public FormField ToField() => new(Key, Label ?? "", Enum.TryParse<FieldType>(Type, out var t) ? t : FieldType.Text, Required,
            [.. (Options ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)],
            string.IsNullOrEmpty(MapsTo) ? null : MapsTo, string.IsNullOrWhiteSpace(Help) ? null : Help.Trim());
    }
}
