@page "/forms/{Id:guid}/submissions"
@rendermode InteractiveServer
@attribute [Authorize(Policy = FormsPermissions.Read)]
@inject FormService Forms

<PageTitle>Yanıtlar · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <a class="text-muted-foreground text-sm hover:underline" href="forms/@Id">@(form?.Settings.Name ?? "Form")</a>
            <h1 class="text-2xl font-semibold tracking-tight">Yanıtlar</h1>
            <p class="text-muted-foreground text-sm">Son 500 yanıt gösterilir; tümü için CSV indirin.</p>
        </div>
        <Button Variant="ButtonVariant.Outline" Href="@($"api/v1/forms/{Id}/submissions.csv")" target="_blank">CSV indir</Button>
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz yanıt yok.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Tarih</TableHead>
                                <TableHead>Kişi</TableHead>
                                @foreach (var label in labels)
                                {
                                    <TableHead>@label</TableHead>
                                }
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var item in items)
                            {
                                <TableRow>
                                    <TableCell Class="whitespace-nowrap">@item.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</TableCell>
                                    <TableCell>
                                        @if (item.ContactId is { } contactId)
                                        {
                                            <a class="hover:underline" href="contacts/@contactId">@(item.ContactName ?? "Kişi")</a>
                                        }
                                    </TableCell>
                                    @foreach (var label in labels)
                                    {
                                        <TableCell>@item.Values.FirstOrDefault(v => v.Label == label)?.Value</TableCell>
                                    }
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </div>
            }
        </CardContent>
    </Card>
</div>

@code {
    private FormView? form;
    private IReadOnlyList<SubmissionView> items = [];
    private IReadOnlyList<string> labels = [];

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        form = await Forms.GetAsync(Id);
        items = await Forms.SubmissionsAsync(Id);
        labels = [.. items.SelectMany(i => i.Values.Select(v => v.Label)).Distinct()];
    }
}
