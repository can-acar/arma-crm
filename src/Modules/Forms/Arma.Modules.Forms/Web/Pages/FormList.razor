@page "/forms"
@rendermode InteractiveServer
@attribute [Authorize(Policy = FormsPermissions.Read)]
@inject FormService Forms
@inject ICurrentUser CurrentUser

<PageTitle>Formlar · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Formlar</h1>
            <p class="text-muted-foreground text-sm">Gönüllü başvurusu, bülten kaydı, iletişim formu gibi web formları. Yanıtlar kişi kaydına bağlanır.</p>
        </div>
        @if (CurrentUser.HasPermission(FormsPermissions.Manage))
        {
            <Button Href="forms/new">Yeni form</Button>
        }
    </div>

    <Card>
        <CardContent>
            @if (items.Count == 0)
            {
                <p class="text-muted-foreground py-6 text-center text-sm">Henüz form yok.</p>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Form</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead Class="text-right">Yanıt</TableHead>
                            <TableHead>Son yanıt</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var form in items)
                        {
                            <TableRow>
                                <TableCell>
                                    <a class="font-medium hover:underline" href="forms/@form.Id">@form.Settings.Name</a>
                                    <div class="text-muted-foreground text-xs">/f/@form.Settings.Slug</div>
                                </TableCell>
                                <TableCell><Badge Variant="form.Settings.IsActive ? BadgeVariant.Secondary : BadgeVariant.Outline">@(form.Settings.IsActive ? "Yayında" : "Kapalı")</Badge></TableCell>
                                <TableCell Class="text-right tabular-nums"><a class="hover:underline" href="forms/@form.Id/submissions">@form.SubmissionCount</a></TableCell>
                                <TableCell>@(form.LastSubmission?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</div>

@code {
    private IReadOnlyList<FormView> items = [];

    protected override async Task OnInitializedAsync() => items = await Forms.ListAsync();
}
