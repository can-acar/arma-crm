@namespace Arma.UI
@inherits ArmaComponentBase

<input data-slot="checkbox" type="checkbox" checked="@Checked" @onchange="OnChangeAsync" class="@Cn(Styles.Checkbox, Class)" @attributes="AdditionalAttributes" />

@code {
    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        Checked = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await CheckedChanged.InvokeAsync(Checked);
    }
}
