@namespace Arma.UI
@inherits ArmaComponentBase

@if (Href is not null)
{
    <a data-slot="button" href="@Href" class="@CssClass" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button data-slot="button" type="@Type" disabled="@Disabled" class="@CssClass" @onclick="OnClick" @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; }

    [Parameter] public ButtonSize Size { get; set; }

    /// <summary>Verilirse düğme bağlantı olarak çizilir.</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string CssClass => Cn(ButtonVariants.For(Variant, Size), Class);
}
