@namespace Arma.UI
@inherits ArmaComponentBase

<div data-slot="alert" role="alert" class="@Cn(Base, VariantClass, Class)" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    private const string Base =
        "relative w-full rounded-lg border px-4 py-3 text-sm grid has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] " +
        "grid-cols-[0_1fr] has-[>svg]:gap-x-3 gap-y-0.5 items-start [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current";

    [Parameter] public AlertVariant Variant { get; set; }

    private string VariantClass => Variant == AlertVariant.Destructive
        ? "text-destructive bg-card [&>svg]:text-current *:data-[slot=alert-description]:text-destructive/90"
        : "bg-card text-card-foreground";
}
