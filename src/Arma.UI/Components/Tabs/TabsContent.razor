@namespace Arma.UI
@inherits ArmaComponentBase

@if (Parent.Value == Value)
{
    <div data-slot="tabs-content" role="tabpanel" class="@Cn("flex-1 outline-none", Class)" @attributes="AdditionalAttributes">@ChildContent</div>
}

@code {
    [CascadingParameter] private Tabs Parent { get; set; } = default!;

    [Parameter, EditorRequired] public string Value { get; set; } = "";
}
