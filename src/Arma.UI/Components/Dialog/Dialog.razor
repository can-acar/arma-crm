@namespace Arma.UI
@inherits ArmaComponentBase

@if (Open)
{
    <div data-slot="dialog-overlay" class="fixed inset-0 z-50 bg-black/50" @onclick="CloseAsync"></div>
    <div data-slot="dialog-content" role="dialog" aria-modal="true" tabindex="-1" @onkeydown="OnKeyDown"
         class="@Cn("bg-background fixed top-[50%] left-[50%] z-50 grid w-full max-w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] gap-4 rounded-lg border p-6 shadow-lg sm:max-w-lg", Class)"
         @attributes="AdditionalAttributes">
        @ChildContent
        <button type="button" class="ring-offset-background focus:ring-ring absolute top-4 right-4 rounded-xs opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-hidden" @onclick="CloseAsync">
            <span aria-hidden="true">✕</span><span class="sr-only">Kapat</span>
        </button>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private async Task CloseAsync()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
