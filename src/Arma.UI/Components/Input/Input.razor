@namespace Arma.UI
@inherits ArmaComponentBase

<input data-slot="input" type="@Type" value="@Value" @oninput="OnInputAsync" aria-invalid="@(Invalid ? "true" : null)"
       class="@Cn(Base, Class)" @attributes="AdditionalAttributes" />

@code {
    private const string Base = Styles.Input;

    [Parameter] public string Type { get; set; } = "text";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Doğrulama hatasında kırmızı çerçeve gösterir.</summary>
    [Parameter] public bool Invalid { get; set; }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
