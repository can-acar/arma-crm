<AuthorizeView>
    <Authorized>
        <div class="flex items-center gap-3 text-sm">
            <a href="account/manage" class="hover:underline">@(context.User.FindFirst("arma:full_name")?.Value ?? context.User.Identity?.Name)</a>
            <form method="post" action="account/logout">
                <AntiforgeryToken />
                <Button Type="submit" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">Çıkış</Button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>
