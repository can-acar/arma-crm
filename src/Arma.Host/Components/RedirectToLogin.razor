@inject NavigationManager Navigation

@if (signedIn)
{
    <PageTitle>Yetkiniz yok · Arma CRM</PageTitle>
    <Alert Variant="AlertVariant.Destructive">
        <AlertTitle>Yetkiniz yok</AlertTitle>
        <AlertDescription>Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.</AlertDescription>
    </Alert>
}

@code {
    private bool signedIn;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Oturum açmış ama yetkisi olmayan kullanıcı giriş sayfasına gönderilmez.
        signedIn = (await AuthenticationState).User.Identity?.IsAuthenticated == true;
        if (!signedIn)
        {
            Navigation.NavigateTo($"account/login?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}", forceLoad: true);
        }
    }
}
