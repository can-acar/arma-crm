@page "/"

<PageTitle>Pano · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Pano</h1>
        <p class="text-muted-foreground text-sm">Arma CRM'e hoş geldiniz.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <Card>
            <CardHeader>
                <CardTitle>Kişiler</CardTitle>
                <CardDescription>Kişi ve kurum kayıtlarını yönetin.</CardDescription>
            </CardHeader>
            <CardFooter>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Href="contacts">Kişilere git</Button>
            </CardFooter>
        </Card>
        <Card>
            <CardHeader>
                <CardTitle>Bağışlar</CardTitle>
                <CardDescription>Faz 1'de geliyor.</CardDescription>
            </CardHeader>
            <CardFooter><Badge Variant="BadgeVariant.Secondary">Yakında</Badge></CardFooter>
        </Card>
        <Card>
            <CardHeader>
                <CardTitle>İletişim</CardTitle>
                <CardDescription>Faz 1'de geliyor.</CardDescription>
            </CardHeader>
            <CardFooter><Badge Variant="BadgeVariant.Secondary">Yakında</Badge></CardFooter>
        </Card>
    </div>
</div>
