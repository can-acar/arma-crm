@page "/admin/plugins"
@attribute [Authorize(Policy = Arma.Host.Plugins.PluginsModule.ReadPermission)]
@using Arma.Infrastructure.Plugins

<PageTitle>Eklentiler · Arma CRM</PageTitle>

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Eklentiler</h1>
        <p class="text-muted-foreground text-sm">
            Eklentiler uygulama klasöründeki <code class="font-mono text-xs">plugins</code> klasörüne, her biri kendi alt klasörüne kopyalanır ve
            uygulama yeniden başlatılınca yüklenir. Yalnızca güvendiğiniz kaynaklardan eklenti kurun: eklentiler uygulamanın tüm verisine erişebilir.
        </p>
    </div>

    @if (ArmaModules.Plugins.Count == 0)
    {
        <Card>
            <CardContent Class="text-muted-foreground py-10 text-center text-sm">Yüklü eklenti yok.</CardContent>
        </Card>
    }
    else
    {
        <Card>
            <CardContent Class="p-0">
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Eklenti</TableHead>
                            <TableHead>Sürüm</TableHead>
                            <TableHead>Modüller</TableHead>
                            <TableHead>Durum</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var plugin in ArmaModules.Plugins)
                        {
                            <TableRow>
                                <TableCell>
                                    <div class="font-medium">@(plugin.Manifest?.Name ?? plugin.Id)</div>
                                    <div class="text-muted-foreground text-xs">
                                        <span class="font-mono">@plugin.Id</span>
                                        @if (plugin.Manifest?.Author is { } author)
                                        {
                                            <span> · @author</span>
                                        }
                                    </div>
                                    @if (plugin.Manifest?.Description is { } description)
                                    {
                                        <div class="text-muted-foreground mt-1 max-w-xl whitespace-normal text-xs">@description</div>
                                    }
                                </TableCell>
                                <TableCell Class="tabular-nums">@plugin.Manifest?.Version</TableCell>
                                <TableCell>@string.Join(", ", plugin.Modules.Select(m => m.Name))</TableCell>
                                <TableCell>
                                    <Badge Variant="Variant(plugin.State)">@Label(plugin.State)</Badge>
                                    @if (plugin.Error is { } error)
                                    {
                                        <div class="text-destructive mt-1 max-w-xs whitespace-normal text-xs">@error</div>
                                    }
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </CardContent>
        </Card>
    }

    <p class="text-muted-foreground text-xs">
        Bir eklentiyi kapatmak için kimliğini <code class="font-mono">Arma__Plugins__Disabled__0</code> ayarına yazıp uygulamayı yeniden başlatın.
        Hepsini kapatmak için <code class="font-mono">Arma__Plugins__Enabled=false</code>. Eklenti geliştirme rehberi: depodaki docs/eklentiler.md.
    </p>
</div>

@code {
    private static string Label(PluginState state) => state switch
    {
        PluginState.Loaded => "Etkin",
        PluginState.Disabled => "Kapalı",
        _ => "Yüklenemedi",
    };

    private static BadgeVariant Variant(PluginState state) => state switch
    {
        PluginState.Loaded => BadgeVariant.Secondary,
        PluginState.Disabled => BadgeVariant.Outline,
        _ => BadgeVariant.Destructive,
    };
}
