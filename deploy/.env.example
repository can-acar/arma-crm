# install.sh bu dosyadan .env üretir. Elle kuruyorsanız kopyalayıp doldurun.
POSTGRES_PASSWORD=
# Bu kurulumun kurum kimliği (UUID). Bir kez üretilir, sonra değiştirilmez.
ARMA_TENANT_ID=
ARMA_PORT=8080
ARMA_VERSION=latest
# HTTPS'i önündeki ters vekil sonlandırıyorsa true.
ARMA_BEHIND_PROXY=false
# HTTPS olmadan API belirteci almaya izin ver (yalnızca kapalı iç ağ).
ARMA_ALLOW_HTTP=false
# Tarih ve saatlerin gösterildiği saat dilimi.
ARMA_TIMEZONE=Europe/Istanbul
# Çevrim içi bağış: none, iyzico veya paytr.
ARMA_PAYMENT_PROVIDER=none
# iyzico üye işyeri anahtarları (deneme için IYZICO_BASE_URL=https://sandbox-api.iyzipay.com).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
# PayTR mağaza bilgileri. Bildirim URL'si olarak PayTR paneline https://<alan-adınız>/api/v1/payments/paytr/callback girin.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=false

# Uygulamanın dışarıdan erişilen adresi; e-postadaki abonelik iptal bağlantısında kullanılır (zorunlu).
ARMA_PUBLIC_URL=
# E-posta: none veya smtp. SMTP_SECURITY: auto, starttls, ssl, none.
ARMA_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=auto
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
# SMS: none veya netgsm. NETGSM_HEADER, BTK onaylı gönderici adıdır.
ARMA_SMS_PROVIDER=none
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# İleti Yönetim Sistemi: açıkken izin değişiklikleri İYS'ye bildirilir.
IYS_ENABLED=false
IYS_BASE_URL=https://api.iys.org.tr
IYS_USERNAME=
IYS_PASSWORD=
IYS_CODE=
IYS_BRAND_CODE=
