# install.sh bu dosyadan .env üretir. Elle kuruyorsanız kopyalayıp doldurun.
POSTGRES_PASSWORD=
# Bu kurulumun kurum kimliği (UUID). Bir kez üretilir, sonra değiştirilmez.
ARMA_TENANT_ID=
ARMA_PORT=8080
ARMA_VERSION=latest
# HTTPS'i önündeki ters vekil sonlandırıyorsa true.
ARMA_BEHIND_PROXY=false
# HTTPS olmadan API belirteci almaya izin ver (yalnızca kapalı iç ağ).
ARMA_ALLOW_HTTP=false
# Tarih ve saatlerin gösterildiği saat dilimi.
ARMA_TIMEZONE=Europe/Istanbul
# Çevrim içi bağış: none, iyzico veya paytr.
ARMA_PAYMENT_PROVIDER=none
# iyzico üye işyeri anahtarları (deneme için IYZICO_BASE_URL=https://sandbox-api.iyzipay.com).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
# PayTR mağaza bilgileri. Bildirim URL'si olarak PayTR paneline https://<alan-adınız>/api/v1/payments/paytr/callback girin.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=false
