# Arma CRM (Windows/IIS) ayarları. install-iis.ps1 ilk kurulumda bu dosyadan C:\ProgramData\Arma\arma.env üretir;
# değerler uygulama havuzunun ortam değişkenlerine yazılır, site klasöründe saklanmaz.
# Değiştirdikten sonra install-iis.ps1'i yeniden çalıştırın (ya da uygulama havuzunu geri dönüştürün).

# PostgreSQL bağlantısı. install-iis.ps1 -CreateDatabase ile çalıştırılırsa kendisi doldurur.
ConnectionStrings__arma=Host=localhost;Port=5432;Database=arma;Username=arma;Password=
# Bu kurulumun kurum kimliği (UUID). Bir kez üretilir, sonra değiştirilmez.
Arma__TenantId=
# HTTPS'i önündeki ters vekil (ARR, yük dengeleyici) sonlandırıyorsa true. IIS'in kendi HTTPS bağlaması için gerekmez.
Arma__Security__TrustForwardedHeaders=false
# HTTPS olmadan API belirteci almaya izin ver (yalnızca kapalı iç ağ).
Arma__Security__AllowHttp=false

# Çevrim içi bağış: none, iyzico veya paytr.
Giving__Payments__Provider=none
Giving__Payments__Iyzico__ApiKey=
Giving__Payments__Iyzico__SecretKey=
Giving__Payments__Iyzico__BaseUrl=https://api.iyzipay.com
Giving__Payments__PayTR__MerchantId=
Giving__Payments__PayTR__MerchantKey=
Giving__Payments__PayTR__MerchantSalt=
Giving__Payments__PayTR__TestMode=false

# E-postalardaki bağlantılar ve ödeme dönüşleri için sitenin dışarıdan erişilen adresi (https://crm.kurum.org).
Comms__PublicUrl=
# E-posta: none veya smtp.
Comms__Email__Provider=none
Comms__Email__Host=
Comms__Email__Port=587
Comms__Email__Security=auto
Comms__Email__UserName=
Comms__Email__Password=
Comms__Email__FromAddress=
Comms__Email__FromName=
# SMS: none veya netgsm.
Comms__Sms__Provider=none
Comms__Sms__UserCode=
Comms__Sms__Password=
Comms__Sms__Header=
# İleti Yönetim Sistemi.
Comms__Iys__Enabled=false
Comms__Iys__BaseUrl=https://api.iys.org.tr
Comms__Iys__UserName=
Comms__Iys__Password=
Comms__Iys__IysCode=
Comms__Iys__BrandCode=
