<?xml version="1.0" encoding="utf-8"?>
<!-- Arma CRM, IIS üzerinde ASP.NET Core Modülü (Hosting Bundle) ile süreç içinde çalışır. -->
<!-- Veritabanı parolası ve anahtarlar burada değil, uygulama havuzunun ortam değişkenlerinde tutulur (install-iis.ps1). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Arma.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Blazor ekranları WebSocket ile çalışır; IIS'te "WebSocket Protokolü" özelliği açık olmalı. -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Banka ekstresi ve CiviCRM dosyaları için 50 MB. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
