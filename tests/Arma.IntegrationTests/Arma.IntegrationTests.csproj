<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\src\Arma.Host\Arma.Host.csproj" />
    <!-- Örnek eklenti derlenir ama başvurulmaz; testler onu gerçek bir kurulumdaki gibi plugins klasöründen yükler. -->
    <ProjectReference Include="..\..\samples\Arma.Plugins.Sample\Arma.Plugins.Sample.csproj" ReferenceOutputAssembly="false" OutputItemType="SamplePlugin" />
  </ItemGroup>

  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <Copy SourceFiles="@(SamplePlugin);..\..\samples\Arma.Plugins.Sample\plugin.json" DestinationFolder="$(OutDir)plugins\arma.ornek" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
